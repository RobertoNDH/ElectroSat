---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import ArcoSenal from '../components/ArcoSenal.astro';
import DiagramaPortal from '../components/DiagramaPortal.astro';
import MuroMarcas from '../components/MuroMarcas.astro';
import Faq from '../components/Faq.astro';
import BloqueContacto from '../components/BloqueContacto.astro';
import { faq } from '../data/faq';
import { empresa, aniosActividad, telHref, waHref } from '../data/empresa';

const servicios = (await getCollection('servicios')).sort(
  (a, b) => a.data.orden - b.data.orden
);

const confianza = [
  { dato: `Nº ${empresa.registroInstalador}`, texto: 'Empresa instaladora registrada' },
  { dato: `${aniosActividad} años`, texto: 'Trabajando en Tenerife' },
  { dato: 'Gratis', texto: 'Visita y presupuesto sin compromiso' },
  { dato: 'Por escrito', texto: 'Garantía en material y mano de obra' },
];

const publicos = [
  {
    titulo: 'Comunidades y administradores',
    texto:
      'Antena colectiva, videoportero, cámaras e internet para todo el edificio. Informe técnico y presupuesto en el formato que se lleva a junta.',
    puntos: ['Informe para la junta', 'Desglose por vivienda', 'Certificado al terminar'],
    href: '/servicios/internet-comunitario/',
  },
  {
    titulo: 'Hoteles y negocios',
    texto:
      'Canales internacionales, videovigilancia, redes y WiFi con cobertura medida. Mantenimiento con tiempos de respuesta acordados.',
    puntos: ['TV internacional', 'Red y WiFi profesional', 'Mantenimiento'],
    href: '/servicios/telecomunicaciones/',
  },
  {
    titulo: 'Viviendas particulares',
    texto:
      'Parabólica, TDT, cámaras, telefonillo y averías. Vamos, lo medimos y te decimos qué pasa antes de tocar nada.',
    puntos: ['Averías de señal', 'Antena y parabólica', 'Cámaras y portero'],
    href: '/servicios/tdt-y-satelite/',
  },
];

const pasos = [
  {
    titulo: 'Llamas',
    texto:
      'Te atiende alguien que conoce el trabajo. En esa llamada ya se ve si es una avería puntual o hay que ir a verlo.',
  },
  {
    titulo: 'Visita técnica',
    texto:
      'Vamos, medimos y comprobamos qué hay montado. Gratis y sin compromiso en toda la isla.',
  },
  {
    titulo: 'Presupuesto cerrado',
    texto:
      'Precio detallado por partidas, con el material que lleva. Lo que se firma es lo que se paga.',
  },
  {
    titulo: 'Instalación y certificado',
    texto:
      'Se ejecuta en la fecha acordada y se entregan las mediciones y el certificado de la instalación.',
  },
];

const pruebas = [
  {
    icono: 'documento' as const,
    titulo: 'Empresa instaladora registrada',
    texto: `Inscritos en el Registro de Empresas Instaladoras de Telecomunicación con el número ${empresa.registroInstalador}. Es lo que permite firmar el certificado de una instalación.`,
  },
  {
    icono: 'escudo' as const,
    titulo: 'Seguro de responsabilidad civil',
    texto:
      'Póliza en vigor que cubre los trabajos. Se aporta el justificante cuando el administrador o el hotel lo pide.',
  },
  {
    icono: 'check' as const,
    titulo: 'Certificado y mediciones',
    texto:
      'Al terminar se entregan los niveles de señal medidos. No es una opinión: son datos que se pueden comprobar.',
  },
  {
    icono: 'euro' as const,
    titulo: 'Presupuesto cerrado',
    texto:
      'Sin partidas abiertas ni sorpresas al facturar. Si aparece algo no previsto se para y se consulta antes de seguir.',
  },
  {
    icono: 'herramienta' as const,
    titulo: 'Material de marca con repuesto',
    texto:
      'Trabajamos con fabricantes que mantienen el repuesto años. Un equipo barato sin recambio sale caro al segundo año.',
  },
];

// TODO CLIENTE: sustituir por opiniones reales, con permiso de quien las firma.
// No se inventan resenas: los textos entre corchetes son marcadores visibles a
// proposito, para que no se publiquen por descuido.
const opiniones = [
  {
    texto: '[Opinión del cliente. Dos o tres líneas contando qué se le resolvió.]',
    quien: '[Nombre]',
    rol: 'Presidente de comunidad',
    donde: '[Municipio]',
  },
  {
    texto: '[Opinión del cliente. Dos o tres líneas contando qué se le resolvió.]',
    quien: '[Nombre]',
    rol: 'Administrador de fincas',
    donde: '[Municipio]',
  },
  {
    texto: '[Opinión del cliente. Dos o tres líneas contando qué se le resolvió.]',
    quien: '[Nombre]',
    rol: 'Hotel',
    donde: '[Municipio]',
  },
];

const jsonLd = [
  {
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.p,
      acceptedAnswer: { '@type': 'Answer', text: f.r },
    })),
  },
];
---

<Base
  titulo="Antenista e instalador de telecomunicaciones en Tenerife | ElectroSat TV"
  descripcion="Instalación y mantenimiento de antenas TDT y satélite, videovigilancia, porteros, videoporteros e internet comunitario en comunidades, hoteles y viviendas de Tenerife."
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="container hero__rejilla">
      <div class="hero__texto">
        <p class="eyebrow">Instalador registrado · Tenerife</p>
        <h1 class="display-xl">Antenas, cámaras y porteros que funcionan el primer día</h1>
        <p class="lede">
          {empresa.razonSocial} instala y mantiene TDT y satélite, videovigilancia, porteros
          e internet comunitario en comunidades, hoteles y viviendas de toda la isla.
        </p>
        <div class="hero__acciones">
          <a class="btn btn--primary btn--lg" href={telHref()}>
            <Icono nombre="telefono" tamano={18} />
            Llamar al {empresa.telefono.display}
          </a>
          <a class="btn btn--ghost btn--lg" href={waHref()} rel="noopener noreferrer">
            <Icono nombre="whatsapp" tamano={18} />
            Escribir por WhatsApp
          </a>
        </div>
      </div>

      <div class="hero__arte" aria-hidden="true">
        <ArcoSenal variante="hero" />
      </div>
    </div>
  </section>

  <section class="confianza" aria-label="Datos de la empresa">
    <ul class="container confianza__lista">
      {
        confianza.map((c) => (
          <li>
            <span class="confianza__dato mono">{c.dato}</span>
            <span class="confianza__texto">{c.texto}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section" aria-labelledby="publicos-titulo">
    <div class="container">
      <div class="cabecera cabecera--split">
        <p class="eyebrow"><ArcoSenal />Por dónde empezar</p>
        <h2 class="h2" id="publicos-titulo">Dinos qué eres y vamos al grano</h2>
        <p class="prosa">
          No es lo mismo una avería en una vivienda que una instalación para treinta.
          Elige el caso que se parece al tuyo y verás qué incluye y cómo se plantea.
        </p>
      </div>

      <ul class="publicos">
        {
          publicos.map((p) => (
            <li class="publico">
              <h3 class="h3">{p.titulo}</h3>
              <p class="publico__texto">{p.texto}</p>
              <ul class="publico__puntos">
                {p.puntos.map((punto) => (
                  <li>
                    <Icono nombre="check" tamano={15} />
                    {punto}
                  </li>
                ))}
              </ul>
              <a class="enlace-flecha publico__enlace" href={p.href}>
                Ver cómo lo hacemos
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--surface" id="servicios" aria-labelledby="servicios-titulo">
    <div class="container">
      <div class="cabecera cabecera--split">
        <p class="eyebrow"><ArcoSenal />Servicios</p>
        <h2 class="h2" id="servicios-titulo">Todo lo que entra por el mismo cable</h2>
        <p class="prosa">
          Televisión, seguridad, portería e internet comparten infraestructura en un
          edificio. Trabajarlo todo con la misma empresa evita que cada instalación
          estropee la anterior.
        </p>
      </div>

      <ul class="servicios">
        {
          servicios.map((s) => (
            <li class="servicio">
              <a class="servicio__enlace" href={`/servicios/${s.id}/`}>
                <Icono nombre={s.data.icono} tamano={30} class="servicio__icono" />
                <h3 class="h3">{s.data.titulo}</h3>
                <p class="servicio__resumen">{s.data.resumen}</p>
                <ul class="servicio__puntos">
                  {s.data.puntos.map((punto) => (
                    <li>{punto}</li>
                  ))}
                </ul>
                <span class="enlace-flecha">Ver servicio</span>
              </a>
            </li>
          ))
        }
        <li class="servicio servicio--cta">
          <div class="servicio__cta">
            <ArcoSenal />
            <h3 class="h3">¿No sabes cuál te toca?</h3>
            <p class="servicio__resumen">
              Cuéntanos qué te pasa y te decimos si es una avería, una ampliación o una
              instalación nueva. Sin compromiso.
            </p>
            <a class="btn btn--primary" href={telHref()}>
              <Icono nombre="telefono" tamano={17} />
              Llamar al {empresa.telefono.display}
            </a>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="section firma" aria-labelledby="firma-titulo">
    <div class="container firma__rejilla">
      <DiagramaPortal />

      <div class="firma__texto">
        <p class="eyebrow"><ArcoSenal />Internet comunitario</p>
        <h2 class="h2" id="firma-titulo">
          Internet en todo el portal por el cable que ya tienes
        </h2>
        <div class="prosa">
          <p>
            La objeción que siempre sale en junta es la obra: canaletas por la escalera,
            agujeros y semanas de molestias. Con los sistemas <strong>Coaxdata</strong> y
            <strong>DSLAM</strong> esa objeción desaparece, porque el edificio ya tiene por
            dónde ir.
          </p>
          <p>
            Se aprovecha el coaxial de la antena o el par telefónico que ya está pasado.
            Solo se sustituye la cabecera y el equipo de cada vivienda. Cada vecino queda
            con su red separada del resto, y las altas y bajas se hacen sin subir a
            cubierta.
          </p>
        </div>
        <a class="btn btn--primary" href="/servicios/internet-comunitario/">
          Cómo se monta en tu edificio
          <Icono nombre="flecha" tamano={17} />
        </a>
      </div>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="proceso-titulo">
    <div class="container">
      <div class="cabecera cabecera--split">
        <p class="eyebrow"><ArcoSenal />Cómo trabajamos</p>
        <h2 class="h2" id="proceso-titulo">De la llamada al certificado</h2>
        <p class="prosa">
          Cuatro pasos, en este orden, siempre. Sabes en qué punto estás y qué viene
          después.
        </p>
      </div>

      <ol class="pasos">
        {
          pasos.map((p, i) => (
            <li class="paso">
              <span class="paso__numero mono">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="h3">{p.titulo}</h3>
              <p class="paso__texto">{p.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="pruebas-titulo">
    <div class="container">
      <div class="cabecera cabecera--split">
        <p class="eyebrow"><ArcoSenal />Por qué fiarte</p>
        <h2 class="h2" id="pruebas-titulo">Cinco cosas que se pueden comprobar</h2>
        <p class="prosa">
          Cualquiera puede decir que es serio. Esto es lo que lo demuestra, y todo se
          puede pedir por escrito antes de contratar.
        </p>
      </div>

      <ul class="pruebas">
        {
          pruebas.map((p) => (
            <li class="prueba">
              <Icono nombre={p.icono} tamano={26} class="prueba__icono" />
              <div>
                <h3 class="h3">{p.titulo}</h3>
                <p class="prueba__texto">{p.texto}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--surface" id="marcas" aria-labelledby="marcas-titulo">
    <div class="container">
      <div class="cabecera cabecera--split">
        <p class="eyebrow"><ArcoSenal />Material</p>
        <h2 class="h2" id="marcas-titulo">Trabajamos con las mejores marcas</h2>
        <p class="prosa">
          Fabricantes con repuesto disponible durante años y soporte técnico real. Es lo
          que hace que una instalación se pueda reparar dentro de diez años en vez de
          tener que rehacerla entera.
        </p>
      </div>
      <MuroMarcas />
    </div>
  </section>

  <section class="section" id="cobertura" aria-labelledby="cobertura-titulo">
    <div class="container">
      <div class="cabecera cabecera--split">
        <p class="eyebrow"><ArcoSenal />Zona de trabajo</p>
        <h2 class="h2" id="cobertura-titulo">Toda la isla de Tenerife</h2>
        <p class="prosa">
          Norte, sur y área metropolitana. Si tu municipio está en la lista, el
          desplazamiento para valorar el trabajo no se cobra.
        </p>
      </div>
      <ul class="cobertura">
        {empresa.cobertura.map((m) => <li>{m}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="opiniones-titulo">
    <div class="container">
      <div class="cabecera cabecera--ancha">
        <p class="eyebrow"><ArcoSenal />Clientes</p>
        <h2 class="h2" id="opiniones-titulo">Lo que dicen quienes ya nos han llamado</h2>
      </div>
      <ul class="opiniones">
        {
          opiniones.map((o) => (
            <li class="opinion">
              <blockquote>{o.texto}</blockquote>
              <footer class="opinion__firma">
                <span class="opinion__quien">{o.quien}</span>
                <span class="small">
                  {o.rol} · {o.donde}
                </span>
              </footer>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-titulo">
    <div class="container faq__rejilla">
      <div class="cabecera cabecera--ancha">
        <p class="eyebrow"><ArcoSenal />Dudas frecuentes</p>
        <h2 class="h2" id="faq-titulo">Lo que más nos preguntan</h2>
      </div>
      <Faq items={faq} />
    </div>
  </section>

  <BloqueContacto />
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    padding-block: clamp(2.75rem, 5.5vw, 5rem);
    overflow: hidden;
  }

  .hero__rejilla {
    display: grid;
    gap: var(--s-7);
    align-items: center;
  }

  .hero__texto {
    display: grid;
    gap: var(--s-5);
  }

  .hero__texto .lede {
    max-width: 52ch;
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }

  .hero__arte {
    display: none;
  }

  @media (min-width: 62rem) {
    .hero__rejilla {
      grid-template-columns: minmax(0, 1.32fr) minmax(0, 0.68fr);
    }

    .hero__arte {
      display: block;
      position: relative;
      aspect-ratio: 1;
      margin-right: calc(var(--gutter) * -1);
    }
  }

  /* ---------- Barra de confianza ---------- */
  .confianza {
    border-block: var(--hairline);
  }

  .confianza__lista {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .confianza__lista li {
    display: grid;
    gap: 0.25rem;
    align-content: start;
    padding: var(--s-4) var(--s-4) var(--s-4) 0;
  }

  .confianza__lista li + li {
    padding-left: var(--s-4);
    border-left: var(--hairline);
  }

  @media (min-width: 48rem) {
    .confianza__lista {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .confianza__dato {
    font-size: 1.0625rem;
    color: var(--ink);
  }

  .confianza__texto {
    font-size: var(--fs-small);
    line-height: 1.4;
    color: var(--ink-3);
  }

  /* ---------- Publicos ---------- */
  .publicos {
    display: grid;
    gap: var(--s-5);
  }

  @media (min-width: 55rem) {
    .publicos {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .publico {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    padding: var(--s-5);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    transition: border-color var(--t-fast), transform var(--t-fast);
  }

  .publico:hover {
    border-color: var(--line-strong);
    transform: translateY(-2px);
  }

  .publico__texto {
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--ink-2);
  }

  .publico__puntos {
    display: grid;
    gap: 0.5rem;
    padding-top: var(--s-3);
    border-top: var(--hairline);
  }

  .publico__puntos li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    color: var(--ink-3);
  }

  .publico__enlace {
    margin-top: var(--s-2);
  }

  /* ---------- Servicios ---------- */
  .servicios {
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    overflow: hidden;
  }

  @media (min-width: 44rem) {
    .servicios {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 66rem) {
    .servicios {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .servicio {
    background: var(--paper);
  }

  .servicio__enlace {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    height: 100%;
    padding: var(--s-5);
    text-decoration: none;
    transition: background var(--t-fast);
  }

  .servicio__enlace:hover {
    background: var(--surface-2);
  }

  .servicio__icono {
    color: var(--ink);
    margin-bottom: var(--s-2);
  }

  .servicio__resumen {
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--ink-2);
  }

  .servicio__puntos {
    display: grid;
    gap: 0.4375rem;
    margin-top: var(--s-1);
  }

  .servicio__puntos li {
    position: relative;
    padding-left: 0.9375rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--ink-3);
  }

  .servicio__puntos li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5625rem;
    width: 0.4375rem;
    height: 1px;
    background: var(--line-strong);
  }

  .servicio__enlace .enlace-flecha {
    align-self: end;
    margin-top: var(--s-3);
  }

  .servicio--cta {
    background: var(--surface-2);
  }

  .servicio__cta {
    display: grid;
    gap: var(--s-3);
    align-content: center;
    justify-items: start;
    height: 100%;
    padding: var(--s-5);
  }

  .servicio__cta .btn {
    margin-top: var(--s-2);
  }

  /* ---------- Firma ---------- */
  .firma__rejilla {
    display: grid;
    gap: var(--s-7);
  }

  @media (min-width: 62rem) {
    .firma__rejilla {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--s-8);
      align-items: center;
    }
  }

  .firma__texto {
    display: grid;
    gap: var(--s-4);
    align-content: center;
  }

  .firma__texto .btn {
    justify-self: start;
    margin-top: var(--s-2);
  }

  /* ---------- Pasos ---------- */
  .pasos {
    display: grid;
    gap: var(--s-5);
  }

  @media (min-width: 44rem) {
    .pasos {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 66rem) {
    .pasos {
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
    }
  }

  .paso {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    padding-top: var(--s-5);
    border-top: 2px solid var(--ink);
  }

  @media (min-width: 66rem) {
    .paso {
      padding-right: var(--s-5);
    }
  }

  .paso__numero {
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    color: var(--ink-3);
  }

  .paso__texto {
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--ink-2);
  }

  /* ---------- Pruebas ---------- */
  .pruebas {
    display: grid;
    border-top: var(--hairline);
  }

  @media (min-width: 55rem) {
    .pruebas {
      grid-template-columns: repeat(2, 1fr);
      column-gap: var(--s-7);
    }
  }

  .prueba {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-4);
    padding-block: var(--s-5);
    border-bottom: var(--hairline);
  }

  .prueba__icono {
    color: var(--ink);
    margin-top: 0.125rem;
  }

  .prueba__texto {
    margin-top: 0.5rem;
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 52ch;
  }

  /* ---------- Cobertura ---------- */
  .cobertura {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
