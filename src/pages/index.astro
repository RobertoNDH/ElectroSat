---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import DiagramaPortal from '../components/DiagramaPortal.astro';
import MuroMarcas from '../components/MuroMarcas.astro';
import Faq from '../components/Faq.astro';
import BloqueContacto from '../components/BloqueContacto.astro';
import { fotoServicio } from '../data/imagenes';
import { faq } from '../data/faq';
import { empresa, aniosActividad, telHref, waHref } from '../data/empresa';

import fotoHero from '../assets/hero-instalacion.jpg';
import fotoEquipo from '../assets/equipo.jpg';
import fotoTenerife from '../assets/cobertura-tenerife.jpg';

const servicios = (await getCollection('servicios')).sort(
  (a, b) => a.data.orden - b.data.orden
);

const confianza = [
  {
    icono: 'documento' as const,
    dato: `Nº ${empresa.registroInstalador}`,
    texto: 'Empresa instaladora registrada',
  },
  {
    icono: 'herramienta' as const,
    dato: `${aniosActividad} años`,
    texto: 'Trabajando en Tenerife',
  },
  {
    icono: 'euro' as const,
    dato: 'Gratis',
    texto: 'Visita y presupuesto sin compromiso',
  },
  {
    icono: 'escudo' as const,
    dato: 'Por escrito',
    texto: 'Garantía en material y mano de obra',
  },
];

const ventajasHero = [
  'Visita técnica gratuita en toda la isla',
  'Presupuesto cerrado, sin sorpresas',
  'Certificado y mediciones al terminar',
];

const publicos = [
  {
    icono: 'internet' as const,
    titulo: 'Comunidades y administradores',
    texto:
      'Antena colectiva, videoportero, cámaras e internet para todo el edificio, con informe técnico y presupuesto en el formato que se lleva a junta.',
    href: '/servicios/internet-comunitario/',
  },
  {
    icono: 'red' as const,
    titulo: 'Hoteles y negocios',
    texto:
      'Canales internacionales, videovigilancia, redes y WiFi con cobertura medida, y mantenimiento con tiempos de respuesta acordados.',
    href: '/servicios/telecomunicaciones/',
  },
  {
    icono: 'satelite' as const,
    titulo: 'Viviendas particulares',
    texto:
      'Parabólica, TDT, cámaras, telefonillo y averías. Vamos, lo medimos y te decimos qué pasa antes de tocar nada.',
    href: '/servicios/tdt-y-satelite/',
  },
];

const pasos = [
  {
    titulo: 'Llamas',
    texto:
      'Te atiende alguien que conoce el trabajo. En esa llamada ya se ve si es una avería puntual o hay que ir a verlo.',
  },
  {
    titulo: 'Visita técnica',
    texto:
      'Vamos, medimos y comprobamos qué hay montado. Gratis y sin compromiso en toda la isla.',
  },
  {
    titulo: 'Presupuesto cerrado',
    texto:
      'Precio detallado por partidas, con el material que lleva. Lo que se firma es lo que se paga.',
  },
  {
    titulo: 'Instalación y certificado',
    texto:
      'Se ejecuta en la fecha acordada y se entregan las mediciones y el certificado de la instalación.',
  },
];

const pruebas = [
  {
    icono: 'documento' as const,
    titulo: 'Empresa instaladora registrada',
    texto: `Inscritos en el Registro de Empresas Instaladoras de Telecomunicación con el número ${empresa.registroInstalador}, que es lo que permite firmar el certificado de una instalación.`,
  },
  {
    icono: 'escudo' as const,
    titulo: 'Seguro de responsabilidad civil',
    texto:
      'Póliza en vigor que cubre los trabajos. Se aporta el justificante cuando el administrador o el hotel lo pide.',
  },
  {
    icono: 'check' as const,
    titulo: 'Certificado y mediciones',
    texto:
      'Al terminar se entregan los niveles de señal medidos. No es una opinión: son datos que se pueden comprobar.',
  },
  {
    icono: 'euro' as const,
    titulo: 'Presupuesto cerrado',
    texto:
      'Sin partidas abiertas ni sorpresas al facturar. Si aparece algo no previsto, se para y se consulta antes de seguir.',
  },
  {
    icono: 'herramienta' as const,
    titulo: 'Material de marca con repuesto',
    texto:
      'Trabajamos con fabricantes que mantienen el repuesto durante años. Un equipo barato sin recambio sale caro al segundo año.',
  },
];

// TODO: sustituir por opiniones reales, con permiso de quien las firma.
// Los corchetes son marcadores visibles a propósito para que no se publiquen
// por descuido.
const opiniones = [
  {
    texto: '[Opinión del cliente. Dos o tres líneas contando qué se le resolvió.]',
    quien: '[Nombre]',
    rol: 'Presidente de comunidad',
    donde: '[Municipio]',
  },
  {
    texto: '[Opinión del cliente. Dos o tres líneas contando qué se le resolvió.]',
    quien: '[Nombre]',
    rol: 'Administrador de fincas',
    donde: '[Municipio]',
  },
  {
    texto: '[Opinión del cliente. Dos o tres líneas contando qué se le resolvió.]',
    quien: '[Nombre]',
    rol: 'Hotel',
    donde: '[Municipio]',
  },
];

const jsonLd = [
  {
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.p,
      acceptedAnswer: { '@type': 'Answer', text: f.r },
    })),
  },
];
---

<Base
  titulo="Antenista e instalador de telecomunicaciones en Tenerife | ElectroSat TV"
  descripcion="Instalación y mantenimiento de antenas TDT y satélite, videovigilancia, porteros, videoporteros e internet comunitario en comunidades, hoteles y viviendas de Tenerife."
  jsonLd={jsonLd}
>
  <!-- Portada -->
  <section class="hero">
    <div class="hero__panel">
      <div class="hero__texto">
        <p class="eyebrow">Instalador registrado · Tenerife</p>
        <h1 class="display-xl">
          Telecomunicaciones que funcionan el primer día
        </h1>
        <p class="lede">
          Antenas de TDT y satélite, videovigilancia, porteros e internet comunitario para
          comunidades, hoteles y viviendas de toda la isla.
        </p>

        <ul class="hero__ventajas">
          {
            ventajasHero.map((v) => (
              <li>
                <Icono nombre="check" tamano={17} />
                {v}
              </li>
            ))
          }
        </ul>

        <div class="hero__acciones">
          <a class="btn btn--principal btn--lg" href={telHref()}>
            <Icono nombre="telefono" tamano={18} />
            Llamar al {empresa.telefono.display}
          </a>
          <a class="btn btn--linea btn--lg" href={waHref()} rel="noopener noreferrer">
            <Icono nombre="whatsapp" tamano={18} />
            Escribir por WhatsApp
          </a>
        </div>
      </div>
    </div>

    <div class="hero__foto">
      <Image
        src={fotoHero}
        alt="Técnico de ElectroSat TV fijando el cableado de una instalación en cubierta"
        widths={[600, 900, 1400]}
        sizes="(min-width: 62rem) 50vw, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </section>

  <!-- Datos de confianza -->
  <section class="confianza" aria-label="Datos de la empresa">
    <ul class="container confianza__lista">
      {
        confianza.map((c) => (
          <li class="confianza__item">
            <span class="pastilla pastilla--naranja">
              <Icono nombre={c.icono} tamano={22} />
            </span>
            <span>
              <strong class="confianza__dato">{c.dato}</strong>
              <span class="confianza__texto">{c.texto}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Segmentación -->
  <section class="section" aria-labelledby="publicos-titulo">
    <div class="container">
      <div class="cabecera cabecera--split">
        <p class="eyebrow">Por dónde empezar</p>
        <h2 class="h2" id="publicos-titulo">Dinos qué eres y vamos al grano</h2>
        <p class="prosa">
          No es lo mismo una avería en una vivienda que una instalación para treinta.
          Elige el caso que se parece al tuyo y verás cómo se plantea.
        </p>
      </div>

      <ul class="publicos">
        {
          publicos.map((p) => (
            <li class="publico">
              <span class="pastilla">
                <Icono nombre={p.icono} tamano={24} />
              </span>
              <h3 class="h3">{p.titulo}</h3>
              <p class="publico__texto">{p.texto}</p>
              <a class="enlace-flecha" href={p.href}>
                Ver cómo lo hacemos
                <Icono nombre="flecha" tamano={16} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Servicios -->
  <section class="section section--surface" id="servicios" aria-labelledby="servicios-titulo">
    <div class="container">
      <div class="cabecera cabecera--split">
        <p class="eyebrow">Servicios</p>
        <h2 class="h2" id="servicios-titulo">Todo lo que entra por el mismo cable</h2>
        <p class="prosa">
          Televisión, seguridad, portería e internet comparten infraestructura en un
          edificio. Trabajarlo todo con la misma empresa evita que cada instalación nueva
          estropee la anterior.
        </p>
      </div>

      <ul class="servicios">
        {
          servicios.map((s) => (
            <li class="servicio">
              <a class="servicio__enlace" href={`/servicios/${s.id}/`}>
                <span class="servicio__foto">
                  <Image
                    src={fotoServicio[s.id]}
                    alt={`Trabajo de ${s.data.corto.toLowerCase()} de ElectroSat TV`}
                    widths={[400, 600, 800]}
                    sizes="(min-width: 66rem) 22rem, (min-width: 44rem) 45vw, 100vw"
                    loading="lazy"
                  />
                  <span class="servicio__icono">
                    <Icono nombre={s.data.icono} tamano={22} />
                  </span>
                </span>
                <span class="servicio__cuerpo">
                  <span class="h3">{s.data.titulo}</span>
                  <span class="servicio__resumen">{s.data.resumen}</span>
                  <span class="servicio__puntos">
                    {s.data.puntos.map((punto) => (
                      <span>
                        <Icono nombre="check" tamano={15} />
                        {punto}
                      </span>
                    ))}
                  </span>
                  <span class="enlace-flecha servicio__mas">
                    Ver servicio
                    <Icono nombre="flecha" tamano={16} />
                  </span>
                </span>
              </a>
            </li>
          ))
        }

        <li class="servicio servicio--cta">
          <div class="servicio__cta">
            <span class="pastilla pastilla--naranja">
              <Icono nombre="telefono" tamano={24} />
            </span>
            <h3 class="h3">¿No sabes cuál te toca?</h3>
            <p class="servicio__resumen">
              Cuéntanos qué te pasa y te decimos si es una avería, una ampliación o una
              instalación nueva. Sin compromiso.
            </p>
            <a class="btn btn--principal" href={telHref()}>
              <Icono nombre="telefono" tamano={17} />
              Llamar al {empresa.telefono.display}
            </a>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- Internet comunitario -->
  <section class="section firma" aria-labelledby="firma-titulo">
    <div class="container firma__rejilla">
      <div class="firma__grafico">
        <DiagramaPortal />
      </div>

      <div class="firma__texto">
        <p class="eyebrow">Internet comunitario</p>
        <h2 class="h2" id="firma-titulo">
          Internet en todo el portal por el cable que ya tienes
        </h2>
        <div class="prosa">
          <p>
            La objeción que siempre sale en junta es la obra: canaletas por la escalera,
            agujeros y semanas de molestias. Con los sistemas <strong>Coaxdata</strong> y
            <strong>DSLAM</strong> esa objeción desaparece, porque el edificio ya tiene
            por dónde ir.
          </p>
          <p>
            Se aprovecha el coaxial de la antena o el par telefónico que ya está pasado.
            Solo se sustituye la cabecera y el equipo de cada vivienda. Cada vecino queda
            con su red separada del resto, y las altas y bajas se hacen sin subir a
            cubierta.
          </p>
        </div>
        <a class="btn btn--azul" href="/servicios/internet-comunitario/">
          Cómo se monta en tu edificio
          <Icono nombre="flecha" tamano={17} />
        </a>
      </div>
    </div>
  </section>

  <!-- Proceso -->
  <section class="section section--surface" aria-labelledby="proceso-titulo">
    <div class="container">
      <div class="cabecera cabecera--split">
        <p class="eyebrow">Cómo trabajamos</p>
        <h2 class="h2" id="proceso-titulo">De la llamada al certificado</h2>
        <p class="prosa">
          Cuatro pasos, en este orden, siempre. Sabes en qué punto estás y qué viene
          después.
        </p>
      </div>

      <ol class="pasos">
        {
          pasos.map((p, i) => (
            <li class="paso">
              <span class="paso__numero">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="h3">{p.titulo}</h3>
              <p class="paso__texto">{p.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Confianza -->
  <section class="section" aria-labelledby="pruebas-titulo">
    <div class="container pruebas__rejilla">
      <figure class="pruebas__foto">
        <Image
          src={fotoEquipo}
          alt="Técnico de ElectroSat TV instalando equipo en la cubierta de un edificio"
          widths={[420, 640, 900]}
          sizes="(min-width: 62rem) 26rem, 100vw"
          loading="lazy"
        />
      </figure>

      <div>
        <div class="cabecera">
          <p class="eyebrow">Por qué fiarte</p>
          <h2 class="h2" id="pruebas-titulo">Cinco cosas que se pueden comprobar</h2>
          <p class="prosa">
            Cualquiera puede decir que es serio. Esto es lo que lo demuestra, y todo se
            puede pedir por escrito antes de contratar.
          </p>
        </div>

        <ul class="pruebas">
          {
            pruebas.map((p) => (
              <li class="prueba">
                <span class="pastilla">
                  <Icono nombre={p.icono} tamano={22} />
                </span>
                <div>
                  <h3 class="h3">{p.titulo}</h3>
                  <p class="prueba__texto">{p.texto}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Marcas -->
  <section class="section section--surface" id="marcas" aria-labelledby="marcas-titulo">
    <div class="container">
      <div class="cabecera cabecera--split">
        <p class="eyebrow">Material</p>
        <h2 class="h2" id="marcas-titulo">Trabajamos con las mejores marcas</h2>
        <p class="prosa">
          Fabricantes con repuesto disponible durante años y soporte técnico real. Es lo
          que permite reparar una instalación dentro de diez años en vez de tener que
          rehacerla entera.
        </p>
      </div>
      <MuroMarcas />
    </div>
  </section>

  <!-- Cobertura -->
  <section class="section" id="cobertura" aria-labelledby="cobertura-titulo">
    <div class="container cobertura__rejilla">
      <div>
        <div class="cabecera">
          <p class="eyebrow">Zona de trabajo</p>
          <h2 class="h2" id="cobertura-titulo">Toda la isla de Tenerife</h2>
          <p class="prosa">
            Norte, sur y área metropolitana. Si tu municipio está en la lista, el
            desplazamiento para valorar el trabajo no se cobra.
          </p>
        </div>
        <ul class="cobertura">
          {empresa.cobertura.map((m) => <li>{m}</li>)}
        </ul>
      </div>

      <figure class="cobertura__foto">
        <Image
          src={fotoTenerife}
          alt="Vista aérea de una localidad de Tenerife junto a la montaña"
          widths={[420, 640, 900]}
          sizes="(min-width: 62rem) 24rem, 100vw"
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  <!-- Opiniones -->
  <section class="section section--surface" aria-labelledby="opiniones-titulo">
    <div class="container">
      <div class="cabecera">
        <p class="eyebrow">Clientes</p>
        <h2 class="h2" id="opiniones-titulo">Lo que dicen quienes ya nos han llamado</h2>
      </div>
      <ul class="opiniones">
        {
          opiniones.map((o) => (
            <li class="opinion">
              <span class="opinion__comillas" aria-hidden="true">
                &rdquo;
              </span>
              <blockquote>{o.texto}</blockquote>
              <footer class="opinion__firma">
                <span class="opinion__quien">{o.quien}</span>
                <span class="small">
                  {o.rol} · {o.donde}
                </span>
              </footer>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Preguntas -->
  <section class="section" aria-labelledby="faq-titulo">
    <div class="container faq__rejilla">
      <div class="cabecera">
        <p class="eyebrow">Dudas frecuentes</p>
        <h2 class="h2" id="faq-titulo">Lo que más nos preguntan</h2>
        <p class="prosa">
          Si no está aquí, llámanos y te lo resolvemos por teléfono.
        </p>
      </div>
      <Faq items={faq} />
    </div>
  </section>

  <BloqueContacto />
</Base>

<style>
  /* ---------- Portada ---------- */
  .hero {
    display: grid;
    background: var(--paper);
  }

  .hero__panel {
    display: flex;
    align-items: center;
    padding: clamp(2.5rem, 5vw, 4.5rem) var(--gutter);
  }

  .hero__texto {
    display: grid;
    gap: var(--s-4);
    width: 100%;
  }

  .hero .display-xl {
    max-width: 100%;
    overflow-wrap: break-word;
  }

  .hero__ventajas {
    display: grid;
    gap: 0.5rem;
    margin-top: var(--s-2);
  }

  .hero__ventajas li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--ink-2);
  }

  .hero__ventajas svg {
    color: var(--naranja-osc);
    flex: none;
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-3);
  }

  .hero__foto :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  @media (min-width: 62rem) {
    .hero {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }

    /* Alinea el texto con el contenedor sin impedir que la foto sangre. */
    .hero__panel {
      padding-left: max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter)));
      padding-right: var(--s-8);
    }

    .hero__foto :global(img) {
      aspect-ratio: auto;
      min-height: 32rem;
    }
  }

  /* ---------- Datos de confianza ---------- */
  .confianza {
    background: var(--paper);
    border-block: var(--hairline);
  }

  .confianza__lista {
    display: grid;
    gap: var(--s-4);
    padding-block: var(--s-5);
    grid-template-columns: 1fr;
  }

  @media (min-width: 40rem) {
    .confianza__lista {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--s-5);
    }
  }

  @media (min-width: 66rem) {
    .confianza__lista {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .confianza__item {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .confianza__dato {
    display: block;
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--ink);
  }

  .confianza__texto {
    display: block;
    font-size: var(--fs-small);
    line-height: 1.35;
    color: var(--ink-3);
  }

  /* ---------- Segmentos ---------- */
  .publicos {
    display: grid;
    gap: var(--s-5);
  }

  @media (min-width: 55rem) {
    .publicos {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .publico {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    padding: var(--s-5);
    background: var(--paper);
    border: var(--hairline);
    border-radius: var(--r-lg);
    box-shadow: var(--sombra-sm);
    transition: box-shadow var(--t-rapido), transform var(--t-rapido),
      border-color var(--t-rapido);
  }

  .publico:hover {
    border-color: var(--azul);
    box-shadow: var(--sombra);
    transform: translateY(-3px);
  }

  .publico__texto {
    font-size: var(--fs-small);
  }

  .publico .enlace-flecha {
    margin-top: var(--s-2);
  }

  /* ---------- Servicios ---------- */
  .servicios {
    display: grid;
    gap: var(--s-5);
  }

  @media (min-width: 44rem) {
    .servicios {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 66rem) {
    .servicios {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .servicio {
    background: var(--paper);
    border: var(--hairline);
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--sombra-sm);
    transition: box-shadow var(--t-rapido), transform var(--t-rapido),
      border-color var(--t-rapido);
  }

  .servicio:hover {
    border-color: var(--azul);
    box-shadow: var(--sombra-alta);
    transform: translateY(-3px);
  }

  .servicio__enlace {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .servicio__foto {
    position: relative;
    display: block;
    overflow: hidden;
  }

  .servicio__foto :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform var(--t-medio);
  }

  .servicio:hover .servicio__foto :global(img) {
    transform: scale(1.04);
  }

  .servicio__icono {
    position: absolute;
    left: var(--s-4);
    bottom: var(--s-4);
    display: grid;
