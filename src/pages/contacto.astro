---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import EstadoHorario from '../components/EstadoHorario.astro';
import {
  empresa,
  telHref,
  waHref,
  emailHref,
  direccionUnaLinea,
} from '../data/empresa';

const sitio = Astro.site!;
const jsonLd = [
  {
    '@type': 'ContactPage',
    name: 'Contacto',
    url: new URL('/contacto/', sitio).href,
    about: { '@id': new URL('/#negocio', sitio).href },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: sitio.href },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Contacto',
        item: new URL('/contacto/', sitio).href,
      },
    ],
  },
];

// Si más adelante se añade formulario hará falta: endpoint de envío, casilla
// de consentimiento, honeypot antispam y declarar el tratamiento en la política
// de privacidad.
---

<Base
  titulo="Contacto | ElectroSat TV, instalador de telecomunicaciones en Tenerife"
  descripcion="Teléfono, WhatsApp, correo, horario y dirección de ElectroSat TV. Atendemos comunidades, hoteles y viviendas en toda la isla de Tenerife."
  jsonLd={jsonLd}
>
  <section class="portada">
    <div class="container">
      <p class="eyebrow">Contacto</p>
      <h1 class="display-l">Llama y te lo resolvemos</h1>
      <p class="lede">
        Lo más rápido es el teléfono: muchas averías se identifican en la propia llamada.
        Si hace falta ir a verlo, la visita para valorar el trabajo es gratuita y sin
        compromiso en toda la isla.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container canales">
      <div class="canal canal--principal">
        <p class="eyebrow"><Icono nombre="telefono" tamano={15} />Teléfono</p>
        <a class="canal__numero tel-num" href={telHref()}>{empresa.telefono.display}</a>
        <p class="small">Atención directa en horario de oficina.</p>
        <a class="btn btn--primary btn--lg" href={telHref()}>
          <Icono nombre="telefono" tamano={18} />
          Llamar ahora
        </a>
      </div>

      <div class="canal">
        <p class="eyebrow"><Icono nombre="whatsapp" tamano={15} />WhatsApp</p>
        <a class="canal__numero canal__numero--sec tel-num" href={telHref(empresa.movil)}>
          {empresa.movil.display}
        </a>
        <p class="small">
          Es la vía más práctica para mandarnos una foto o un vídeo de la avería. Con
          verlo se adelanta media visita.
        </p>
        <a class="btn btn--ghost btn--lg" href={waHref()} rel="noopener noreferrer">
          <Icono nombre="whatsapp" tamano={18} />
          Abrir WhatsApp
        </a>
      </div>

      <div class="canal">
        <p class="eyebrow"><Icono nombre="email" tamano={15} />Correo</p>
        <a class="canal__email" href={emailHref}>{empresa.email}</a>
        <p class="small">
          Para presupuestos de comunidad, documentación y facturas. Respondemos en
          horario de oficina.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container datos">
      <div class="dato">
        <h2 class="eyebrow"><Icono nombre="reloj" tamano={15} />Horario</h2>
        <EstadoHorario />
        <p>{empresa.horarioTexto}</p>
        <p class="small">
          Fuera de ese horario deja un WhatsApp y te contestamos a primera hora.
        </p>
      </div>

      <div class="dato">
        <h2 class="eyebrow"><Icono nombre="mapa" tamano={15} />Dónde estamos</h2>
        <p>{empresa.razonSocial}</p>
        <p>{direccionUnaLinea}</p>
        <a class="enlace-flecha" href={empresa.mapsUrl} rel="noopener noreferrer">
          Abrir en Google Maps
        </a>
        <p class="small">
          El mapa se abre en una pestaña nueva a propósito: así esta web no carga
          rastreadores de terceros ni necesita avisarte de cookies.
        </p>
      </div>

      <div class="dato">
        <h2 class="eyebrow"><Icono nombre="documento" tamano={15} />Datos de la empresa</h2>
        <p>{empresa.razonSocial}</p>
        <p class="small tel-num">CIF {empresa.cif}</p>
        <p class="small tel-num">
          Empresa instaladora registrada nº {empresa.registroInstalador}
        </p>
      </div>

      <div class="dato">
        <h2 class="eyebrow"><Icono nombre="check" tamano={15} />Zona de trabajo</h2>
        <p>Toda la isla de Tenerife.</p>
        <p class="small">
          Norte, sur y área metropolitana. El desplazamiento para valorar el trabajo no
          se cobra.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .portada {
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
    border-bottom: var(--hairline);
  }

  .portada .container {
    display: grid;
    gap: var(--s-4);
  }

  .canales {
    display: grid;
    gap: var(--s-5);
  }

  @media (min-width: 55rem) {
    .canales {
      grid-template-columns: 1.2fr 1fr 1fr;
      gap: var(--s-6);
    }
  }

  .canal {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    justify-items: start;
    padding: var(--s-5);
    background: var(--paper);
    border: var(--hairline);
    border-top: 3px solid var(--azul);
    border-radius: var(--r-lg);
    box-shadow: var(--sombra-sm);
  }

  .canal--principal {
    border-top-color: var(--naranja);
  }

  .canal__numero {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 4vw, 2.75rem);
    font-weight: 700;
    line-height: 1;
    color: var(--ink);
    text-decoration: none;
  }

  .canal__numero:hover {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .canal__numero--sec {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .canal__email {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--ink);
  }

  .canal .small {
    max-width: 34ch;
  }

  .canal .btn {
    margin-top: var(--s-2);
  }

  .datos {
    display: grid;
    gap: var(--s-6);
  }

  @media (min-width: 44rem) {
    .datos {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 66rem) {
    .datos {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .dato {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    justify-items: start;
    padding: var(--s-5);
    background: var(--paper);
    border: var(--hairline);
    border-radius: var(--r-lg);
  }

  .dato h2 {
    margin-bottom: 0.25rem;
  }

  .dato p {
    font-size: var(--fs-body);
    color: var(--ink-2);
  }

  .dato .small {
    max-width: 32ch;
  }

  .dato .enlace-flecha {
    margin-top: 0.25rem;
  }
</style>
