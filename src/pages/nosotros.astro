---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import ArcoSenal from '../components/ArcoSenal.astro';
import MuroMarcas from '../components/MuroMarcas.astro';
import BloqueContacto from '../components/BloqueContacto.astro';
import { empresa, aniosActividad } from '../data/empresa';

const sitio = Astro.site!;
const jsonLd = [
  {
    '@type': 'AboutPage',
    name: `Sobre ${empresa.razonSocial}`,
    url: new URL('/nosotros/', sitio).href,
    about: { '@id': new URL('/#negocio', sitio).href },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: sitio.href },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Nosotros',
        item: new URL('/nosotros/', sitio).href,
      },
    ],
  },
];

const cifras = [
  { dato: `${aniosActividad}`, unidad: 'años', texto: 'De actividad en la isla' },
  { dato: `Nº ${empresa.registroInstalador}`, unidad: '', texto: 'Registro de instalador' },
  { dato: '5', unidad: 'áreas', texto: 'TV, seguridad, portería, red e ICT' },
  { dato: '1', unidad: 'isla', texto: 'Tenerife entera, norte y sur' },
];

const compromisos = [
  {
    icono: 'euro' as const,
    titulo: 'Se dice el precio antes',
    texto:
      'Presupuesto por partidas, con el material que lleva cada una. Si en obra aparece algo no previsto, se para y se consulta. Nunca se factura de más sin avisar.',
  },
  {
    icono: 'documento' as const,
    titulo: 'Se deja por escrito',
    texto:
      'Mediciones, certificado de la instalación y garantía. En una comunidad ese papel es lo que permite al administrador justificar el gasto y reclamar si algo falla.',
  },
  {
    icono: 'herramienta' as const,
    titulo: 'Se monta para durar',
    texto:
      'Material de marca con repuesto disponible y cableado rematado. Una instalación barata que hay que rehacer en tres años no ha ahorrado nada.',
  },
  {
    icono: 'telefono' as const,
    titulo: 'Se coge el teléfono',
    texto:
      'Después de instalar seguimos siendo los mismos. Cuando llames por una incidencia te atenderá alguien que sabe qué se montó en tu edificio.',
  },
];
---

<Base
  titulo="Sobre nosotros | ElectroSat TV, instalador registrado en Tenerife"
  descripcion="Quiénes somos, cómo trabajamos y qué acredita a ElectroSat TV como empresa instaladora de telecomunicaciones registrada en la isla de Tenerife."
  jsonLd={jsonLd}
>
  <section class="portada">
    <div class="container">
      <p class="eyebrow"><ArcoSenal />Nosotros</p>
      <h1 class="display-l">Una empresa de la isla, para edificios de la isla</h1>
      <p class="lede">
        {empresa.razonSocial} lleva {aniosActividad} años montando y manteniendo
        instalaciones de telecomunicación en Tenerife. Comunidades, hoteles y viviendas.
      </p>
    </div>
  </section>

  <section class="cifras" aria-label="Datos de la empresa">
    <ul class="container cifras__lista">
      {
        cifras.map((c) => (
          <li>
            <span class="cifras__dato mono">
              {c.dato}
              {c.unidad && <span class="cifras__unidad"> {c.unidad}</span>}
            </span>
            <span class="cifras__texto">{c.texto}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <div class="container historia">
      <div class="cabecera cabecera--ancha historia__cabecera">
        <p class="eyebrow"><ArcoSenal />La empresa</p>
        <h2 class="h2">Conocemos los edificios porque llevamos años subiendo a ellos</h2>
      </div>

      {/* TODO CLIENTE: sustituir por la historia real. Cuando empezó, quién la
          fundó, cómo creció y en qué es especialista hoy. Lo de abajo es una base
          coherente con el sector, no la biografía real de la empresa. */}
      <div class="prosa">
        <p>
          Empezamos con antenas de televisión, que es de donde viene el nombre. Con los
          años, los mismos edificios nos fueron pidiendo cámaras, porteros, redes y, más
          tarde, internet para todas las viviendas. Hoy trabajamos las cinco cosas, porque
          en un portal comparten cableado, recinto y problemas.
        </p>
        <p>
          Eso es lo que marca la diferencia frente a llamar a un instalador distinto para
          cada cosa. Cuando la misma empresa monta la cabecera de televisión y el reparto
          de datos, no hay dos instalaciones peleándose por el mismo cable ni nadie a
          quien echarle la culpa cuando algo deja de funcionar.
        </p>
        <p>
          Trabajamos en toda la isla y la mayoría de encargos llegan por recomendación de
          administradores de fincas y de vecinos a los que ya hemos resuelto algo. Esa es
          la razón por la que cuidamos tanto el remate y el papel que se entrega al final.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="compromisos-titulo">
    <div class="container">
      <div class="cabecera cabecera--split">
        <p class="eyebrow"><ArcoSenal />Cómo trabajamos</p>
        <h2 class="h2" id="compromisos-titulo">Cuatro cosas que no se negocian</h2>
        <p class="prosa">
          No son valores de folleto. Son las cuatro cosas por las que un cliente vuelve a
          llamarnos y por las que un administrador nos recomienda a otra comunidad.
        </p>
      </div>

      <ul class="compromisos">
        {
          compromisos.map((c) => (
            <li class="compromiso">
              <Icono nombre={c.icono} tamano={26} class="compromiso__icono" />
              <div>
                <h3 class="h3">{c.titulo}</h3>
                <p>{c.texto}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="material-titulo">
    <div class="container">
      <div class="cabecera cabecera--split">
        <p class="eyebrow"><ArcoSenal />Material</p>
        <h2 class="h2" id="material-titulo">Con qué montamos</h2>
        <p class="prosa">
          Fabricantes con repuesto y soporte de verdad. Es lo que permite reparar una
          instalación años después en lugar de tener que sustituirla entera.
        </p>
      </div>
      <MuroMarcas />
    </div>
  </section>

  <BloqueContacto
    titulo="¿Quieres que veamos tu edificio?"
    texto="Llámanos y concretamos una visita. Vamos, lo medimos y te decimos con qué te encuentras, con presupuesto por escrito y sin compromiso."
  />
</Base>

<style>
  .portada {
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }

  .portada .container {
    display: grid;
    gap: var(--s-4);
  }

  .portada .lede {
    max-width: 58ch;
  }

  .cifras {
    border-block: var(--hairline);
  }

  .cifras__lista {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  @media (min-width: 48rem) {
    .cifras__lista {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .cifras__lista li {
    display: grid;
    gap: 0.375rem;
    align-content: start;
    padding: var(--s-5) var(--s-4) var(--s-5) 0;
  }

  .cifras__lista li + li {
    padding-left: var(--s-4);
    border-left: var(--hairline);
  }

  .cifras__dato {
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1;
    color: var(--ink);
  }

  .cifras__unidad {
    font-size: 0.875rem;
    color: var(--ink-3);
  }

  .cifras__texto {
    font-size: var(--fs-small);
    line-height: 1.4;
    color: var(--ink-3);
  }

  .historia {
    display: grid;
    gap: var(--s-6);
  }

  @media (min-width: 62rem) {
    .historia {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      gap: var(--s-8);
      align-items: start;
    }

    .historia__cabecera {
      margin-bottom: 0;
      position: sticky;
      top: calc(var(--header-h) + var(--s-6));
    }
  }

  .compromisos {
    display: grid;
    border-top: var(--hairline);
  }

  @media (min-width: 55rem) {
    .compromisos {
      grid-template-columns: repeat(2, 1fr);
      column-gap: var(--s-7);
    }
  }

  .compromiso {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-4);
    padding-block: var(--s-5);
    border-bottom: var(--hairline);
  }

  .compromiso__icono {
    color: var(--ink);
    margin-top: 0.125rem;
  }

  .compromiso p {
    margin-top: 0.5rem;
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 50ch;
  }
</style>
