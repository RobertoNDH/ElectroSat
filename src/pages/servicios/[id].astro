---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import ArcoSenal from '../../components/ArcoSenal.astro';
import Faq from '../../components/Faq.astro';
import BloqueContacto from '../../components/BloqueContacto.astro';
import { empresa, telHref, waHref } from '../../data/empresa';

export async function getStaticPaths() {
  const servicios = await getCollection('servicios');
  return servicios.map((servicio) => ({
    params: { id: servicio.id },
    props: { servicio },
  }));
}

const { servicio } = Astro.props;
const { data } = servicio;
const { Content } = await render(servicio);

const otros = (await getCollection('servicios'))
  .filter((s) => s.id !== servicio.id)
  .sort((a, b) => a.data.orden - b.data.orden);

const sitio = Astro.site!;
const url = new URL(Astro.url.pathname, sitio).href;

const jsonLd = [
  {
    '@type': 'Service',
    name: data.titulo,
    description: data.descripcion,
    url,
    provider: { '@id': new URL('/#negocio', sitio).href },
    areaServed: { '@type': 'AdministrativeArea', name: 'Tenerife' },
  },
  {
    '@type': 'FAQPage',
    mainEntity: data.faq.map((f) => ({
      '@type': 'Question',
      name: f.p,
      acceptedAnswer: { '@type': 'Answer', text: f.r },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: sitio.href },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Servicios',
        item: new URL('/servicios/', sitio).href,
      },
      { '@type': 'ListItem', position: 3, name: data.corto, item: url },
    ],
  },
];
---

<Base titulo={data.tituloSeo} descripcion={data.descripcion} jsonLd={jsonLd}>
  <nav class="miga" aria-label="Ruta de navegación">
    <ol class="container">
      <li><a href="/">Inicio</a></li>
      <li><a href="/servicios/">Servicios</a></li>
      <li aria-current="page">{data.corto}</li>
    </ol>
  </nav>

  <section class="portada">
    <div class="container portada__rejilla">
      <div class="portada__texto">
        <p class="eyebrow"><ArcoSenal />{data.corto}</p>
        <h1 class="display-l">{data.titulo}</h1>
        <p class="lede">{data.entradilla}</p>
        <div class="portada__acciones">
          <a class="btn btn--primary btn--lg" href={telHref()}>
            <Icono nombre="telefono" tamano={18} />
            Llamar al {empresa.telefono.display}
          </a>
          <a class="btn btn--ghost btn--lg" href={waHref()} rel="noopener noreferrer">
            <Icono nombre="whatsapp" tamano={18} />
            WhatsApp
          </a>
        </div>
      </div>
      <div class="portada__icono" aria-hidden="true">
        <Icono nombre={data.icono} tamano={140} />
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container detalle">
      <div class="prosa detalle__prosa">
        <Content />
      </div>

      <aside class="incluye">
        <h2 class="eyebrow">Qué incluye el trabajo</h2>
        <ul>
          {
            data.incluye.map((linea) => (
              <li>
                <Icono nombre="check" tamano={16} />
                {linea}
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="publico-titulo">
    <div class="container">
      <div class="cabecera cabecera--ancha">
        <p class="eyebrow"><ArcoSenal />Para quién</p>
        <h2 class="h2" id="publico-titulo">Cómo se plantea según el caso</h2>
      </div>
      <ul class="casos">
        {
          data.publico.map((p) => (
            <li class="caso">
              <h3 class="h3">{p.tipo}</h3>
              <p>{p.texto}</p>
            </li>
          ))
        }
      </ul>

      {
        data.marcas.length > 0 && (
          <p class="marcas-linea">
            <span class="eyebrow">Material</span>
            <span>{data.marcas.join(' · ')}</span>
          </p>
        )
      }
    </div>
  </section>

  <section class="section" aria-labelledby="faq-servicio">
    <div class="container faq-servicio">
      <div class="cabecera cabecera--ancha">
        <p class="eyebrow"><ArcoSenal />Dudas frecuentes</p>
        <h2 class="h2" id="faq-servicio">Sobre {data.corto.toLowerCase()}</h2>
      </div>
      <Faq items={data.faq} />
    </div>
  </section>

  <BloqueContacto
    titulo={`¿Hablamos de tu caso de ${data.corto.toLowerCase()}?`}
    texto="Cuéntanos qué tienes montado y qué necesitas. Si hace falta ir a verlo, la visita para valorar el trabajo es gratuita y sin compromiso."
  />

  <section class="section section--tight otros" aria-labelledby="otros-titulo">
    <div class="container">
      <h2 class="eyebrow" id="otros-titulo">Otros servicios</h2>
      <ul class="otros__lista">
        {
          otros.map((o) => (
            <li>
              <a href={`/servicios/${o.id}/`}>
                <Icono nombre={o.data.icono} tamano={22} />
                <span>{o.data.corto}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  /* ---------- Miga ---------- */
  .miga {
    border-bottom: var(--hairline);
  }

  .miga ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-block: 0.875rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }

  .miga li + li::before {
    content: '/';
    margin-right: 0.5rem;
    color: var(--line-strong);
  }

  .miga a {
    color: inherit;
    text-decoration: none;
  }

  .miga a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  /* ---------- Portada ---------- */
  .portada {
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
    border-bottom: var(--hairline);
  }

  .portada__rejilla {
    display: grid;
    gap: var(--s-6);
    align-items: center;
  }

  @media (min-width: 62rem) {
    .portada__rejilla {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--s-8);
    }
  }

  .portada__texto {
    display: grid;
    gap: var(--s-4);
  }

  .portada__texto .lede {
    max-width: 58ch;
  }

  .portada__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }

  .portada__icono {
    display: none;
    color: var(--line-strong);
  }

  @media (min-width: 62rem) {
    .portada__icono {
      display: block;
    }
  }

  /* ---------- Detalle ---------- */
  .detalle {
    display: grid;
    gap: var(--s-7);
  }

  @media (min-width: 62rem) {
    .detalle {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: var(--s-8);
      align-items: start;
    }
  }

  .detalle__prosa :global(p + p) {
    margin-top: var(--s-4);
  }

  .incluye {
    padding: var(--s-5);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
  }

  .incluye ul {
    display: grid;
    gap: 0;
    margin-top: var(--s-4);
  }

  .incluye li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    align-items: start;
    padding-block: 0.75rem;
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--ink-2);
    border-top: var(--hairline);
  }

  .incluye li :global(svg) {
    margin-top: 0.1875rem;
    color: var(--ink);
  }

  /* ---------- Casos ---------- */
  .casos {
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    overflow: hidden;
  }

  @media (min-width: 48rem) {
    .casos {
      grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    }
  }

  .caso {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    padding: var(--s-5);
    background: var(--paper);
  }

  .caso p {
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--ink-2);
  }

  .marcas-linea {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem var(--s-4);
    margin-top: var(--s-5);
    padding-top: var(--s-4);
    border-top: var(--hairline);
    font-size: var(--fs-small);
    color: var(--ink-2);
  }

  /* ---------- FAQ ---------- */
  @media (min-width: 62rem) {
    .faq-servicio {
      display: grid;
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: var(--s-8);
      align-items: start;
    }

    .faq-servicio .cabecera {
      margin-bottom: 0;
    }
  }

  /* ---------- Otros ---------- */
  .otros__lista {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-4);
  }

  .otros__lista a {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.75rem 1.125rem;
    border: 1px solid var(--control);
    border-radius: var(--r-sm);
    font-size: var(--fs-small);
    font-weight: 550;
    text-decoration: none;
    color: var(--ink-2);
    transition: border-color var(--t-fast), color var(--t-fast);
  }

  .otros__lista a:hover {
    border-color: var(--ink);
    color: var(--ink);
  }
</style>
