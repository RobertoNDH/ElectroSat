---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import Faq from '../../components/Faq.astro';
import BloqueContacto from '../../components/BloqueContacto.astro';
import { fotoServicio } from '../../data/imagenes';
import { empresa, telHref, waHref } from '../../data/empresa';

export async function getStaticPaths() {
  const servicios = await getCollection('servicios');
  return servicios.map((servicio) => ({
    params: { id: servicio.id },
    props: { servicio },
  }));
}

const { servicio } = Astro.props;
const { data } = servicio;
const { Content } = await render(servicio);
const foto = fotoServicio[servicio.id];

const otros = (await getCollection('servicios'))
  .filter((s) => s.id !== servicio.id)
  .sort((a, b) => a.data.orden - b.data.orden);

const sitio = Astro.site!;
const url = new URL(Astro.url.pathname, sitio).href;

const jsonLd = [
  {
    '@type': 'Service',
    name: data.titulo,
    description: data.descripcion,
    url,
    provider: { '@id': new URL('/#negocio', sitio).href },
    areaServed: { '@type': 'AdministrativeArea', name: 'Tenerife' },
  },
  {
    '@type': 'FAQPage',
    mainEntity: data.faq.map((f) => ({
      '@type': 'Question',
      name: f.p,
      acceptedAnswer: { '@type': 'Answer', text: f.r },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: sitio.href },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Servicios',
        item: new URL('/servicios/', sitio).href,
      },
      { '@type': 'ListItem', position: 3, name: data.corto, item: url },
    ],
  },
];
---

<Base titulo={data.tituloSeo} descripcion={data.descripcion} jsonLd={jsonLd}>
  <nav class="miga" aria-label="Ruta de navegación">
    <ol class="container">
      <li><a href="/">Inicio</a></li>
      <li><a href="/servicios/">Servicios</a></li>
      <li aria-current="page">{data.corto}</li>
    </ol>
  </nav>

  <section class="portada">
    <div class="container portada__rejilla">
      <div class="portada__texto">
        <p class="eyebrow">{data.corto}</p>
        <h1 class="display-l">{data.titulo}</h1>
        <p class="lede">{data.entradilla}</p>
        <div class="portada__acciones">
          <a class="btn btn--principal btn--lg" href={telHref()}>
            <Icono nombre="telefono" tamano={18} />
            Llamar al {empresa.telefono.display}
          </a>
          <a class="btn btn--linea btn--lg" href={waHref()} rel="noopener noreferrer">
            <Icono nombre="whatsapp" tamano={18} />
            WhatsApp
          </a>
        </div>
      </div>

      <figure class="portada__foto">
        <Image
          src={foto}
          alt={`Instalación de ${data.corto.toLowerCase()} realizada por ElectroSat TV`}
          widths={[520, 780, 1040]}
          sizes="(min-width: 62rem) 30rem, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container detalle">
      <div class="prosa detalle__prosa">
        <Content />
      </div>

      <aside class="incluye">
        <h2 class="incluye__titulo">
          <span class="pastilla pastilla--naranja">
            <Icono nombre="check" tamano={20} />
          </span>
          Qué incluye el trabajo
        </h2>
        <ul>
          {
            data.incluye.map((linea) => (
              <li>
                <Icono nombre="check" tamano={16} />
                {linea}
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="publico-titulo">
    <div class="container">
      <div class="cabecera">
        <p class="eyebrow">Para quién</p>
        <h2 class="h2" id="publico-titulo">Cómo se plantea según el caso</h2>
      </div>
      <ul class="casos">
        {
          data.publico.map((p) => (
            <li class="caso">
              <h3 class="h3">{p.tipo}</h3>
              <p>{p.texto}</p>
            </li>
          ))
        }
      </ul>

      {
        data.marcas.length > 0 && (
          <p class="marcas-linea">
            <Icono nombre="herramienta" tamano={17} />
            <span class="marcas-linea__etiqueta">Material</span>
            <span>{data.marcas.join(' · ')}</span>
          </p>
        )
      }
    </div>
  </section>

  <section class="section" aria-labelledby="faq-servicio">
    <div class="container faq-servicio">
      <div class="cabecera">
        <p class="eyebrow">Dudas frecuentes</p>
        <h2 class="h2" id="faq-servicio">Sobre {data.corto.toLowerCase()}</h2>
      </div>
      <Faq items={data.faq} />
    </div>
  </section>

  <BloqueContacto
    titulo={`¿Hablamos de tu caso de ${data.corto.toLowerCase()}?`}
    texto="Cuéntanos qué tienes montado y qué necesitas. Si hace falta ir a verlo, la visita para valorar el trabajo es gratuita y sin compromiso."
  />

  <section class="section section--tight otros" aria-labelledby="otros-titulo">
    <div class="container">
      <h2 class="otros__titulo" id="otros-titulo">Otros servicios</h2>
      <ul class="otros__lista">
        {
          otros.map((o) => (
            <li>
              <a href={`/servicios/${o.id}/`}>
                <Icono nombre={o.data.icono} tamano={20} />
                <span>{o.data.corto}</span>
                <Icono nombre="flecha" tamano={16} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .miga {
    background: var(--surface);
    border-bottom: var(--hairline);
  }

  .miga ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-block: 0.75rem;
    font-size: 0.8125rem;
    color: var(--ink-3);
  }

  .miga li + li::before {
    content: '/';
    margin-right: 0.5rem;
    color: var(--control);
  }

  .miga a {
    color: var(--ink-2);
    text-decoration: none;
  }

  .miga a:hover {
    color: var(--azul);
    text-decoration: underline;
  }

  .portada {
    padding-block: clamp(2.25rem, 4.5vw, 3.5rem);
    border-bottom: var(--hairline);
  }

  .portada__rejilla {
    display: grid;
    gap: var(--s-6);
    align-items: center;
  }

  @media (min-width: 62rem) {
    .portada__rejilla {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: var(--s-8);
    }
  }

  .portada__texto {
    display: grid;
    gap: var(--s-4);
  }

  .portada__texto .lede {
    max-width: 54ch;
  }

  .portada__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }

  .portada__foto {
    margin: 0;
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--sombra);
  }

  .portada__foto :global(img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .detalle {
    display: grid;
    gap: var(--s-6);
  }

  @media (min-width: 62rem) {
    .detalle {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: var(--s-8);
      align-items: start;
    }
  }

  .incluye {
    padding: var(--s-5);
    background: var(--surface);
    border: var(--hairline);
    border-radius: var(--r-lg);
  }

  .incluye__titulo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-base);
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--ink);
  }

  .incluye ul {
    display: grid;
    margin-top: var(--s-4);
  }

  .incluye li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    align-items: start;
    padding-block: 0.75rem;
    font-size: var(--fs-small);
    border-top: var(--hairline);
  }

  .incluye li :global(svg) {
    margin-top: 0.25rem;
    color: var(--naranja-osc);
  }

  .casos {
    display: grid;
    gap: var(--s-4);
  }

  @media (min-width: 48rem) {
    .casos {
      grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    }
  }

  .caso {
    position: relative;
    display: grid;
    gap: var(--s-2);
    align-content: start;
    padding: var(--s-5);
    background: var(--paper);
    border: var(--hairline);
    border-radius: var(--r-md);
    overflow: hidden;
  }

  .caso::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: var(--azul);
  }

  .caso p {
    font-size: var(--fs-small);
  }

  .marcas-linea {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem var(--s-3);
    margin-top: var(--s-5);
    padding-top: var(--s-4);
    border-top: var(--hairline);
    font-size: var(--fs-small);
  }

  .marcas-linea :global(svg) {
    color: var(--azul);
  }

  .marcas-linea__etiqueta {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  @media (min-width: 62rem) {
    .faq-servicio {
      display: grid;
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: var(--s-8);
      align-items: start;
    }

    .faq-servicio .cabecera {
      margin-bottom: 0;
    }
  }

  .otros__titulo {
    font-family: var(--font-base);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .otros__lista {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-4);
  }

  .otros__lista a {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.75rem 1.125rem;
    background: var(--paper);
    border: var(--hairline);
    border-radius: var(--r-sm);
    font-size: var(--fs-small);
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
    transition: border-color var(--t-rapido), box-shadow var(--t-rapido);
  }

  .otros__lista a:hover {
    border-color: var(--azul);
    box-shadow: var(--sombra-sm);
  }
</style>
