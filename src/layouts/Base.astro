---
import '@fontsource-variable/montserrat';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/700.css';
import '../styles/tokens.css';
import '../styles/base.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BarraLlamada from '../components/BarraLlamada.astro';
import Animaciones from '../components/Animaciones.astro';
import { empresa, horarioSchema } from '../data/empresa';
import { CODIGOS, IDIOMAS, equivalente, publico, type Idioma } from '../i18n/config';
import { t } from '../i18n/textos';

interface Props {
  lang: Idioma;
  titulo: string;
  descripcion: string;
  /** Nodos extra de datos estructurados: Service, FAQPage, BreadcrumbList. */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const { lang, titulo, descripcion, jsonLd = [], noindex = false } = Astro.props;
const txt = t(lang);
const idioma = IDIOMAS[lang];

const sitio = Astro.site!;
const canonical = new URL(Astro.url.pathname, sitio).href;
const ogImagen = new URL(publico('og-default.png'), sitio).href;

const negocio = {
  '@type': 'LocalBusiness',
  '@id': new URL('/#negocio', sitio).href,
  name: empresa.razonSocial,
  alternateName: empresa.nombre,
  description: empresa.descripcion,
  url: sitio.href,
  telephone: empresa.telefono.e164,
  email: empresa.email,
  image: ogImagen,
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${empresa.direccion.calle}, ${empresa.direccion.barrio}`,
    postalCode: empresa.direccion.cp,
    addressLocality: empresa.direccion.municipio,
    addressRegion: empresa.direccion.provincia,
    addressCountry: empresa.direccion.pais,
  },
  areaServed: empresa.cobertura.map((m) => ({ '@type': 'Place', name: m })),
  openingHoursSpecification: horarioSchema,
};

const grafo = { '@context': 'https://schema.org', '@graph': [negocio, ...jsonLd] };

// mailto: solo abre algo si el dispositivo tiene un cliente de correo
// configurado. Como refuerzo, al pulsar cualquier enlace de correo se copia
// la dirección al portapapeles y se avisa, para que funcione también donde no
// hay cliente (típico en ordenadores de escritorio sin Outlook ni Mail).
const avisoCorreoCopiado = txt.acciones.correoCopiado(empresa.email);
---

<!doctype html>
<html lang={idioma.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {
      /* Las alternativas de idioma solo salen en las páginas que existen en los
         tres idiomas. Las legales y la 404 van marcadas con noindex y solo
         existen en español, así que declararlas apuntaría a URL inexistentes. */
      !noindex && (
        <>
          {CODIGOS.map((codigo) => (
            <link
              rel="alternate"
              hreflang={IDIOMAS[codigo].htmlLang}
              href={new URL(equivalente(Astro.url, codigo), sitio).href}
            />
          ))}
          <link
            rel="alternate"
            hreflang="x-default"
            href={new URL(equivalente(Astro.url, 'es'), sitio).href}
          />
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={empresa.razonSocial} />
    <meta property="og:locale" content={idioma.ogLocale} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImagen} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={publico('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={publico('apple-touch-icon.png')} />
    <meta name="theme-color" content="#0b7099" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(grafo)} />
  </head>

  <body>
    <a class="saltar" href="#contenido">{txt.nav.saltar}</a>
    <Header lang={lang} />
    <main id="contenido">
      <slot />
    </main>
    <Footer lang={lang} />
    <slot name="tras-pie" />
    <BarraLlamada lang={lang} />
    <Animaciones />

    <p class="aviso-copia" data-aviso-copia={avisoCorreoCopiado} aria-live="polite"></p>

    <script>
      const aviso = document.querySelector<HTMLElement>('[data-aviso-copia]');
      const texto = aviso?.dataset.avisoCopia;
      let temporizador: ReturnType<typeof setTimeout>;

      if (aviso && texto && navigator.clipboard) {
        for (const enlace of document.querySelectorAll<HTMLAnchorElement>('a[href^="mailto:"]')) {
          enlace.addEventListener('click', () => {
            navigator.clipboard.writeText(enlace.href.replace(/^mailto:/, '').split('?')[0]).then(() => {
              aviso.textContent = texto;
              aviso.classList.add('is-visible');
              clearTimeout(temporizador);
              temporizador = setTimeout(() => aviso.classList.remove('is-visible'), 2600);
            }).catch(() => {});
          });
        }
      }
    </script>

    <style is:global>
      /* Hueco para la barra fija de llamada en móvil. */
      body {
        padding-bottom: calc(var(--barra-h) + env(safe-area-inset-bottom));
      }

      @media (min-width: 62rem) {
        body {
          padding-bottom: 0;
        }
      }

      /* Confirmación tras copiar el correo al portapapeles. */
      .aviso-copia {
        position: fixed;
        left: 50%;
        bottom: calc(var(--barra-h) + var(--s-4) + env(safe-area-inset-bottom));
        z-index: 60;
        margin: 0;
        padding: 0.6875rem 1.25rem;
        max-width: calc(100% - 2.5rem);
        background: var(--ink);
        color: var(--on-oscuro);
        font-size: var(--fs-small);
        font-weight: 600;
        text-align: center;
        border-radius: 999px;
        box-shadow: var(--sombra-alta);
        opacity: 0;
        transform: translate(-50%, 8px);
        pointer-events: none;
        transition: opacity 220ms ease, transform 220ms ease;
      }

      .aviso-copia.is-visible {
        opacity: 1;
        transform: translate(-50%, 0);
      }

      @media (min-width: 62rem) {
        .aviso-copia {
          bottom: var(--s-6);
        }
      }
    </style>
  </body>
</html>
