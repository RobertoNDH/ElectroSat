---
import Base from './Base.astro';

interface Props {
  titulo: string;
  tituloSeo: string;
  descripcion: string;
  actualizado: string;
}
const { titulo, tituloSeo, descripcion, actualizado } = Astro.props;
---

<Base titulo={tituloSeo} descripcion={descripcion} noindex>
  <section class="portada">
    <div class="container">
      <p class="eyebrow">Información legal</p>
      <h1 class="display-l">{titulo}</h1>
      <p class="small">Última actualización: {actualizado}</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <article class="legal">
        <slot />
      </article>
    </div>
  </section>
</Base>

<style>
  .portada {
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-bottom: var(--hairline);
  }

  .portada .container {
    display: grid;
    gap: var(--s-3);
  }

  .legal {
    max-width: 70ch;
    color: var(--ink-2);
  }

  .legal :global(h2) {
    margin-top: var(--s-7);
    margin-bottom: var(--s-3);
    font-size: 1.25rem;
    font-weight: 650;
    font-stretch: 104%;
    color: var(--ink);
  }

  .legal :global(h2:first-child) {
    margin-top: 0;
  }

  .legal :global(p) {
    margin-bottom: var(--s-4);
    text-wrap: pretty;
  }

  .legal :global(ul) {
    display: grid;
    gap: 0.625rem;
    margin-bottom: var(--s-4);
  }

  .legal :global(li) {
    position: relative;
    padding-left: 1.125rem;
  }

  .legal :global(li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75rem;
    width: 0.5rem;
    height: 1px;
    background: var(--control);
  }

  .legal :global(dl) {
    display: grid;
    gap: 0;
    margin-bottom: var(--s-4);
    border-top: var(--hairline);
  }

  .legal :global(dl > div) {
    display: grid;
    gap: 0.25rem;
    padding-block: 0.75rem;
    border-bottom: var(--hairline);
  }

  @media (min-width: 40rem) {
    .legal :global(dl > div) {
      grid-template-columns: 14rem 1fr;
      gap: var(--s-4);
    }
  }

  .legal :global(dt) {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--azul);
    padding-top: 0.25rem;
  }

  .legal :global(dd) {
    margin: 0;
    color: var(--ink);
  }

  .legal :global(.aviso) {
    padding: var(--s-4);
    background: var(--naranja-tinte);
    border-left: 4px solid var(--naranja);
    border-radius: 0 var(--r-sm) var(--r-sm) 0;
    font-size: var(--fs-small);
  }
</style>
