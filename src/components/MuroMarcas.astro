---
// Muro de marcas. Se muestran como texto hasta que el cliente confirme con
// cuáles trabaja y facilite los logotipos autorizados.
import { marcas } from '../data/marcas';
---

<ul class="marcas">
  {
    marcas.map((m) => (
      <li class="marcas__item">
        <span class="marcas__nombre">{m.nombre}</span>
        <span class="marcas__para">{m.para}</span>
      </li>
    ))
  }
</ul>

<style>
  .marcas {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr));
    gap: 0.75rem;
  }

  .marcas__item {
    display: grid;
    align-content: center;
    gap: 0.25rem;
    min-height: 6rem;
    padding: var(--s-4);
    background: var(--paper);
    border: var(--hairline);
    border-radius: var(--r-md);
    text-align: center;
    transition: border-color var(--t-rapido), box-shadow var(--t-rapido),
      transform var(--t-rapido);
  }

  .marcas__item:hover {
    border-color: var(--azul);
    box-shadow: var(--sombra-sm);
    transform: translateY(-2px);
  }

  .marcas__nombre {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .marcas__para {
    font-size: 0.75rem;
    line-height: 1.35;
    color: var(--ink-3);
  }
</style>
