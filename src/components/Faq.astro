---
// Acordeón sobre <details>: sin JavaScript y accesible por teclado de serie.
interface Props {
  items: readonly { p: string; r: string }[];
}
const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((item) => (
      <details class="faq__item" name="faq">
        <summary class="faq__pregunta">
          <span>{item.p}</span>
          <span class="faq__signo" aria-hidden="true" />
        </summary>
        <p class="faq__respuesta">{item.r}</p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: grid;
    gap: 0.75rem;
  }

  .faq__item {
    background: var(--paper);
    border: var(--hairline);
    border-radius: var(--r-md);
    transition: border-color var(--t-rapido), box-shadow var(--t-rapido);
  }

  .faq__item:hover,
  .faq__item[open] {
    border-color: var(--azul);
    box-shadow: var(--sombra-sm);
  }

  .faq__pregunta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding: 1.125rem var(--s-5);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }

  .faq__pregunta::-webkit-details-marker {
    display: none;
  }

  .faq__signo {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--azul-tinte);
  }

  .faq__signo::before,
  .faq__signo::after {
    content: '';
    position: absolute;
    width: 0.75rem;
    height: 2px;
    border-radius: 1px;
    background: var(--azul);
    transition: transform var(--t-rapido);
  }

  .faq__signo::after {
    transform: rotate(90deg);
  }

  .faq__item[open] .faq__signo {
    background: var(--azul);
  }

  .faq__item[open] .faq__signo::before,
  .faq__item[open] .faq__signo::after {
    background: var(--on-oscuro);
  }

  .faq__item[open] .faq__signo::after {
    transform: rotate(0deg);
  }

  .faq__respuesta {
    max-width: 62ch;
    padding: 0 var(--s-5) 1.375rem;
    color: var(--ink-2);
    text-wrap: pretty;
  }
</style>
