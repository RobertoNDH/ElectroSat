---
// Portada de la home: cuatro fotos a sangre que se turnan.
// La primera lleva el titular de marca ("Especialistas en telecomunicaciones
// en el sur de Tenerife") y es la única que se pinta como <h1>: es el texto
// que Google indexa como titular de la página, así que abre ella.
//
// Sin librerías. Las diapositivas van apiladas y se cambian con una clase, no
// con estilos en línea, porque la CSP no admite el atributo style. Si el script
// no llega a ejecutarse se ve la primera diapositiva entera, con su titular y
// sus dos botones: la portada nunca queda en blanco.
import { Image } from 'astro:assets';
import Icono from './Icono.astro';
import Valoracion from './Valoracion.astro';
import { empresa, telHref, waHref } from '../data/empresa';
import type { Idioma } from '../i18n/config';
import { t } from '../i18n/textos';

import foto0 from '../assets/cobertura-sur.jpg';
import foto1 from '../assets/hero-1-antenas.jpg';
import foto2 from '../assets/hero-2-camaras.jpg';
import foto3 from '../assets/hero-3-internet.jpg';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const txt = t(lang);

// El encuadre de cada foto se elige a mano: la primera es vertical y su motivo
// queda en el tercio superior, así que centrarla dejaría fuera las antenas.
const FOTOS = [
  { src: foto0, encuadre: 'centro' as const },
  { src: foto1, encuadre: 'alto' as const },
  { src: foto2, encuadre: 'centro' as const },
  { src: foto3, encuadre: 'centro' as const },
];

const slides = txt.hero.slides.map((s, i) => ({ ...s, ...FOTOS[i] }));
---

<section
  class="hero sobre-noche"
  data-hero
  aria-roledescription={txt.hero.carrusel}
  aria-label={txt.hero.carruselEtiqueta}
>
  <div class="hero__pila">
    {
      slides.map((s, i) => (
        <article
          class:list={['hero__slide', i === 0 && 'is-activa']}
          data-slide
          role="group"
          aria-roledescription={txt.hero.diapositiva}
          aria-label={txt.hero.deTotal(i + 1, slides.length)}
          aria-hidden={i === 0 ? undefined : 'true'}
        >
          <Image
            class:list={['hero__foto', `hero__foto--${s.encuadre}`]}
            src={s.src}
            alt={s.alt}
            widths={[760, 1200, 1800, 2400]}
            sizes="100vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
          />
        </article>
      ))
    }
    <div class="hero__velo"></div>
  </div>

  <div class="container hero__contenido">
    {
      slides.map((s, i) => (
        <div class:list={['hero__texto', i === 0 && 'is-activa']} data-texto>
          {i === 0 ? (
            <h1 class="hero-titulo">{s.titulo}</h1>
          ) : (
            <p class="hero-titulo">{s.titulo}</p>
          )}
          <p class="lede hero__lede">{s.texto}</p>
        </div>
      ))
    }

    <div class="hero__acciones">
      <a class="btn btn--principal btn--lg" href={telHref()}>
        <Icono nombre="telefono" tamano={18} />
        {txt.acciones.llamarA(empresa.telefono.display)}
      </a>
      <a class="btn btn--azul btn--lg" href={waHref(lang)} rel="noopener noreferrer">
        <Icono nombre="whatsapp" tamano={18} />
        {txt.acciones.escribirWhatsapp}
      </a>
    </div>

    <div class="hero__prueba">
      <Valoracion lang={lang} variante="oscuro" />
    </div>
  </div>

  <div class="hero__mandos">
    <div class="container hero__mandos-fila">
      <button
        type="button"
        class="hero__flecha hero__flecha--anterior"
        data-anterior
        aria-label={txt.acciones.anterior}
      >
        <Icono nombre="flecha" tamano={20} />
      </button>

      <ul class="hero__puntos" data-puntos>
        {
          slides.map((_, i) => (
            <li>
              <button
                type="button"
                class:list={['hero__punto', i === 0 && 'is-activa']}
                data-punto={i}
                aria-label={txt.hero.irA(i + 1)}
                aria-current={i === 0 ? 'true' : undefined}
              >
                <span class="hero__punto-barra"></span>
              </button>
            </li>
          ))
        }
      </ul>

      <button type="button" class="hero__flecha" data-siguiente aria-label={txt.acciones.siguiente}>
        <Icono nombre="flecha" tamano={20} />
      </button>
    </div>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');

  if (hero) {
    const slides = [...hero.querySelectorAll<HTMLElement>('[data-slide]')];
    const textos = [...hero.querySelectorAll<HTMLElement>('[data-texto]')];
    const puntos = [...hero.querySelectorAll<HTMLButtonElement>('[data-punto]')];
    const total = slides.length;

    // La primera diapositiva lleva el titular de marca: se queda más tiempo
    // en pantalla que las demás, que van más ligeras. El resto reutiliza la
    // última duración de la lista si en algún idioma hubiera más diapositivas.
    const DURACIONES = [6000, 4200, 4200, 4200];
    const duracionDe = (i: number) => DURACIONES[i] ?? DURACIONES[DURACIONES.length - 1];

    let actual = 0;
    let reloj: ReturnType<typeof setTimeout> | undefined;

    const quieto = matchMedia('(prefers-reduced-motion: reduce)');

    const ir = (destino: number) => {
      actual = (destino + total) % total;

      slides.forEach((s, i) => {
        const activa = i === actual;
        s.classList.toggle('is-activa', activa);
        // El zoom lento de la foto dura lo mismo que la diapositiva: así
        // termina justo cuando toca cambiar, en vez de cortarse a mitad.
        s.style.setProperty('--duracion-foto', `${duracionDe(i) + 600}ms`);
        // El contenido de las diapositivas ocultas sale del árbol de
        // accesibilidad: si no, el lector de pantalla lee las tres seguidas.
        if (activa) s.removeAttribute('aria-hidden');
        else s.setAttribute('aria-hidden', 'true');
      });

      textos.forEach((el, i) => el.classList.toggle('is-activa', i === actual));

      puntos.forEach((p, i) => {
        p.classList.toggle('is-activa', i === actual);
        if (i === actual) p.setAttribute('aria-current', 'true');
        else p.removeAttribute('aria-current');
        // La barra de progreso del punto activo corre a la misma duración
        // que el temporizador real, así que cuando se llena es justo cuando
        // toca cambiar de diapositiva, ni antes ni después.
        p.style.setProperty('--duracion', `${duracionDe(i)}ms`);
      });
    };

    // setTimeout en cadena en vez de setInterval: cada diapositiva puede
    // durar un tiempo distinto, y un intervalo fijo no lo permite.
    const arrancar = () => {
      if (quieto.matches) return;
      clearTimeout(reloj);
      reloj = setTimeout(() => {
        ir(actual + 1);
        arrancar();
      }, duracionDe(actual));
      hero.classList.add('is-auto');
    };

    const parar = () => {
      clearTimeout(reloj);
      reloj = undefined;
      hero.classList.remove('is-auto');
    };

    // Un salto manual reinicia la cuenta: si no, la diapositiva elegida se
    // cambiaría sola a los pocos milisegundos.
    const saltar = (destino: number) => {
      ir(destino);
      if (reloj) arrancar();
    };

    hero.querySelector('[data-anterior]')?.addEventListener('click', () => saltar(actual - 1));
    hero.querySelector('[data-siguiente]')?.addEventListener('click', () => saltar(actual + 1));
    puntos.forEach((p, i) => p.addEventListener('click', () => saltar(i)));

    hero.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') saltar(actual - 1);
      else if (e.key === 'ArrowRight') saltar(actual + 1);
    });

    // Se para mientras se mira o se navega con el tabulador, y también cuando
    // la pestaña deja de estar visible.
    hero.addEventListener('pointerenter', parar);
    hero.addEventListener('pointerleave', arrancar);
    hero.addEventListener('focusin', parar);
    hero.addEventListener('focusout', (e) => {
      if (!hero.contains(e.relatedTarget as Node)) arrancar();
    });

    document.addEventListener('visibilitychange', () =>
      document.hidden ? parar() : arrancar()
    );

    quieto.addEventListener('change', () => (quieto.matches ? parar() : arrancar()));

    arrancar();
  }
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: var(--hero-h);
    background: var(--noche);
    isolation: isolate;
    overflow: hidden;
  }

  /* ---------- Fotos ---------- */

  .hero__pila {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    /* Un punto de escala de más: al entrar la foto se asienta en vez de
       aparecer de golpe. Es el único movimiento de la propia imagen. */
    transform: scale(1.055);
    transition: opacity 900ms ease, transform var(--duracion-foto, 6.6s) linear;
  }

  .hero__slide.is-activa {
    opacity: 1;
    transform: scale(1);
  }

  .hero__foto {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* La primera foto es vertical y su mitad superior es cielo vacío: encuadrada
     al centro se vería un degradado azul y poco más. */
  .hero__foto--alto {
    object-position: 50% 46%;
  }

  .hero__foto--centro {
    object-position: 50% 50%;
  }

  .hero__velo {
    position: absolute;
    inset: 0;
    background-image: var(--grano), var(--velo-hero);
    background-size: 180px 180px, cover;
    background-repeat: repeat, no-repeat;
  }

  /* ---------- Texto ---------- */

  .hero__contenido {
    position: relative;
    z-index: 1;
    display: grid;
    /* Pista declarada, no implícita: una columna `auto` se dimensionaría al
       max-content de la entradilla y desbordaría el ancho en móvil. */
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    text-align: center;
    padding-block: calc(var(--s-8) + 1.5rem) calc(var(--s-9) + 1.5rem);
  }

  /* Las tres piezas de texto ocupan la misma celda: así el bloque no cambia de
     alto al pasar de una diapositiva a otra y los botones no dan saltos. */
  .hero__texto {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    gap: var(--s-4);
    width: 100%;
    max-width: 46rem;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 620ms ease, transform 620ms ease;
    pointer-events: none;
  }

  .hero__texto.is-activa {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .hero-titulo {
    max-width: 19ch;
    /* La sombra hace el trabajo que en otras webs hace subir la opacidad del
       velo: el titular se lee sobre cualquier zona clara de la foto y la foto
       sigue viéndose. */
    text-shadow: 0 2px 28px rgba(4, 18, 27, 0.66);
  }

  .hero__lede {
    color: rgba(255, 255, 255, 0.86);
    max-width: 52ch;
  }

  .hero__acciones {
    grid-area: 2 / 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }

  .hero__prueba {
    grid-area: 3 / 1;
    margin-top: var(--s-5);
  }

  /* ---------- Mandos ---------- */

  .hero__mandos {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--s-5);
    z-index: 2;
  }

  .hero__lede {
    text-shadow: 0 1px 12px rgba(4, 18, 27, 0.6);
  }

  .hero__mandos-fila {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-4);
  }

  .hero__flecha {
    display: none;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: var(--r-pill);
    color: var(--on-oscuro);
    cursor: pointer;
    transition: background var(--t-rapido), border-color var(--t-rapido);
  }

  .hero__flecha:hover {
    background: var(--amarillo);
    border-color: var(--amarillo);
    color: var(--ink);
  }

  /* Astro no propaga el ámbito de este <style> al <svg> que renderiza
     Icono.astro: es un componente aparte, así que una clase con nombre plano
     como ".gira" nunca llegaría a aplicarse ahí. Por eso el selector baja con
     :global() desde el botón, que sí vive en este archivo. */
  .hero__flecha--anterior :global(svg) {
    transform: rotate(180deg);
  }

  .hero__puntos {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }

  /* Cada punto es una pista; la activa se rellena al ritmo del cambio
     automático, así se ve cuánto queda para la siguiente.
     Todas miden lo mismo a propósito: ensanchar la activa obligaría a animar
     el ancho, que reordena la fila en cada fotograma. Quien marca cuál está
     activa es la barra amarilla, que se mueve con transform y no toca el
     reparto de la caja. */
  .hero__punto {
    display: block;
    width: 2.75rem;
    height: 4px;
    padding: 0;
    border: 0;
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.3);
    cursor: pointer;
    overflow: hidden;
    transition: background var(--t-medio);
  }

  .hero__punto:hover {
    background: rgba(255, 255, 255, 0.55);
  }

  .hero__punto-barra {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--amarillo);
    transform-origin: left;
    transform: scaleX(0);
  }

  .hero__punto.is-activa .hero__punto-barra {
    transform: scaleX(1);
  }

  /* La barra solo corre cuando el pase automático está en marcha. Al parar
     sobre la portada se queda quieta, que es la señal de que está en pausa. */
  .is-auto .hero__punto.is-activa .hero__punto-barra {
    animation: llenar var(--duracion, 6s) linear forwards;
  }

  @keyframes llenar {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  /* El foco se coloca sobre el punto, que es diminuto: sin este ensanche la
     marca de foco quedaría pegada al borde y casi no se vería. */
  .hero__punto:focus-visible {
    outline-offset: 6px;
  }

  @media (min-width: 48rem) {
    .hero__flecha {
      display: grid;
    }
  }

  /* A partir de tableta la tira de ventajas se monta sobre la portada, así que
     los mandos suben para no quedar debajo de ella. */
  @media (min-width: 62rem) {
    .hero__mandos {
      bottom: 6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__slide,
    .hero__texto {
      transition: none;
    }

    .hero__slide {
      transform: none;
    }

    .hero__punto-barra {
      animation: none !important;
    }
  }
</style>
