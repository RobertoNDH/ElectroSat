---
// Barra fija de llamada, solo en móvil.
import Icono from './Icono.astro';
import { empresa, telHref, waHref } from '../data/empresa';
---

<div class="barra">
  <a class="barra__accion barra__accion--llamar" href={telHref()}>
    <Icono nombre="telefono" tamano={18} />
    Llamar ahora
  </a>
  <a
    class="barra__accion barra__accion--wa"
    href={waHref()}
    rel="noopener noreferrer"
    aria-label={`Escribir por WhatsApp al ${empresa.movil.display}`}
  >
    <Icono nombre="whatsapp" tamano={18} />
    WhatsApp
  </a>
</div>

<style>
  .barra {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 30;
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--paper);
    border-top: var(--hairline);
    box-shadow: 0 -4px 16px rgba(20, 32, 46, 0.1);
    padding-bottom: env(safe-area-inset-bottom);
  }

  .barra__accion {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: var(--barra-h);
    font-size: var(--fs-small);
    font-weight: 700;
    text-decoration: none;
  }

  .barra__accion--llamar {
    background: var(--naranja);
    color: var(--ink);
  }

  .barra__accion--wa {
    background: var(--azul);
    color: var(--on-oscuro);
  }

  @media (min-width: 62rem) {
    .barra {
      display: none;
    }
  }
</style>
