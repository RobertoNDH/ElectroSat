---
// Barra fija de llamada, solo en móvil.
import Icono from './Icono.astro';
import { telHref, waHref, correoHref } from '../data/empresa';
import type { Idioma } from '../i18n/config';
import { t } from '../i18n/textos';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const txt = t(lang);
---

<div class="barra">
  <a
    class="barra__accion barra__accion--wa"
    href={waHref(lang)}
    rel="noopener noreferrer"
    aria-label={txt.acciones.escribirWhatsapp}
  >
    <Icono nombre="whatsapp" tamano={18} />
    {txt.acciones.whatsapp}
  </a>
  <a class="barra__accion barra__accion--llamar" href={telHref()}>
    <Icono nombre="telefono" tamano={18} />
    {txt.acciones.llamarAhora}
  </a>
  <a
    class="barra__accion barra__accion--mail"
    href={correoHref(lang)}
    aria-label={txt.acciones.escribirCorreo}
  >
    <Icono nombre="email" tamano={19} />
  </a>
</div>

<style>
  .barra {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 30;
    display: grid;
    grid-template-columns: 1fr 1fr 4rem;
    background: var(--noche);
    border-top: 1px solid var(--oro-oscuro);
    padding-bottom: env(safe-area-inset-bottom);
  }

  .barra__accion {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: var(--barra-h);
    font-size: var(--fs-small);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: background-color var(--t-rapido), color var(--t-rapido);
  }

  .barra__accion--llamar {
    background: var(--azul-brillo);
    color: var(--paper);
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    border-left: 1px solid rgba(255, 255, 255, 0.08);
  }

  .barra__accion--wa {
    background: var(--oro);
    color: var(--ink);
  }

  .barra__accion--mail {
    background: var(--noche-2);
    color: var(--oro);
    border-left: 1px solid rgba(255, 255, 255, 0.08);
  }

  @media (min-width: 62rem) {
    .barra {
      display: none;
    }
  }
</style>
