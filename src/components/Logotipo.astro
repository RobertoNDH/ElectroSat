---
// Logotipo original de la empresa, con el fondo blanco recortado.
// LÍMITE CONOCIDO: el archivo de partida que dio el cliente es un JPEG de unos
// 179x48 px, así que la nitidez tiene techo por más que se procese. Se sirve
// pequeño y a doble densidad, que es donde mejor aguanta.
// Para verlo nítido a cualquier tamaño hace falta el original vectorial
// (SVG, AI, EPS o PDF) de quien diseñó la marca.
import { Image } from 'astro:assets';
import logo from '../assets/logo-electrosat.png';

interface Props {
  class?: string;
  /** El tamaño va por clase: la CSP no admite atributos style. */
  tamano?: 'md' | 'sm';
}
const { class: clase, tamano = 'md' } = Astro.props;
---

<Image
  class:list={['logo', `logo--${tamano}`, clase]}
  src={logo}
  alt="ElectroSat TV"
  widths={[128, 256, 360]}
  sizes="128px"
  format="png"
  loading="eager"
/>

<style>
  .logo {
    display: block;
    width: auto;
  }

  /* A 21px de alto el ancho sale sobre 128px: con densidad doble se piden 256px
     y el archivo tiene 360px, así que reduce en vez de ampliar y no se empasta. */
  .logo--md {
    height: 1.3125rem;
  }

  .logo--sm {
    height: 1.1875rem;
  }
</style>
