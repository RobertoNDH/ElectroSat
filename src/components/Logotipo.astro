---
// Logotipo original de la empresa, con el fondo blanco recortado.
// El archivo de partida es un JPEG de 179x48 px, así que la nitidez está
// limitada por el original.
// TODO: pedir al cliente el vectorial (SVG, AI o EPS) para sustituirlo.
import { Image } from 'astro:assets';
import logo from '../assets/logo-electrosat.png';

interface Props {
  class?: string;
  /** El tamaño va por clase: la CSP no admite atributos style. */
  tamano?: 'md' | 'sm';
}
const { class: clase, tamano = 'md' } = Astro.props;
---

<Image
  class:list={['logo', `logo--${tamano}`, clase]}
  src={logo}
  alt="ElectroSat TV"
  widths={[200, 400]}
  sizes="11rem"
  loading="eager"
/>

<style>
  .logo {
    display: block;
    width: auto;
  }

  /* El archivo de origen es muy pequeño: por encima de estos tamaños se ve
     pastoso. Cuando llegue el vectorial se podrá subir. */
  .logo--md {
    height: 1.75rem;
  }

  .logo--sm {
    height: 1.5rem;
  }
</style>
