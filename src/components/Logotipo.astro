---
// Logotipo tipográfico. Recoge la estructura del logo real: ELECTRO en oscuro,
// SAT en azul y los arcos de señal en naranja.
// TODO: sustituir por el archivo del logo cuando el cliente lo facilite.
interface Props {
  class?: string;
  invertido?: boolean;
}
const { class: clase, invertido = false } = Astro.props;
---

<span class:list={['logo', invertido && 'logo--inv', clase]}>
  <svg class="logo__arcos" viewBox="0 0 18 16" aria-hidden="true" focusable="false">
    <path d="M3 8.6A5 5 0 0 1 8 13.6" />
    <path d="M3 4.4A9.2 9.2 0 0 1 12.2 13.6" />
    <path d="M3 0.2A13.4 13.4 0 0 1 16.4 13.6" />
    <circle cx="3" cy="13.6" r="1.5" />
  </svg>
  <span class="logo__texto">
    Electro<span class="logo__sat">Sat</span>
  </span>
  <span class="logo__tv">TV</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    width: fit-content;
    line-height: 1;
    white-space: nowrap;
  }

  .logo__arcos {
    align-self: center;
    width: 1.25rem;
    height: 1.1rem;
    fill: none;
    stroke: var(--naranja);
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .logo__arcos circle {
    fill: var(--naranja);
    stroke: none;
  }

  .logo__texto {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .logo__sat {
    color: var(--azul);
  }

  .logo__tv {
    font-family: var(--font-base);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    padding: 0.15rem 0.3rem;
    border-radius: 3px;
    background: var(--surface-2);
    color: var(--ink-3);
  }

  .logo--inv .logo__texto,
  .logo--inv .logo__sat {
    color: var(--on-oscuro);
  }

  .logo--inv .logo__tv {
    background: rgba(255, 255, 255, 0.18);
    color: var(--on-oscuro);
  }
</style>
