---
// Logotipo real de la marca, en pequeño: a tamaño grande se ve pixelado
// porque el archivo de origen no tiene mucha resolución.
import { Image } from 'astro:assets';
import logo from '../assets/logo-electrosat-transparente.png';

interface Props {
  class?: string;
  tamano?: 'sm' | 'md';
}
const { class: clase, tamano = 'md' } = Astro.props;
---

<Image
  src={logo}
  alt="ElectroSat TV"
  width={360}
  height={59}
  class:list={['logo', tamano === 'sm' && 'logo--sm', clase]}
/>

<style>
  .logo {
    display: block;
    width: auto;
    height: 1.5rem;
  }

  .logo--sm {
    height: 1.125rem;
  }
</style>
