---
// Portada a sangre: foto de ancho completo, velo claro y titular centrado
// encima. La usan la home y todas las páginas interiores, así que el gesto de
// entrada es el mismo en todo el sitio y solo cambian la foto y la altura.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  titulo: string;
  texto?: string;
  foto: ImageMetadata;
  alt: string;
  /** `alta` es la home; `media` las interiores. */
  alto?: 'alta' | 'media';
  /** Zona de la foto que se conserva al recortar. Va por clase porque la
      política de seguridad no permite atributos style. */
  encuadre?: 'alto' | 'centro' | 'bajo';
  /** La home es la única con <h1> de nivel de marca y carga prioritaria. */
  principal?: boolean;
}

const {
  titulo,
  texto,
  foto,
  alt,
  alto = 'media',
  encuadre = 'centro',
  principal = false,
} = Astro.props;

const anchos = alto === 'alta' ? [900, 1400, 2000, 2600, 3200] : [900, 1400, 2000, 2600];
---

<section class:list={['portada', `portada--${alto}`, `enc-${encuadre}`]}>
  <div class="portada__fondo parallax">
    <Image
      src={foto}
      alt={alt}
      widths={anchos}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      quality={72}
    />
  </div>

  {
    principal && (
      <svg class="portada__senal" viewBox="0 0 240 240" aria-hidden="true" focusable="false">
        <circle cx="120" cy="26" r="24" />
        <circle cx="120" cy="26" r="62" />
        <circle cx="120" cy="26" r="102" />
      </svg>
    )
  }

  <div class="container portada__contenido">
    <h1 class:list={[principal ? 'display-xl' : 'display-l']}>{titulo}</h1>
    {texto && <p class="lede portada__lede">{texto}</p>}
    <slot />
  </div>
</section>

<style>
  .portada {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding-block: clamp(3rem, 7vw, 5.5rem);
    border-bottom: var(--hairline);
  }

  .portada--alta {
    min-height: min(37rem, 78svh);
    align-items: flex-end;
  }

  .portada--media {
    min-height: min(19rem, 46svh);
    padding-block: clamp(2rem, 5vw, 3.25rem);
  }

  .portada__fondo {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
  }

  .portada__fondo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Sube el motivo de la foto casi al borde superior: en la home la antena
     tiene que quedar por encima del titular, no detrás de las letras. */
  .enc-alto .portada__fondo :global(img) {
    object-position: 50% 92%;
  }

  .enc-centro .portada__fondo :global(img) {
    object-position: 50% 50%;
  }

  .enc-bajo .portada__fondo :global(img) {
    object-position: 50% 68%;
  }

  /* Velo claro: un foco blanco detrás del texto y un lavado vertical suave.
     Deja ver el cielo alrededor en lugar de tapar la foto entera: es ese azul
     el que le da el aire a la portada, y encima combina con el azul del logo. */
  .portada::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        76% 58% at 50% 56%,
        rgba(255, 255, 255, 0.96) 0%,
        rgba(255, 255, 255, 0.88) 52%,
        rgba(255, 255, 255, 0) 100%
      ),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.34), rgba(255, 255, 255, 0.7));
  }

  /* En la home el texto vive abajo, así que el velo se concentra ahí y el
     tercio superior queda despejado para que se vea la antena contra el cielo. */
  .portada--alta::before {
    background:
      radial-gradient(
        80% 60% at 50% 68%,
        rgba(255, 255, 255, 0.99) 0%,
        rgba(255, 255, 255, 0.97) 55%,
        rgba(255, 255, 255, 0) 100%
      ),
      linear-gradient(
        to bottom,
        rgba(255, 255, 255, 0) 0%,
        rgba(255, 255, 255, 0.2) 26%,
        rgba(255, 255, 255, 0.78) 56%,
        rgba(255, 255, 255, 0.94) 84%
      );
  }

  /* En vertical una foto apaisada no cabe detrás del texto: o se tapaba entera
     con velo y solo se veía cielo, o el titular caía sobre el azul y no se
     leía. Así que en móvil no se superponen: la foto va arriba, a su altura, y
     el texto debajo sobre blanco, con un degradado que une las dos. */
  @media (max-width: 54.99rem) {
    .portada--alta {
      display: block;
      min-height: 0;
      padding-block: 0 clamp(1rem, 3.5vw, 1.5rem);
      background: var(--paper);
    }

    .portada--alta .portada__fondo {
      position: relative;
      z-index: 0;
      height: 21svh;
      min-height: 7.5rem;
    }

    .portada--alta::before {
      top: 0;
      bottom: auto;
      z-index: 1;
      height: 21svh;
      min-height: 7.5rem;
      /* El blanco tiene que ser sólido antes de que empiece el titular: si el
         degradado sigue abierto ahí, los mástiles de la foto asoman a los
         lados del título y se leen como rayas negras. */
      background: linear-gradient(
        to bottom,
        rgba(255, 255, 255, 0) 34%,
        rgba(255, 255, 255, 0.72) 66%,
        var(--paper) 88%
      );
    }

    .portada--alta .portada__contenido {
      position: relative;
      z-index: 2;
      margin-top: calc(var(--s-3) * -1);
    }

    /* En la franja de móvil la foto se baja: con el encuadre de escritorio
       asomaba el tejado por debajo del velo y las antenas se cortaban por
       arriba. Así el blanco tapa la cubierta y quedan las antenas contra el
       cielo, que es lo que tiene que verse. */
    .portada--alta.enc-alto .portada__fondo :global(img) {
      object-position: 50% 62%;
    }
  }

  /* Móviles de pantalla corta (p.ej. iPhone SE): con la altura normal el
     bloque de ventajas empuja los botones y la valoración fuera de la
     primera pantalla. Se oculta esa lista, que ya se repite más abajo en
     "Por qué fiarte", y se recorta aún más la franja de foto. */
  @media (max-width: 54.99rem) and (max-height: 45rem) {
    .portada--alta .portada__fondo,
    .portada--alta::before {
      height: 15svh;
      min-height: 6rem;
    }

    .portada--alta :global(.ventajas) {
      display: none;
    }
  }

  /* Marca de la portada principal: los mismos anillos de señal del diagrama
     de internet comunitario, centrados detrás del titular como agua marcada.
     Solo en escritorio: en móvil el hueco es demasiado justo. */
  .portada__senal {
    display: none;
  }

  @media (min-width: 55rem) {
    .portada--alta .portada__senal {
      display: block;
      position: absolute;
      top: 50%;
      left: 50%;
      z-index: -1;
      width: min(40rem, 60vw);
      height: auto;
      transform: translate(-50%, -60%);
      opacity: 0.3;
      pointer-events: none;
    }
  }

  .portada__senal circle {
    fill: none;
    stroke: var(--azul-vivo);
    stroke-width: 1.1;
  }

  .portada__contenido {
    display: grid;
    justify-items: center;
    justify-content: center;
    gap: var(--s-4);
    text-align: center;
  }

  /* Ningún hijo puede crecer más que la columna y empujar el ancho. */
  .portada__contenido > * {
    min-width: 0;
    max-width: 100%;
  }

  .portada__contenido h1 {
    max-width: 18ch;
  }

  .portada--media .portada__contenido h1 {
    max-width: 22ch;
  }

  .portada__lede {
    max-width: 46ch;
  }

  @media (prefers-reduced-motion: no-preference) {
    .portada__contenido > * {
      animation: subir 640ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
    }

    .portada__contenido > *:nth-child(2) {
      animation-delay: 70ms;
    }

    .portada__contenido > *:nth-child(3) {
      animation-delay: 140ms;
    }

    .portada__contenido > *:nth-child(4) {
      animation-delay: 210ms;
    }

    @keyframes subir {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
    }
  }
</style>
