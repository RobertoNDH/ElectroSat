---
// Cierre de página. Se repite al final de la home, de cada servicio y de
// nosotros porque el visitante decide llamar en momentos distintos.
// Banda oscura con foto: es el único momento en que el teléfono manda sobre
// todo lo demás, así que no compite con ninguna columna al lado.
import { Image } from 'astro:assets';
import Icono from './Icono.astro';
import EstadoHorario from './EstadoHorario.astro';
import foto from '../assets/equipo.jpg';
import {
  empresa,
  telHref,
  waHref,
  correoHref,
  direccionUnaLinea,
} from '../data/empresa';
import type { Idioma } from '../i18n/config';
import { t } from '../i18n/textos';

interface Props {
  lang: Idioma;
  titulo?: string;
  texto?: string;
}

const { lang, titulo, texto } = Astro.props;
const txt = t(lang);
---

<section class="cta" aria-labelledby="cta-titulo">
  <div class="cta__fondo">
    <Image
      src={foto}
      alt=""
      widths={[900, 1400, 2000, 2400]}
      sizes="100vw"
      loading="lazy"
    />
  </div>

  <div class="container cta__contenido">
    <h2 class="h2" id="cta-titulo">{titulo ?? txt.contacto.titulo}</h2>
    <p class="lede cta__lede">{texto ?? txt.contacto.texto}</p>

    <a class="cta__numero" href={telHref()}>
      <Icono nombre="telefono" tamano={26} />
      <span class="tel-num">{empresa.telefono.display}</span>
    </a>

    <div class="cta__acciones">
      <a class="btn btn--principal btn--lg" href={telHref()}>
        <Icono nombre="telefono" tamano={18} />
        {txt.acciones.llamarAhora}
      </a>
      <a class="btn btn--azul btn--lg" href={waHref(lang)} rel="noopener noreferrer">
        <Icono nombre="whatsapp" tamano={18} />
        {txt.acciones.whatsapp}
      </a>
      <a class="btn btn--claro btn--lg" href={correoHref(lang)}>
        <Icono nombre="email" tamano={18} />
        {txt.acciones.escribirCorreo}
      </a>
    </div>

    <ul class="cta__datos">
      <li><EstadoHorario lang={lang} /></li>
      <li>
        <Icono nombre="mapa" tamano={16} />
        <span>{direccionUnaLinea}</span>
      </li>
    </ul>
  </div>
</section>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    padding-block: clamp(3.25rem, 6vw, 5rem);
    overflow: hidden;
  }

  .cta__fondo {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: var(--ink);
  }

  .cta__fondo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
  }

  .cta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to bottom,
      rgba(9, 20, 28, 0.93) 0%,
      rgba(9, 20, 28, 0.87) 50%,
      rgba(9, 20, 28, 0.94) 100%
    );
  }

  .cta__contenido {
    display: grid;
    justify-items: center;
    gap: var(--s-3);
    text-align: center;
  }

  .cta__contenido .h2 {
    color: var(--on-oscuro);
    max-width: 20ch;
  }

  .cta__lede {
    max-width: 52ch;
    color: rgba(255, 255, 255, 0.78);
  }

  .cta__numero {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: var(--s-3);
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--on-oscuro);
    text-decoration: none;
    transition: color var(--t-rapido);
  }

  .cta__numero :global(svg) {
    color: var(--amarillo);
    flex: none;
  }

  .cta__numero:hover {
    color: var(--amarillo);
  }

  .cta__acciones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-3);
    margin-top: var(--s-3);
  }

  .cta__datos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--s-3) var(--s-5);
    margin-top: var(--s-4);
    padding-top: var(--s-4);
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    width: min(100%, 44rem);
  }

  .cta__datos li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-small);
    color: rgba(255, 255, 255, 0.78);
  }

  .cta__datos :global(svg) {
    color: var(--amarillo);
    flex: none;
  }
</style>
