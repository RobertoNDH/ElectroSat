---
// Cierre de página. Se repite al final de la home, de cada servicio y de
// nosotros porque el visitante decide llamar en momentos distintos.
import { Image } from 'astro:assets';
import Icono from './Icono.astro';
import EstadoHorario from './EstadoHorario.astro';
import foto from '../assets/equipo.jpg';
import { empresa, telHref, waHref, emailHref, direccionUnaLinea } from '../data/empresa';

interface Props {
  titulo?: string;
  texto?: string;
}

const {
  titulo = 'Cuéntanos qué necesitas',
  texto = 'Te atendemos por teléfono y, si hace falta, pasamos a verlo. La visita para valorar el trabajo es gratuita y sin compromiso en toda la isla.',
} = Astro.props;
---

<section class="cta" aria-labelledby="cta-titulo">
  <div class="container cta__rejilla">
    <div class="cta__texto">
      <p class="eyebrow">Contacto directo</p>
      <h2 class="h2" id="cta-titulo">{titulo}</h2>
      <p class="lede">{texto}</p>

      <a class="cta__numero" href={telHref()}>
        <span class="cta__numero-icono"><Icono nombre="telefono" tamano={22} /></span>
        <span class="tel-num">{empresa.telefono.display}</span>
      </a>

      <div class="cta__acciones">
        <a class="btn btn--principal btn--lg" href={telHref()}>
          <Icono nombre="telefono" tamano={18} />
          Llamar ahora
        </a>
        <a class="btn btn--linea btn--lg" href={waHref()} rel="noopener noreferrer">
          <Icono nombre="whatsapp" tamano={18} />
          Escribir por WhatsApp
        </a>
      </div>

      <ul class="cta__datos">
        <li><EstadoHorario /></li>
        <li>
          <Icono nombre="email" tamano={16} />
          <a href={emailHref}>{empresa.email}</a>
        </li>
        <li>
          <Icono nombre="mapa" tamano={16} />
          <span>{direccionUnaLinea}</span>
        </li>
      </ul>
    </div>

    <figure class="cta__foto">
      <Image
        src={foto}
        alt="Técnico de ElectroSat TV trabajando en una instalación de cubierta"
        widths={[480, 720, 960]}
        sizes="(min-width: 62rem) 34rem, 100vw"
        loading="lazy"
      />
    </figure>
  </div>
</section>

<style>
  .cta {
    padding-block: var(--section-y);
    background: var(--surface);
    border-top: var(--hairline);
  }

  .cta__rejilla {
    display: grid;
    gap: var(--s-6);
    align-items: center;
  }

  @media (min-width: 62rem) {
    .cta__rejilla {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: var(--s-8);
    }
  }

  .cta__texto {
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }

  .cta__numero {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    justify-self: start;
    margin-top: var(--s-2);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4.5vw, 3rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.01em;
    color: var(--ink);
    text-decoration: none;
  }

  .cta__numero-icono {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--naranja);
    color: var(--ink);
    flex: none;
  }

  .cta__numero:hover {
    color: var(--azul);
  }

  .cta__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }

  .cta__datos {
    display: grid;
    gap: 0.625rem;
    margin-top: var(--s-3);
    padding-top: var(--s-4);
    border-top: var(--hairline);
  }

  .cta__datos li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-small);
    color: var(--ink-2);
  }

  .cta__datos svg {
    color: var(--azul);
    flex: none;
  }

  .cta__foto {
    margin: 0;
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--sombra);
  }

  .cta__foto :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
</style>
