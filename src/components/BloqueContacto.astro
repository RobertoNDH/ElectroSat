---
// Cierre de página. Se repite al final de la home, de cada servicio y de
// nosotros porque el visitante decide llamar en momentos distintos.
import { Image } from 'astro:assets';
import Icono from './Icono.astro';
import EstadoHorario from './EstadoHorario.astro';
import foto from '../assets/equipo.jpg';
import {
  empresa,
  telHref,
  waHref,
  correoHref,
  direccionUnaLinea,
} from '../data/empresa';
import type { Idioma } from '../i18n/config';
import { t } from '../i18n/textos';

interface Props {
  lang: Idioma;
  titulo?: string;
  texto?: string;
}

const { lang, titulo, texto } = Astro.props;
const txt = t(lang);
---

<section class="cta" aria-labelledby="cta-titulo">
  <div class="container cta__rejilla">
    <div class="cta__texto">
      <h2 class="h2" id="cta-titulo">{titulo ?? txt.contacto.titulo}</h2>
      <p class="lede">{texto ?? txt.contacto.texto}</p>

      <a class="cta__numero" href={telHref()}>
        <span class="cta__numero-icono"><Icono nombre="telefono" tamano={22} /></span>
        <span class="tel-num">{empresa.telefono.display}</span>
      </a>

      <div class="cta__acciones">
        <a class="btn btn--principal btn--lg" href={telHref()}>
          <Icono nombre="telefono" tamano={18} />
          {txt.acciones.llamarAhora}
        </a>
        <a class="btn btn--azul btn--lg" href={waHref(lang)} rel="noopener noreferrer">
          <Icono nombre="whatsapp" tamano={18} />
          {txt.acciones.whatsapp}
        </a>
        <a class="btn btn--linea btn--lg" href={correoHref(lang)}>
          <Icono nombre="email" tamano={18} />
          {txt.acciones.escribirCorreo}
        </a>
      </div>

      <ul class="cta__datos">
        <li><EstadoHorario lang={lang} /></li>
        <li>
          <Icono nombre="mapa" tamano={16} />
          <span>{direccionUnaLinea}</span>
        </li>
      </ul>
    </div>

    <figure class="cta__foto">
      <Image
        src={foto}
        alt="Técnico de ElectroSat TV trabajando en una instalación"
        widths={[420, 640, 880]}
        sizes="(min-width: 62rem) 28rem, 100vw"
        loading="lazy"
      />
    </figure>
  </div>
</section>

<style>
  .cta {
    padding-block: var(--section-y);
    background: var(--surface);
    border-top: var(--hairline);
  }

  .cta__rejilla {
    display: grid;
    gap: var(--s-6);
    align-items: center;
  }

  @media (min-width: 62rem) {
    .cta__rejilla {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      gap: var(--s-8);
    }
  }

  .cta__texto {
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }

  .cta__numero {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    justify-self: start;
    margin-top: var(--s-2);
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    line-height: 1;
    color: var(--ink);
    text-decoration: none;
  }

  .cta__numero-icono {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--azul);
    color: var(--on-oscuro);
    flex: none;
  }

  .cta__numero:hover {
    color: var(--azul);
  }

  .cta__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }

  .cta__datos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-5);
    margin-top: var(--s-3);
    padding-top: var(--s-4);
    border-top: var(--hairline);
  }

  .cta__datos li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-small);
    color: var(--ink-2);
  }

  .cta__datos svg {
    color: var(--azul);
    flex: none;
  }

  .cta__foto {
    margin: 0;
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--sombra);
  }

  .cta__foto :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
</style>
