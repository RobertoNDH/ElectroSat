---
import { getCollection } from 'astro:content';
import Logotipo from './Logotipo.astro';
import Icono from './Icono.astro';
import MenuMovil from './MenuMovil.astro';
import SelectorIdioma from './SelectorIdioma.astro';
import { empresa, telHref, waHref, emailHref } from '../data/empresa';
import { ruta, type Idioma } from '../i18n/config';
import { t } from '../i18n/textos';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const txt = t(lang);

const servicios = (await getCollection('servicios'))
  .filter((s) => s.id.startsWith(`${lang}/`))
  .sort((a, b) => a.data.orden - b.data.orden)
  .map((s) => ({ slug: s.id.split('/')[1], corto: s.data.corto }));

const camino = Astro.url.pathname;
const activo = (href: string) =>
  href === ruta(lang, '/') ? camino === href : camino.startsWith(href);

const enlaces = [
  { href: ruta(lang, '/servicios/'), texto: txt.nav.servicios },
  { href: ruta(lang, '/nosotros/'), texto: txt.nav.nosotros },
  { href: ruta(lang, '/contacto/'), texto: txt.nav.contacto },
];
---

<div class="barra-sup">
  <div class="container barra-sup__fila">
    <div class="barra-sup__izquierda">
      <span class="barra-sup__zona">
        <Icono nombre="mapa" tamano={14} />
        {txt.datos.zona}
      </span>
      <p class="barra-sup__dato">
        <Icono nombre="reloj" tamano={14} />
        {txt.datos.horario}
      </p>
    </div>
    <div class="barra-sup__derecha">
      <a class="barra-sup__enlace" href={telHref()}>
        <Icono nombre="telefono" tamano={14} />
        <span class="tel-num">{empresa.telefono.display}</span>
      </a>
      <a class="barra-sup__enlace" href={emailHref}>
        <Icono nombre="email" tamano={14} />
        {empresa.email}
      </a>
      <SelectorIdioma />
    </div>
  </div>
</div>

<span data-centinela aria-hidden="true"></span>

<header class="cab" data-cabecera>
  <div class="container cab__fila">
    <a href={ruta(lang, '/')} class="cab__inicio" aria-label={`${empresa.nombre}, ${txt.nav.irAlInicio}`}>
      <Logotipo />
    </a>

    <nav class="cab__nav" aria-label={txt.nav.servicios}>
      {
        enlaces.map((e) => (
          <a href={e.href} aria-current={activo(e.href) ? 'page' : undefined}>
            {e.texto}
          </a>
        ))
      }
    </nav>

    <div class="cab__acciones">
      <a class="btn btn--azul cab__tel" href={telHref()}>
        <Icono nombre="telefono" tamano={17} />
        <span class="tel-num">{empresa.telefono.display}</span>
      </a>

      <a class="btn btn--principal cab__cta" href={waHref(lang)} rel="noopener noreferrer">
        <Icono nombre="whatsapp" tamano={17} />
        {txt.acciones.whatsapp}
      </a>
      
      <a class="btn btn--linea cab__cta" href={emailHref}>
        <Icono nombre="email" tamano={17} />
        Email
      </a>

      <a
        class="cab__icono"
        href={telHref()}
        aria-label={txt.acciones.llamarA(empresa.telefono.display)}
      >
        <Icono nombre="telefono" tamano={20} />
      </a>

      <button type="button" class="cab__icono" data-abrir-menu aria-label={txt.nav.abrirMenu}>
        <Icono nombre="menu" tamano={22} />
      </button>
    </div>
  </div>
</header>

<MenuMovil lang={lang} servicios={servicios} />

<script>
  const centinela = document.querySelector('[data-centinela]');
  const cabecera = document.querySelector('[data-cabecera]');

  if (centinela && cabecera) {
    new IntersectionObserver(([e]) =>
      cabecera.classList.toggle('is-fija', !e.isIntersecting)
    ).observe(centinela);
  }
</script>

<style>
  /* Marquesina superior con estilo premium */
  .barra-sup {
    background: var(--noche);
    color: var(--platino);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--noche-linea);
  }

  .barra-sup__fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    min-height: 2.5rem; /* Ajuste para que se vea */
  }

  .barra-sup__izquierda,
  .barra-sup__derecha {
    display: flex;
    align-items: center;
    gap: var(--s-5);
  }

  .barra-sup__dato,
  .barra-sup__zona,
  .barra-sup__enlace {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
  }

  .barra-sup__zona svg,
  .barra-sup__dato svg,
  .barra-sup__enlace svg {
    color: var(--oro);
  }

  .barra-sup__enlace {
    color: inherit;
    text-decoration: none;
    transition: color var(--t-rapido);
  }

  .barra-sup__enlace:hover {
    color: var(--oro-claro);
  }

  @media (max-width: 74.99rem) {
    .barra-sup__dato {
      display: none;
    }
  }

  @media (max-width: 61.99rem) {
    .barra-sup__izquierda,
    .barra-sup__enlace {
      display: none;
    }

    .barra-sup__fila {
      justify-content: center;
      min-height: 2.125rem;
    }
  }

  .cab {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(255, 255, 255, 0.95);
    border-bottom: var(--hairline);
    transition: box-shadow var(--t-rapido), background-color var(--t-rapido);
  }

  .cab.is-fija {
    background: rgba(255, 255, 255, 0.98);
    box-shadow: var(--sombra);
  }

  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .cab {
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(16px) saturate(180%);
      -webkit-backdrop-filter: blur(16px) saturate(180%);
    }
    .cab.is-fija {
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(20px) saturate(200%);
      -webkit-backdrop-filter: blur(20px) saturate(200%);
    }
  }

  .cab__fila {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    min-height: var(--header-h);
  }

  .cab__inicio {
    margin-right: auto;
    text-decoration: none;
  }

  .cab__nav {
    display: flex;
    gap: var(--s-6);
  }

  .cab__nav a {
    position: relative;
    padding-block: 0.375rem;
    font-size: 0.875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    color: var(--ink-2);
    white-space: nowrap;
    transition: color var(--t-rapido);
  }

  .cab__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 0px;
    height: 1px;
    background: var(--oro);
    transition: right var(--t-rapido);
  }

  .cab__nav a:hover {
    color: var(--ink);
  }

  .cab__nav a:hover::after,
  .cab__nav a[aria-current='page']::after {
    right: 0;
  }

  .cab__acciones {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .cab__tel {
    font-size: 0.875rem;
  }

  .cab__icono {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    background: transparent;
    border: 1px solid var(--control);
    border-radius: var(--r-sm);
    color: var(--ink);
    cursor: pointer;
    transition: background var(--t-rapido), border-color var(--t-rapido);
  }
  
  .cab__icono:hover {
    background: var(--surface-2);
    border-color: var(--ink-3);
  }

  @media (max-width: 61.99rem) {
    .cab__nav,
    .cab__tel,
    .cab__cta {
      display: none;
    }

    .cab__icono {
      display: inline-flex;
    }

    .cab__acciones {
      gap: var(--s-2);
    }
  }
</style>
