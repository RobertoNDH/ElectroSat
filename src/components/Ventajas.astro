---
// Tira de argumentos que se monta sobre la portada.
//
// Es la pieza que cose el hero con el resto de la página: sin ella la foto
// termina en un corte seco. Solo se solapa a partir de tableta; en móvil no
// hay sitio y va debajo, como una sección normal.
import Icono from './Icono.astro';
import type { NombreIcono } from './iconos';
import type { Idioma } from '../i18n/config';
import { t } from '../i18n/textos';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const txt = t(lang);

const ICONOS: NombreIcono[] = ['euro', 'documento', 'escudo', 'mapa'];
---

<section class="ventajas" aria-label={txt.confianzaTitulo}>
  <div class="container">
    <ul class="ventajas__lista" data-anima="hijos">
      {
        txt.confianza.map((c, i) => (
          <li class="ventaja">
            <span class="pastilla pastilla--marca ventaja__icono">
              <Icono nombre={ICONOS[i]} tamano={22} />
            </span>
            <span class="ventaja__cuerpo">
              <strong class="ventaja__dato">{c.dato}</strong>
              <span class="ventaja__texto">{c.texto}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .ventajas {
    position: relative;
    z-index: 3;
    /* La sección siguiente ya trae su propio hueco superior: sumar aquí el
       mismo dejaría una franja en blanco enorme entre la tira y su título. */
    padding-bottom: clamp(1rem, 2vw, 1.5rem);
  }

  .ventajas__lista {
    display: grid;
    gap: 1px;
    background: var(--line);
    border: var(--hairline);
    border-radius: var(--r-card);
    overflow: hidden;
    box-shadow: var(--sombra-alta);
  }

  .ventaja {
    display: flex;
    align-items: start;
    gap: var(--s-4);
    padding: var(--s-5);
    background: var(--paper);
    transition: background var(--t-medio);
  }

  .ventaja:hover {
    background: var(--azul-tinte);
  }

  .ventaja__icono {
    width: 2.75rem;
    height: 2.75rem;
  }

  .ventaja__cuerpo {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.1875rem;
  }

  .ventaja__dato {
    font-family: var(--font-display);
    font-stretch: var(--wdth-display);
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .ventaja__texto {
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--ink-3);
  }

  @media (min-width: 34rem) {
    .ventajas__lista {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 62rem) {
    /* El solape solo aquí: en pantallas pequeñas la tira taparía el titular. */
    .ventajas {
      margin-top: -4.5rem;
    }

    .ventajas__lista {
      grid-template-columns: repeat(4, 1fr);
    }

    .ventaja {
      padding: var(--s-6) var(--s-5);
    }
  }
</style>
