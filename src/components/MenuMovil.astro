---
// Menú móvil sobre <dialog>: la trampa de foco, el cierre con Escape y el
// inertizado del resto de la página los aporta el navegador.
import Icono from './Icono.astro';
import Logotipo from './Logotipo.astro';
import SelectorIdioma from './SelectorIdioma.astro';
import { empresa, telHref, waHref, correoHref } from '../data/empresa';
import { ruta, type Idioma } from '../i18n/config';
import { t } from '../i18n/textos';

interface Props {
  lang: Idioma;
  servicios: { slug: string; corto: string }[];
}
const { lang, servicios } = Astro.props;
const txt = t(lang);
---

<dialog class="menu" id="menu-movil" aria-label={txt.nav.servicios}>
  <div class="menu__barra">
    <Logotipo tamano="sm" />
    <button type="button" class="menu__cerrar" data-cerrar-menu aria-label={txt.nav.cerrarMenu}>
      <Icono nombre="cerrar" tamano={22} />
    </button>
  </div>

  <nav class="menu__cuerpo" aria-label={txt.nav.servicios}>
    <p class="etiqueta">{txt.nav.servicios}</p>
    <ul class="menu__lista">
      {
        servicios.map((s) => (
          <li>
            <a href={ruta(lang, `/servicios/${s.slug}/`)}>
              {s.corto}
              <Icono nombre="flecha" tamano={18} />
            </a>
          </li>
        ))
      }
    </ul>

    <hr class="rule" />

    <ul class="menu__lista">
      <li>
        <a href={ruta(lang, '/servicios/')}>
          {txt.nav.todosServicios}<Icono nombre="flecha" tamano={18} />
        </a>
      </li>
      <li>
        <a href={ruta(lang, '/nosotros/')}>
          {txt.nav.nosotros}<Icono nombre="flecha" tamano={18} />
        </a>
      </li>
      <li>
        <a href={ruta(lang, '/contacto/')}>
          {txt.nav.contacto}<Icono nombre="flecha" tamano={18} />
        </a>
      </li>
    </ul>

    <div class="menu__idioma">
      <span class="etiqueta">{txt.nav.idioma}</span>
      <SelectorIdioma class="idiomas--claro" />
    </div>
  </nav>

  <div class="menu__pie">
    <a class="btn btn--principal btn--lg" href={telHref()}>
      <Icono nombre="telefono" tamano={18} />
      {txt.acciones.llamarA(empresa.telefono.display)}
    </a>
    <a class="btn btn--linea btn--lg" href={waHref(lang)} rel="noopener noreferrer">
      <Icono nombre="whatsapp" tamano={18} />
      {txt.acciones.escribirWhatsapp}
    </a>
    <a class="btn btn--linea btn--lg" href={correoHref(lang)}>
      <Icono nombre="email" tamano={18} />
      {txt.acciones.escribirCorreo}
    </a>
  </div>
</dialog>

<script>
  const dialogo = document.getElementById('menu-movil') as HTMLDialogElement | null;

  if (dialogo) {
    document
      .querySelector('[data-abrir-menu]')
      ?.addEventListener('click', () => dialogo.showModal());

    dialogo
      .querySelector('[data-cerrar-menu]')
      ?.addEventListener('click', () => dialogo.close());
  }
</script>

<style>
  .menu {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--paper);
    color: var(--ink-2);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .menu::backdrop {
    background: rgba(20, 32, 46, 0.45);
  }

  .menu__barra {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: var(--header-h);
    padding-inline: var(--gutter);
    background: var(--paper);
    border-bottom: var(--hairline);
  }

  .menu__cerrar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    background: none;
    border: 1px solid var(--control);
    border-radius: var(--r-sm);
    color: var(--ink);
    cursor: pointer;
  }

  .menu__cuerpo {
    padding: var(--s-5) var(--gutter);
  }

  .menu__cuerpo .rule {
    margin-block: var(--s-4);
  }

  .menu__lista {
    display: grid;
    margin-top: var(--s-3);
  }

  .menu__lista a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding-block: 0.875rem;
    border-bottom: var(--hairline);
    font-size: 1.125rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
  }

  .menu__lista a svg {
    color: var(--azul);
  }

  .menu__idioma {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    margin-top: var(--s-5);
    padding-top: var(--s-4);
    border-top: var(--hairline);
    color: var(--ink-2);
  }

  .menu__pie {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-5) var(--gutter) calc(var(--s-6) + env(safe-area-inset-bottom));
    border-top: var(--hairline);
    background: var(--surface);
  }
</style>
