---
// Indicador de "abierto ahora". Se calcula en hora de Canarias, no en la del
// visitante. Sin JavaScript se ve el horario escrito.
import { empresa } from '../data/empresa';
import type { Idioma } from '../i18n/config';
import { t } from '../i18n/textos';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const txt = t(lang).estado;

// Las cadenas viajan en atributos de datos para que el script, que se agrupa
// en un archivo aparte, no necesite conocer el idioma de la página.
const etiquetas = {
  abierto: txt.abierto,
  cerrado: txt.cerrado,
  hoy: txt.hoy,
  dias: txt.dias,
  plantilla: txt.abrimos('{cuando}', '{hora}'),
};
---

<p
  class="estado"
  data-estado
  data-horario={JSON.stringify(empresa.horario)}
  data-etiquetas={JSON.stringify(etiquetas)}
>
  <span class="estado__punto" aria-hidden="true"></span>
  <span data-estado-texto>{t(lang).datos.horario}</span>
</p>

<script>
  const DIAS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

  type Tramo = { dias: number[]; desde: string; hasta: string };
  type Etiquetas = {
    abierto: string;
    cerrado: string;
    hoy: string;
    dias: string[];
    plantilla: string;
  };

  const enMinutos = (hhmm: string) => {
    const [h, m] = hhmm.split(':').map(Number);
    return h * 60 + m;
  };

  for (const nodo of document.querySelectorAll<HTMLElement>('[data-estado]')) {
    const tramos: Tramo[] = JSON.parse(nodo.dataset.horario ?? '[]');
    const et: Etiquetas | null = nodo.dataset.etiquetas
      ? JSON.parse(nodo.dataset.etiquetas)
      : null;
    const texto = nodo.querySelector('[data-estado-texto]');
    if (!tramos.length || !texto || !et) continue;

    const partes = new Intl.DateTimeFormat('en-US', {
      timeZone: 'Atlantic/Canary',
      weekday: 'short',
      hour: '2-digit',
      minute: '2-digit',
      hourCycle: 'h23',
    }).formatToParts(new Date());

    const valor = (tipo: string) => partes.find((p) => p.type === tipo)?.value ?? '';
    const dia = DIAS.indexOf(valor('weekday'));
    const ahora = Number(valor('hour')) * 60 + Number(valor('minute'));

    const abierto = tramos.some(
      (t) =>
        t.dias.includes(dia) && ahora >= enMinutos(t.desde) && ahora < enMinutos(t.hasta)
    );

    if (abierto) {
      nodo.classList.add('is-abierto');
      texto.textContent = et.abierto;
      continue;
    }

    // Primer tramo futuro, buscando hasta una semana por delante.
    let proximo: { dia: number; desde: string } | null = null;

    for (let salto = 0; salto < 8 && !proximo; salto++) {
      const d = (dia + salto) % 7;
      const candidatos = tramos
        .filter((t) => t.dias.includes(d))
        .filter((t) => salto > 0 || enMinutos(t.desde) > ahora)
        .sort((a, b) => enMinutos(a.desde) - enMinutos(b.desde));

      if (candidatos[0]) proximo = { dia: d, desde: candidatos[0].desde };
    }

    texto.textContent = proximo
      ? et.plantilla
          .replace('{cuando}', proximo.dia === dia ? et.hoy : et.dias[proximo.dia])
          .replace('{hora}', proximo.desde)
      : et.cerrado;
  }
</script>

<style>
  /* Esquinas rectas y aire de indicador de equipo, no de pastilla de app:
     borde fino, texto en versalitas y un cuadrado en vez de un círculo.
     Solo se usa dentro de bandas oscuras, así que va en claro. */
  .estado {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem;
    border: 1px solid currentColor;
    border-radius: 0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
  }

  .estado__punto {
    width: 0.4375rem;
    height: 0.4375rem;
    background: currentColor;
    flex: none;
  }

  .estado.is-abierto {
    color: var(--amarillo);
  }

  @media (prefers-reduced-motion: no-preference) {
    .estado.is-abierto .estado__punto {
      animation: latido 2.4s ease-in-out infinite;
    }

    @keyframes latido {
      0%,
      100% {
        opacity: 1;
      }
      50% {
        opacity: 0.35;
      }
    }
  }
</style>
