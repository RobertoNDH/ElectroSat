---
import { getCollection } from 'astro:content';
import Logotipo from './Logotipo.astro';
import Icono from './Icono.astro';
import Mapa from './Mapa.astro';
import {
  empresa,
  telHref,
  waHref,
  correoHref,
  direccionUnaLinea,
} from '../data/empresa';
import { ruta, type Idioma } from '../i18n/config';
import { t } from '../i18n/textos';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const txt = t(lang);

const servicios = (await getCollection('servicios'))
  .filter((s) => s.id.startsWith(`${lang}/`))
  .sort((a, b) => a.data.orden - b.data.orden);

const anio = new Date().getFullYear();

// Los textos legales solo existen en español: es la versión con validez legal
// en España. Desde inglés y alemán se enlazan igualmente, con una nota.
// Van siempre en español, así que se piden con 'es' pero pasando por ruta()
// para que lleven delante la carpeta desde la que se sirve el sitio.
const legales = [
  { href: ruta('es', '/aviso-legal/'), texto: txt.pie.avisoLegal },
  { href: ruta('es', '/politica-de-privacidad/'), texto: txt.pie.privacidad },
  { href: ruta('es', '/politica-de-cookies/'), texto: txt.pie.cookies },
];
---

<footer class="pie">
  <div class="container pie__rejilla">
    <div class="pie__marca">
      <Logotipo />
      <p class="small">{txt.pie.lema}</p>
    </div>

    <nav class="pie__col" aria-label={txt.pie.servicios}>
      <h2 class="pie__titulo">{txt.pie.servicios}</h2>
      <ul>
        {
          servicios.map((s) => (
            <li>
              <a href={ruta(lang, `/servicios/${s.id.split('/')[1]}/`)}>{s.data.corto}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="pie__col" aria-label={txt.pie.empresa}>
      <h2 class="pie__titulo">{txt.pie.empresa}</h2>
      <ul>
        <li><a href={ruta(lang, '/nosotros/')}>{txt.nav.nosotros}</a></li>
        <li><a href={ruta(lang, '/contacto/')}>{txt.nav.contacto}</a></li>
        <li><a href={`${ruta(lang, '/')}#cobertura`}>{txt.pie.cobertura}</a></li>
        <li><a href={`${ruta(lang, '/')}#marcas`}>{txt.pie.marcas}</a></li>
      </ul>
    </nav>

    <div class="pie__col">
      <h2 class="pie__titulo">{txt.pie.contacto}</h2>
      <a class="pie__tel" href={telHref()}>
        <Icono nombre="telefono" tamano={18} />
        <span class="tel-num">{empresa.telefono.display}</span>
      </a>
      <ul class="pie__datos">
        <li>
          <Icono nombre="whatsapp" tamano={16} />
          <a class="tel-num" href={telHref(empresa.movil)}>{empresa.movil.display}</a>
        </li>
        <li>
          <Icono nombre="email" tamano={16} />
          <a href={correoHref(lang)}>{empresa.email}</a>
        </li>
        <li>
          <Icono nombre="mapa" tamano={16} />
          <span>{direccionUnaLinea}</span>
        </li>
        <li>
          <Icono nombre="reloj" tamano={16} />
          <span>{txt.datos.horario}</span>
        </li>
      </ul>
      <a class="btn btn--azul" href={waHref(lang)} rel="noopener noreferrer">
        <Icono nombre="whatsapp" tamano={17} />
        {txt.acciones.escribirWhatsapp}
      </a>
    </div>
  </div>

  <div class="pie__mapa">
    <div class="container">
      <Mapa lang={lang} />
    </div>
  </div>

  <div class="pie__legal">
    <div class="container pie__legal-fila">
      <p class="small">© {anio} {empresa.razonSocial}</p>
      <ul class="pie__legal-enlaces">
        {legales.map((l) => <li><a href={l.href}>{l.texto}</a></li>)}
      </ul>
    </div>
    {
      txt.legalOtroIdioma && (
        <p class="container pie__nota small">{txt.legalOtroIdioma}</p>
      )
    }
  </div>
</footer>

<style>
  .pie {
    background: var(--surface);
    border-top: 3px solid var(--azul);
  }

  .pie__rejilla {
    display: grid;
    gap: var(--s-6);
    grid-template-columns: 1fr;
    padding-block: clamp(2.25rem, 4vw, 3.25rem);
  }

  @media (min-width: 40rem) {
    .pie__rejilla {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 62rem) {
    .pie__rejilla {
      grid-template-columns: 1.4fr 1fr 1fr 1.3fr;
    }
  }

  .pie__marca {
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }

  .pie__marca .small {
    max-width: 28ch;
  }

  .pie__col {
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }

  .pie__titulo {
    font-family: var(--font-base);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .pie__col ul {
    display: grid;
    gap: 0.5rem;
  }

  .pie__col a:not(.btn) {
    font-size: var(--fs-small);
    text-decoration: none;
    color: var(--ink-2);
  }

  .pie__col a:not(.btn):hover {
    color: var(--azul);
    text-decoration: underline;
  }

  .pie__tel {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.375rem !important;
    font-weight: 700;
    color: var(--ink) !important;
    text-decoration: none;
  }

  .pie__tel svg {
    color: var(--amarillo-texto);
  }

  .pie__datos {
    display: grid;
    gap: 0.5rem !important;
  }

  .pie__datos li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--ink-2);
  }

  .pie__datos svg {
    color: var(--azul);
    margin-top: 0.1875rem;
    flex: none;
  }

  .pie__col .btn {
    justify-self: start;
    margin-top: var(--s-1);
  }

  /* "Dónde estamos" en gris, un tono más oscuro que el resto del pie: separa
     el mapa de las columnas de enlaces sin salirse de la paleta clara. */
  .pie__mapa {
    background: var(--surface-2);
    border-top: var(--hairline);
    padding-block: clamp(2rem, 4vw, 3rem);
  }

  .pie__legal {
    border-top: var(--hairline);
    background: var(--surface-2);
  }

  .pie__legal-fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2) var(--s-5);
    padding-block: var(--s-4);
  }

  .pie__legal-enlaces {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
  }

  .pie__legal-enlaces a {
    font-size: var(--fs-small);
    color: var(--ink-3);
    text-decoration: none;
  }

  .pie__legal-enlaces a:hover {
    color: var(--azul);
    text-decoration: underline;
  }

  .pie__nota {
    padding-bottom: var(--s-4);
    max-width: 78ch;
  }
</style>
