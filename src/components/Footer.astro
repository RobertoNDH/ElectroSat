---
import { getCollection } from 'astro:content';
import Logotipo from './Logotipo.astro';
import Icono from './Icono.astro';
import {
  empresa,
  telHref,
  waHref,
  correoHref,
  direccionUnaLinea,
} from '../data/empresa';
import { ruta, type Idioma } from '../i18n/config';
import { t } from '../i18n/textos';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const txt = t(lang);

const servicios = (await getCollection('servicios'))
  .filter((s) => s.id.startsWith(`${lang}/`))
  .sort((a, b) => a.data.orden - b.data.orden);

const anio = new Date().getFullYear();

const legales = [
  { href: ruta('es', '/aviso-legal/'), texto: txt.pie.avisoLegal },
  { href: ruta('es', '/politica-de-privacidad/'), texto: txt.pie.privacidad },
  { href: ruta('es', '/politica-de-cookies/'), texto: txt.pie.cookies },
];
---

<footer class="pie">
  <div class="container pie__rejilla">
    <div class="pie__marca">
      <span class="pie__logo"><Logotipo /></span>
      <p class="small">{txt.pie.lema}</p>
      <p class="pie__registro">
        <Icono nombre="escudo" tamano={16} />
        {txt.pie.registro}
      </p>
    </div>

    <nav class="pie__col" aria-label={txt.pie.servicios}>
      <h2 class="pie__titulo">{txt.pie.servicios}</h2>
      <ul>
        {
          servicios.map((s) => (
            <li>
              <a href={ruta(lang, `/servicios/${s.id.split('/')[1]}/`)}>{s.data.corto}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="pie__col" aria-label={txt.pie.empresa}>
      <h2 class="pie__titulo">{txt.pie.empresa}</h2>
      <ul>
        <li><a href={ruta(lang, '/nosotros/')}>{txt.nav.nosotros}</a></li>
        <li><a href={ruta(lang, '/contacto/')}>{txt.nav.contacto}</a></li>
        <li><a href={`${ruta(lang, '/')}#cobertura`}>{txt.pie.cobertura}</a></li>
        <li><a href={`${ruta(lang, '/')}#marcas`}>{txt.pie.marcas}</a></li>
      </ul>
    </nav>

    <div class="pie__col pie__col--contacto">
      <h2 class="pie__titulo">{txt.pie.contacto}</h2>
      <a class="pie__tel" href={telHref()}>
        <Icono nombre="telefono" tamano={18} />
        <span class="tel-num">{empresa.telefono.display}</span>
      </a>
      <ul class="pie__datos">
        <li>
          <Icono nombre="whatsapp" tamano={16} />
          <a class="tel-num" href={telHref(empresa.movil)}>{empresa.movil.display}</a>
        </li>
        <li>
          <Icono nombre="email" tamano={16} />
          <a href={correoHref(lang)}>{empresa.email}</a>
        </li>
        <li>
          <Icono nombre="mapa" tamano={16} />
          <span>{direccionUnaLinea}</span>
        </li>
        <li>
          <Icono nombre="reloj" tamano={16} />
          <span>{txt.datos.horario}</span>
        </li>
      </ul>
      <a class="btn btn--principal" href={waHref(lang)} rel="noopener noreferrer">
        <Icono nombre="whatsapp" tamano={17} />
        {txt.acciones.escribirWhatsapp}
      </a>
    </div>
  </div>

  <div class="pie__legal">
    <div class="container pie__legal-fila">
      <p class="small">© {anio} {empresa.razonSocial}</p>
      <ul class="pie__legal-enlaces">
        {legales.map((l) => <li><a href={l.href}>{l.texto}</a></li>)}
      </ul>
    </div>
    {
      txt.legalOtroIdioma && (
        <p class="container pie__nota small">{txt.legalOtroIdioma}</p>
      )
    }
  </div>
</footer>

<style>
  .pie {
    background-color: var(--surface-2);
    background-image: var(--resplandor-fuerte), var(--topo-fuerte);
    border-top: 1px solid var(--oro);
    color: var(--ink-2);
  }

  .pie__rejilla {
    display: grid;
    gap: var(--s-5) var(--s-4);
    grid-template-columns: repeat(2, 1fr);
    padding-block: clamp(3rem, 5vw, 4.5rem);
  }

  .pie__marca,
  .pie__col--contacto {
    grid-column: 1 / -1;
  }

  @media (min-width: 40rem) {
    .pie__rejilla {
      gap: var(--s-6);
    }
  }

  @media (min-width: 62rem) {
    .pie__rejilla {
      grid-template-columns: 1.4fr 1fr 1fr 1.3fr;
    }

    .pie__marca,
    .pie__col--contacto {
      grid-column: auto;
    }
  }

  .pie__marca {
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }

  .pie__logo {
    display: inline-block;
    justify-self: start;
  }

  .pie__marca .small {
    max-width: 30ch;
    color: var(--ink-3);
    line-height: 1.6;
  }

  .pie__registro {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-mini);
    font-weight: 600;
    color: var(--oro);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .pie__col {
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }

  .pie__titulo {
    font-family: var(--font-base);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--oro);
  }

  .pie__col ul {
    display: grid;
    gap: 0.75rem;
  }

  .pie__col a:not(.btn) {
    font-size: var(--fs-small);
    text-decoration: none;
    color: var(--ink-2);
    transition: color var(--t-rapido);
  }

  .pie__col a:not(.btn):hover {
    color: var(--oro);
  }

  .pie__tel {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.75rem !important;
    font-weight: 600;
    color: var(--ink) !important;
    text-decoration: none;
  }

  .pie__tel:hover {
    color: var(--oro) !important;
  }

  .pie__tel svg {
    color: var(--oro);
  }

  .pie__datos {
    display: grid;
    gap: 0.6rem !important;
    margin-bottom: var(--s-2);
  }

  .pie__datos li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .pie__datos svg {
    color: var(--oro);
    margin-top: 0.1875rem;
    flex: none;
  }

  .pie__col .btn {
    justify-self: start;
  }

  .pie__legal {
    border-top: 1px solid var(--line);
    background: var(--surface);
  }

  .pie__legal-fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2) var(--s-5);
    padding-block: var(--s-4);
  }

  .pie__legal-enlaces {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
  }

  .pie__legal-enlaces a {
    font-size: var(--fs-mini);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-3);
    text-decoration: none;
  }

  .pie__legal-enlaces a:hover {
    color: var(--oro);
  }

  .pie__legal .small {
    color: var(--ink-3);
    font-size: var(--fs-mini);
  }

  .pie__nota {
    padding-bottom: var(--s-4);
    max-width: 78ch;
    color: var(--ink-3);
  }
</style>
