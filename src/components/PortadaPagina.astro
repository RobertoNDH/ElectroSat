---
// Portada de página interior: titular a la izquierda, foto a la derecha.
// Mantiene el mismo gesto que la home para que todas las páginas se reconozcan.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  titulo: string;
  texto: string;
  foto: ImageMetadata;
  alt: string;
}
const { titulo, texto, foto, alt } = Astro.props;
---

<section class="portada">
  <div class="container portada__rejilla">
    <div class="portada__texto">
      <h1 class="display-l">{titulo}</h1>
      <p class="lede">{texto}</p>
      <slot />
    </div>

    <figure class="portada__foto">
      <Image
        src={foto}
        alt={alt}
        widths={[440, 660, 900]}
        sizes="(min-width: 62rem) 26rem, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    </figure>
  </div>
</section>

<style>
  .portada {
    padding-block: clamp(1.75rem, 3.5vw, 3rem);
    border-bottom: var(--hairline);
  }

  .portada__rejilla {
    display: grid;
    gap: var(--s-5);
    align-items: center;
  }

  @media (min-width: 62rem) {
    .portada__rejilla {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: var(--s-7);
    }
  }

  .portada__texto {
    display: grid;
    gap: var(--s-3);
  }

  .portada__texto .lede {
    max-width: 50ch;
  }

  .portada__foto {
    margin: 0;
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--sombra);
  }

  .portada__foto :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  @media (prefers-reduced-motion: no-preference) {
    .portada__foto {
      animation: entrar 720ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
    }

    @keyframes entrar {
      from {
        opacity: 0;
        transform: translateY(14px) scale(0.985);
        filter: blur(6px);
      }
    }
  }
</style>
