export type NombreIcono = keyof typeof trazos;

interface Props {
  nombre: NombreIcono;
  tamano?: number;
  class?: string;
}

const { nombre, tamano = 24, class: clase } = Astro.props;
---

<svg
  class:list={['icono', clase]}
  width={tamano}
  height={tamano}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={trazos[nombre]}
/>

<style>
  .icono {
    flex: none;
    display: block;
  }
</style>
