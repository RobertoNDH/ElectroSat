---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import BloqueContacto from '../components/BloqueContacto.astro';
import Portada from '../components/Portada.astro';
import fotoPortada from '../assets/antena-tejado.jpg';
import { fotoDeServicio } from '../data/imagenes';
import { ruta, type Idioma } from '../i18n/config';
import { t } from '../i18n/textos';
import { seo } from '../i18n/seo';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const txt = t(lang);
const meta = seo(lang).servicios;

const servicios = (await getCollection('servicios'))
  .filter((s) => s.id.startsWith(`${lang}/`))
  .sort((a, b) => a.data.orden - b.data.orden);

const sitio = Astro.site!;
const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: txt.nav.inicio, item: new URL(ruta(lang, '/'), sitio).href },
      { '@type': 'ListItem', position: 2, name: txt.nav.servicios, item: new URL(ruta(lang, '/servicios/'), sitio).href },
    ],
  },
];
---

<Base lang={lang} titulo={meta.titulo} descripcion={meta.descripcion} jsonLd={jsonLd}>
  <Portada
    titulo={txt.servicios.titulo}
    texto={txt.servicios.prosa}
    foto={fotoPortada}
    alt="Antenas y parabólicas instaladas en la azotea de un edificio"
    encuadre="alto"
  />

  <section class="section section--tight">
    <div class="container">
      <ul class="lista">
        {
          servicios.map((s) => (
            <li class="fila">
              <a class="fila__foto" href={ruta(lang, `/servicios/${s.id.split('/')[1]}/`)} tabindex="-1" aria-hidden="true">
                <Image
                  src={fotoDeServicio(s.id)}
                  alt=""
                  widths={[280, 420]}
                  sizes="(min-width: 55rem) 14rem, 100vw"
                  loading="lazy"
                />
              </a>
              <div class="fila__texto">
                <h2 class="h3">
                  <a href={ruta(lang, `/servicios/${s.id.split('/')[1]}/`)}>{s.data.titulo}</a>
                </h2>
                <p class="fila__resumen">{s.data.resumen}</p>
                <ul class="fila__puntos">
                  {s.data.puntos.map((p) => <li>{p}</li>)}
                </ul>
              </div>
              <a class="enlace-flecha fila__enlace" href={ruta(lang, `/servicios/${s.id.split('/')[1]}/`)}>
                {txt.acciones.verServicio}
                <Icono nombre="flecha" tamano={16} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <BloqueContacto lang={lang} titulo={txt.servicios.ctaTitulo} texto={txt.servicios.ctaTexto} />
</Base>

<style>
  /* En columnas y sin caja: antes era una fila con borde por servicio, que
     ocupaba una pantalla entera en escritorio y parecía un listado de fichas. */
  .lista {
    display: grid;
    gap: var(--s-6) var(--s-5);
  }

  @media (min-width: 44rem) {
    .lista {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 66rem) {
    .lista {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .fila {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 0.5rem;
    align-content: start;
  }

  .fila__foto {
    display: block;
    overflow: hidden;
    margin-bottom: var(--s-2);
    background: var(--surface-2);
  }

  .fila__foto :global(img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  .fila:hover .fila__foto :global(img) {
    transform: scale(1.05);
  }

  .fila__texto {
    display: grid;
    gap: 0.5rem;
  }

  .fila__texto :global(a) {
    transition: color var(--t-rapido);
  }

  .fila:hover .fila__texto :global(a) {
    color: var(--azul);
  }

  .fila__texto a {
    text-decoration: none;
  }

  .fila__texto a:hover {
    text-decoration: underline;
  }

  .fila__resumen {
    font-size: var(--fs-small);
    color: var(--ink-3);
  }

  /* Los puntos pasan a lista con guion: las pastillas repetían la forma
     redonda que quitamos de las tarjetas. */
  .fila__puntos {
    display: grid;
    gap: 0.1875rem;
    margin-top: var(--s-1);
  }

  .fila__puntos li {
    position: relative;
    padding-left: 0.875rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--ink-3);
  }

  .fila__puntos li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 1px;
    background: var(--azul);
  }

  .fila__enlace {
    margin-top: var(--s-2);
    justify-self: start;
  }
</style>
