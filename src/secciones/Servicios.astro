---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import BloqueContacto from '../components/BloqueContacto.astro';
import PortadaPagina from '../components/PortadaPagina.astro';
import Marquesina from '../components/Marquesina.astro';
import Proceso from '../components/Proceso.astro';
import fotoPortada from '../assets/portada-servicios.jpg';
import { fotoDeServicio } from '../data/imagenes';
import { marcas } from '../data/marcas';
import { ruta, type Idioma } from '../i18n/config';
import { t } from '../i18n/textos';
import { seo } from '../i18n/seo';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const txt = t(lang);
const meta = seo(lang).servicios;

const servicios = (await getCollection('servicios'))
  .filter((s) => s.id.startsWith(`${lang}/`))
  .sort((a, b) => a.data.orden - b.data.orden);

const marcasTira = marcas.map((m) => ({ titulo: m.nombre, texto: m.para }));

const sitio = Astro.site!;
const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: txt.nav.inicio, item: new URL(ruta(lang, '/'), sitio).href },
      { '@type': 'ListItem', position: 2, name: txt.nav.servicios, item: new URL(ruta(lang, '/servicios/'), sitio).href },
    ],
  },
];
---

<Base lang={lang} titulo={meta.titulo} descripcion={meta.descripcion} jsonLd={jsonLd}>
  <PortadaPagina
    lang={lang}
    titulo={txt.servicios.titulo}
    texto={txt.servicios.prosa}
    foto={fotoPortada}
    encuadre="alto"
    migas={[{ texto: txt.nav.servicios }]}
    centrado
  />

  <section class="section">
    <div class="container">
      <ul class="lista" data-anima="hijos">
        {
          servicios.map((s, i) => {
            const url = ruta(lang, `/servicios/${s.id.split('/')[1]}/`);
            return (
              <li class="tarjeta tarjeta--eleva ficha">
                <span class="ficha__cabecera">
                  <a class="marco marco--zoom ficha__marco" href={url} tabindex="-1" aria-hidden="true">
                    <Image
                      src={fotoDeServicio(s.id)}
                      alt=""
                      widths={[420, 640, 900]}
                      sizes="(min-width: 62rem) 28rem, 92vw"
                      loading={i < 2 ? 'eager' : 'lazy'}
                    />
                  </a>

                  <span class="pastilla pastilla--marca ficha__icono">
                    <Icono nombre={s.data.icono} tamano={24} />
                  </span>
                </span>

                <div class="ficha__cuerpo">
                  <h2 class="h3">
                    <a class="ficha__titulo" href={url}>{s.data.titulo}</a>
                  </h2>
                  <p class="ficha__resumen">{s.data.resumen}</p>

                  <ul class="ficha__puntos">
                    {s.data.puntos.map((p) => (
                      <li>
                        <Icono nombre="check" tamano={15} />
                        {p}
                      </li>
                    ))}
                  </ul>

                  <a class="enlace-flecha ficha__enlace" href={url} tabindex="-1" aria-hidden="true">
                    {txt.acciones.verServicio}
                    <Icono nombre="flecha" tamano={16} />
                  </a>
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <Proceso lang={lang} />

  <section class="section section--surface section--tight" aria-labelledby="marcas-titulo">
    <div class="container cabecera" data-anima>
      <h2 class="h2" id="marcas-titulo">{txt.marcas.titulo}</h2>
      <p class="prosa">{txt.marcas.prosa}</p>
    </div>
    <Marquesina items={marcasTira} variante="marcas" etiqueta={txt.marcas.titulo} duracion={52} />
  </section>

  <BloqueContacto lang={lang} titulo={txt.servicios.ctaTitulo} texto={txt.servicios.ctaTexto} />
</Base>

<style>
  .lista {
    display: grid;
    gap: var(--s-5);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }

  .ficha {
    position: relative;
    overflow: hidden;
  }

  /* El icono se ancla al pie de la foto, no a la tarjeta, que cambia de alto
     según cuántas líneas ocupen las viñetas. */
  .ficha__cabecera {
    position: relative;
    display: block;
  }

  .ficha__marco {
    display: block;
    aspect-ratio: 16 / 10;
  }

  .ficha__icono {
    position: absolute;
    bottom: -1.75rem;
    right: var(--s-5);
    width: 3.5rem;
    height: 3.5rem;
    border: 3px solid var(--paper);
    box-shadow: var(--sombra);
    z-index: 1;
  }

  .ficha__cuerpo {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    gap: var(--s-3);
    padding: calc(var(--s-5) + 1rem) var(--s-5) var(--s-5);
    padding-right: calc(var(--s-5) + 2.5rem);
  }

  .ficha__titulo {
    color: var(--ink);
    text-decoration: none;
    transition: color var(--t-rapido);
  }

  /* El enlace del título se estira sobre toda la tarjeta: así se puede pinchar
     en cualquier punto, pero en el árbol de accesibilidad sigue habiendo un
     solo enlace por servicio en vez de tres repetidos. */
  .ficha__titulo::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .ficha:hover .ficha__titulo {
    color: var(--azul);
  }

  .ficha__resumen {
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--ink-3);
  }

  .ficha__puntos {
    display: grid;
    gap: 0.4375rem;
    margin-top: var(--s-1);
  }

  .ficha__puntos li {
    display: flex;
    align-items: start;
    gap: 0.5rem;
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--ink-2);
  }

  .ficha__puntos svg {
    color: var(--azul);
    margin-top: 0.25rem;
    flex: none;
  }

  .ficha__enlace {
    margin-top: var(--s-2);
    justify-self: start;
  }

  .ficha::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 0;
    height: 4px;
    background: var(--amarillo);
    transition: right var(--t-medio);
    z-index: 2;
  }

  .ficha:hover::after,
  .ficha:focus-within::after {
    right: 0;
  }
</style>
