---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import BloqueContacto from '../components/BloqueContacto.astro';
import PortadaPagina from '../components/PortadaPagina.astro';
import fotoParabolica from '../assets/parabolica.jpg';
import { fotoDeServicio } from '../data/imagenes';
import { ruta, type Idioma } from '../i18n/config';
import { t } from '../i18n/textos';
import { seo } from '../i18n/seo';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const txt = t(lang);
const meta = seo(lang).servicios;

const servicios = (await getCollection('servicios'))
  .filter((s) => s.id.startsWith(`${lang}/`))
  .sort((a, b) => a.data.orden - b.data.orden);

const sitio = Astro.site!;
const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: txt.nav.inicio, item: new URL(ruta(lang, '/'), sitio).href },
      { '@type': 'ListItem', position: 2, name: txt.nav.servicios, item: new URL(ruta(lang, '/servicios/'), sitio).href },
    ],
  },
];
---

<Base lang={lang} titulo={meta.titulo} descripcion={meta.descripcion} jsonLd={jsonLd}>
  <PortadaPagina
    titulo={txt.servicios.titulo}
    texto={txt.servicios.prosa}
    foto={fotoParabolica}
    alt="Antena parabólica instalada en el tejado de un edificio"
  />

  <section class="section section--tight">
    <div class="container">
      <ul class="lista">
        {
          servicios.map((s) => (
            <li class="fila">
              <a class="fila__foto" href={ruta(lang, `/servicios/${s.id.split('/')[1]}/`)} tabindex="-1" aria-hidden="true">
                <Image
                  src={fotoDeServicio(s.id)}
                  alt=""
                  widths={[280, 420]}
                  sizes="(min-width: 55rem) 14rem, 100vw"
                  loading="lazy"
                />
              </a>
              <div class="fila__texto">
                <h2 class="h3">
                  <a href={ruta(lang, `/servicios/${s.id.split('/')[1]}/`)}>{s.data.titulo}</a>
                </h2>
                <p class="fila__resumen">{s.data.resumen}</p>
                <ul class="fila__puntos">
                  {s.data.puntos.map((p) => <li>{p}</li>)}
                </ul>
              </div>
              <a class="enlace-flecha fila__enlace" href={ruta(lang, `/servicios/${s.id.split('/')[1]}/`)}>
                {txt.acciones.verServicio}
                <Icono nombre="flecha" tamano={16} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <BloqueContacto lang={lang} titulo={txt.servicios.ctaTitulo} texto={txt.servicios.ctaTexto} />
</Base>

<style>
  .lista {
    display: grid;
    gap: var(--s-4);
  }

  .fila {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-4);
    align-items: center;
    padding: var(--s-4);
    background: var(--paper);
    border: var(--hairline);
    border-radius: var(--r-lg);
    box-shadow: var(--sombra-sm);
    transition: border-color var(--t-rapido), box-shadow var(--t-rapido);
  }

  .fila:hover {
    border-color: var(--azul);
    box-shadow: var(--sombra);
  }

  @media (min-width: 55rem) {
    .fila {
      grid-template-columns: 14rem minmax(0, 1fr) auto;
      gap: var(--s-5);
    }
  }

  .fila__foto {
    display: block;
    border-radius: var(--r-md);
    overflow: hidden;
  }

  .fila__foto :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .fila__texto {
    display: grid;
    gap: 0.5rem;
  }

  .fila__texto a {
    text-decoration: none;
  }

  .fila__texto a:hover {
    text-decoration: underline;
  }

  .fila__resumen {
    font-size: var(--fs-small);
    color: var(--ink-2);
    max-width: 56ch;
  }

  .fila__puntos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .fila__puntos li {
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    background: var(--surface-2);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ink-2);
  }
</style>
