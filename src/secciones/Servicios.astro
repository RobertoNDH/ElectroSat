---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import BloqueContacto from '../components/BloqueContacto.astro';
import Portada from '../components/Portada.astro';
import Marquesina from '../components/Marquesina.astro';
import FlechasCarrusel from '../components/FlechasCarrusel.astro';
import fotoPortada from '../assets/antena-tejado.jpg';
import { fotoDeServicio } from '../data/imagenes';
import { marcas } from '../data/marcas';
import { empresa, telHref, waHref } from '../data/empresa';
import { ruta, type Idioma } from '../i18n/config';
import { t } from '../i18n/textos';
import { seo } from '../i18n/seo';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const txt = t(lang);
const meta = seo(lang).servicios;

const servicios = (await getCollection('servicios'))
  .filter((s) => s.id.startsWith(`${lang}/`))
  .sort((a, b) => a.data.orden - b.data.orden);

const marcasTira = marcas.map((m) => ({ titulo: m.nombre, texto: m.para }));

const sitio = Astro.site!;
const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: txt.nav.inicio, item: new URL(ruta(lang, '/'), sitio).href },
      { '@type': 'ListItem', position: 2, name: txt.nav.servicios, item: new URL(ruta(lang, '/servicios/'), sitio).href },
    ],
  },
];
---

<Base lang={lang} titulo={meta.titulo} descripcion={meta.descripcion} jsonLd={jsonLd}>
  <Portada
    titulo={txt.servicios.titulo}
    texto={txt.servicios.prosa}
    foto={fotoPortada}
    alt="Antenas y parabólicas instaladas en la azotea de un edificio"
    encuadre="alto"
  >
    <div class="portada__acciones">
      <a class="btn btn--principal btn--lg" href={telHref()}>
        <Icono nombre="telefono" tamano={18} />
        {txt.acciones.llamarA(empresa.telefono.display)}
      </a>
      <a class="btn btn--azul btn--lg" href={waHref(lang)} rel="noopener noreferrer">
        <Icono nombre="whatsapp" tamano={18} />
        {txt.acciones.whatsapp}
      </a>
    </div>
  </Portada>

  <section class="section section--tight">
    <div class="carrusel carrusel--servicios">
      <div class="carrusel__vista">
        {
          [false, true].map((copia) => (
            <ul class="lista carrusel__pista" aria-hidden={copia ? 'true' : undefined}>
              {servicios.map((s) => {
                const url = ruta(lang, `/servicios/${s.id.split('/')[1]}/`);
                return (
                  <li class="fila">
                    <a class="fila__foto" href={url} tabindex="-1" aria-hidden="true">
                      <Image
                        src={fotoDeServicio(s.id)}
                        alt=""
                        widths={[340, 460, 620]}
                        sizes="(min-width: 30rem) 22rem, 74vw"
                        loading="lazy"
                      />
                    </a>
                    <div class="fila__texto">
                      <h2 class="h3">
                        <a href={url} tabindex={copia ? -1 : undefined}>
                          {s.data.titulo}
                        </a>
                      </h2>
                      <p class="fila__resumen">{s.data.resumen}</p>
                      <ul class="fila__puntos">
                        {s.data.puntos.map((p) => (
                          <li>{p}</li>
                        ))}
                      </ul>
                    </div>
                    <a class="enlace-flecha fila__enlace" href={url} tabindex={copia ? -1 : undefined}>
                      {txt.acciones.verServicio}
                      <Icono nombre="flecha" tamano={16} />
                    </a>
                  </li>
                );
              })}
            </ul>
          ))
        }
      </div>

      <FlechasCarrusel anterior={txt.acciones.anterior} siguiente={txt.acciones.siguiente} />
    </div>
  </section>

  <section class="section section--surface section--tight" aria-labelledby="marcas-titulo">
    <div class="container cabecera">
      <h2 class="h2" id="marcas-titulo">{txt.marcas.titulo}</h2>
      <p class="prosa">{txt.marcas.prosa}</p>
    </div>
    <Marquesina items={marcasTira} variante="marcas" etiqueta={txt.marcas.titulo} duracion={52} />
  </section>

  <BloqueContacto lang={lang} titulo={txt.servicios.ctaTitulo} texto={txt.servicios.ctaTexto} />
</Base>

<style>
  .portada__acciones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }

  /* Una fila que desfila, igual que en la portada: los seis servicios en
     rejilla ocupaban dos pantallas para lo mismo que se lee de un vistazo
     pasando. Las reglas del carrusel están en base.css. */
  .carrusel--servicios {
    --vuelta: 64s;
  }

  .fila {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 0.5rem;
    align-content: start;
  }

  .fila__foto {
    display: block;
    overflow: hidden;
    margin-bottom: var(--s-2);
    background: var(--surface-2);
  }

  .fila__foto :global(img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  .fila:hover .fila__foto :global(img) {
    transform: scale(1.05);
  }

  /* Mismo filo sobre el título que en el resto del sitio: es lo que ata cada
     texto a su foto y da la retícula fina que sostiene la página. */
  .fila__texto {
    display: grid;
    gap: 0.5rem;
    padding-top: var(--s-3);
    border-top: 2px solid var(--ink);
  }

  .fila__texto a {
    color: var(--ink);
    text-decoration: none;
    transition: color var(--t-rapido);
  }

  .fila:hover .fila__texto a {
    color: var(--azul);
  }

  .fila__texto a:hover {
    text-decoration: underline;
  }

  .fila__resumen {
    font-size: var(--fs-small);
    color: var(--ink-3);
  }

  /* Los puntos pasan a lista con guion: las pastillas repetían la forma
     redonda que quitamos de las tarjetas. */
  .fila__puntos {
    display: grid;
    gap: 0.1875rem;
    margin-top: var(--s-1);
  }

  .fila__puntos li {
    position: relative;
    padding-left: 0.875rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--ink-3);
  }

  .fila__puntos li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 1px;
    background: var(--azul);
  }

  .fila__enlace {
    margin-top: var(--s-2);
    justify-self: start;
  }
</style>
