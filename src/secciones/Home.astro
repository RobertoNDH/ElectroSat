---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import Faq from '../components/Faq.astro';
import Valoracion from '../components/Valoracion.astro';
import Marquesina from '../components/Marquesina.astro';
import Portada from '../components/Portada.astro';
import Banda from '../components/Banda.astro';
import BloqueContacto from '../components/BloqueContacto.astro';
import { fotoDeServicio } from '../data/imagenes';
import { marcas } from '../data/marcas';
import { FAQ } from '../data/faq';
import { empresa, telHref, waHref } from '../data/empresa';
import { ruta, type Idioma } from '../i18n/config';
import { t } from '../i18n/textos';
import { seo } from '../i18n/seo';

import fotoAntena from '../assets/portada-servicios.jpg';
import fotoSur from '../assets/cobertura-sur.jpg';
import fotoEdificio from '../assets/edificio.jpg';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const txt = t(lang);
const meta = seo(lang).home;
const faq = FAQ[lang];

const servicios = (await getCollection('servicios'))
  .filter((s) => s.id.startsWith(`${lang}/`))
  .sort((a, b) => a.data.orden - b.data.orden);

// Una foto por tipo de cliente: edificio, zona hotelera y vivienda suelta.
const fotosPublicos = [fotoEdificio, fotoSur, fotoAntena];
const iconosPruebas = ['documento', 'escudo', 'check', 'euro'] as const;

const marcasTira = marcas.map((m) => ({ titulo: m.nombre, texto: m.para }));

const sitio = Astro.site!;
const jsonLd = [
  {
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.p,
      acceptedAnswer: { '@type': 'Answer', text: f.r },
    })),
  },
  {
    '@type': 'WebSite',
    name: empresa.razonSocial,
    url: sitio.href,
    publisher: { '@id': new URL('/#negocio', sitio).href },
  },
];
---

<Base lang={lang} titulo={meta.titulo} descripcion={meta.descripcion} jsonLd={jsonLd}>
  <Portada
    titulo={txt.hero.titulo}
    texto={txt.hero.lede}
    foto={fotoAntena}
    alt="Antena de televisión instalada en el tejado de una vivienda del sur de Tenerife"
    alto="alta"
    principal
    encuadre="alto"
  >
    <ul class="ventajas">
      {
        txt.hero.ventajas.map((v) => (
          <li>
            <Icono nombre="check" tamano={17} />
            {v}
          </li>
        ))
      }
    </ul>

    <div class="acciones">
      <a class="btn btn--principal btn--lg" href={telHref()}>
        <Icono nombre="telefono" tamano={18} />
        {txt.acciones.llamarA(empresa.telefono.display)}
      </a>
      <a class="btn btn--azul btn--lg" href={waHref(lang)} rel="noopener noreferrer">
        <Icono nombre="whatsapp" tamano={18} />
        {txt.acciones.whatsapp}
      </a>
    </div>

    <Valoracion lang={lang} />
  </Portada>

  <section class="section" id="servicios" aria-labelledby="servicios-titulo">
    <div class="container">
      <div class="cabecera">
        <h2 class="h2" id="servicios-titulo">{txt.servicios.titulo}</h2>
        <p class="prosa">{txt.servicios.prosa}</p>
      </div>

      <ul class="servicios">
        {
          servicios.map((s) => {
            const slug = s.id.split('/')[1];
            return (
              <li class="servicio">
                <a class="servicio__enlace" href={ruta(lang, `/servicios/${slug}/`)}>
                  <span class="servicio__foto">
                    <Image
                      src={fotoDeServicio(s.id)}
                      alt={s.data.corto}
                      widths={[400, 600, 800]}
                      sizes="(min-width: 66rem) 22rem, (min-width: 44rem) 45vw, 100vw"
                      loading="lazy"
                    />
                  </span>
                  <span class="servicio__cuerpo">
                    <span class="h3">{s.data.titulo}</span>
                    <span class="servicio__resumen">{s.data.resumen}</span>
                    <span class="enlace-flecha servicio__mas">
                      {txt.acciones.verServicio}
                      <Icono nombre="flecha" tamano={16} />
                    </span>
                  </span>
                </a>
              </li>
            );
          })
        }

        <li class="servicio servicio--cta">
          <div class="servicio__cta">
            <span class="h3">{txt.servicios.ctaTitulo}</span>
            <span class="servicio__resumen">{txt.servicios.ctaTexto}</span>
            <a class="btn btn--principal" href={telHref()}>
              <Icono nombre="telefono" tamano={17} />
              {txt.acciones.llamarA(empresa.telefono.display)}
            </a>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="publicos-titulo">
    <div class="container">
      <div class="cabecera">
        <h2 class="h2" id="publicos-titulo">{txt.publicos.titulo}</h2>
        <p class="prosa">{txt.publicos.prosa}</p>
      </div>

      <ul class="publicos">
        {
          txt.publicos.items.map((p, i) => (
            <li class="publico">
              <span class="publico__foto">
                <Image
                  src={fotosPublicos[i]}
                  alt=""
                  widths={[420, 640, 860, 1100]}
                  sizes="(min-width: 55rem) 23rem, 100vw"
                  loading="lazy"
                />
              </span>
              <h3 class="h3 publico__titulo">{p.titulo}</h3>
              <p class="publico__texto">{p.texto}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Banda foto={fotoEdificio} encuadre="centro" rotulo="pruebas-titulo">
    <div class="cabecera">
      <h2 class="h2" id="pruebas-titulo">{txt.pruebas.titulo}</h2>
    </div>

    <ul class="pruebas">
      {
        txt.pruebas.items.map((p, i) => (
          <li class="prueba">
            <span class="prueba__icono">
              <Icono nombre={iconosPruebas[i]} tamano={19} />
            </span>
            <strong class="prueba__titulo">{p.titulo}</strong>
            <span class="prueba__texto">{p.texto}</span>
          </li>
        ))
      }
    </ul>
  </Banda>

  <section class="section" aria-labelledby="proceso-titulo">
    <div class="container">
      <div class="cabecera">
        <h2 class="h2" id="proceso-titulo">{txt.pasos.titulo}</h2>
      </div>

      <ol class="pasos">
        {
          txt.pasos.items.map((p, i) => (
            <li class="paso">
              <span class="paso__numero">{String(i + 1).padStart(2, '0')}</span>
              <strong class="paso__titulo">{p.titulo}</strong>
              <span class="paso__texto">{p.texto}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--surface section--tight" id="marcas" aria-labelledby="marcas-titulo">
    <div class="container cabecera">
      <h2 class="h2" id="marcas-titulo">{txt.marcas.titulo}</h2>
      <p class="prosa">{txt.marcas.prosa}</p>
    </div>
    <Marquesina items={marcasTira} variante="marcas" etiqueta={txt.marcas.titulo} duracion={52} />
  </section>

  <Banda
    foto={fotoSur}
    encuadre="centro"
    alto="apretada"
    id="cobertura"
    rotulo="cobertura-titulo"
    clase="banda-cobertura"
  >
    <div class="cobertura__cabecera">
      <h2 class="h2" id="cobertura-titulo">{txt.cobertura.titulo}</h2>
      <p class="prosa">{txt.cobertura.prosa}</p>
    </div>
  </Banda>

  <section class="section" aria-labelledby="faq-titulo">
    <div class="container">
      <div class="cabecera">
        <h2 class="h2" id="faq-titulo">{txt.faq.titulo}</h2>
        <p class="prosa">{txt.faq.prosa}</p>
      </div>
      <div class="faq-lista">
        <Faq items={faq} />
      </div>
    </div>
  </section>

  <BloqueContacto lang={lang} />
</Base>

<style>
  /* ---------- Portada ---------- */
  /* La marca <Portada> pone la foto y el velo. Aquí solo lo que va dentro. */
  .ventajas {
    display: grid;
    justify-items: start;
    gap: 0.4375rem;
    text-align: left;
  }

  @media (min-width: 55rem) {
    .ventajas {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem 1.75rem;
    }
  }

  .ventajas li {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 0.5rem;
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--ink-2);
  }

  .ventajas :global(svg) {
    margin-top: 0.15rem;
    color: var(--amarillo-texto);
    flex: none;
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }

  /* ---------- Servicios ---------- */
  .servicios {
    display: grid;
    gap: var(--s-4);
  }

  @media (min-width: 44rem) {
    .servicios {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 66rem) {
    .servicios {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Sin caja: foto, titular y texto sueltos sobre el fondo de la sección.
     La tarjeta con borde y esquinas redondas restaba seriedad. */
  .servicio__enlace {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .servicio__foto {
    display: block;
    overflow: hidden;
    background: var(--surface-2);
  }

  .servicio__foto :global(img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  .servicio__enlace:hover .servicio__foto :global(img) {
    transform: scale(1.05);
  }

  .servicio__cuerpo {
    display: grid;
    gap: 0.4375rem;
    align-content: start;
    padding-top: var(--s-4);
  }

  /* Solo las tarjetas que son enlace. La de "¿No sabes cuál te toca?" tiene el
     fondo azul, así que teñir su titular de azul lo hacía desaparecer. */
  .servicio__enlace .h3 {
    transition: color var(--t-rapido);
  }

  .servicio__enlace:hover .h3 {
    color: var(--azul);
  }

  .servicio__resumen {
    font-size: var(--fs-small);
    color: var(--ink-3);
  }

  .servicio__mas {
    margin-top: var(--s-2);
  }

  .servicio--cta {
    background: var(--azul);
  }

  .servicio__cta {
    display: grid;
    gap: var(--s-3);
    align-content: center;
    justify-items: start;
    height: 100%;
    padding: var(--s-6) var(--s-5);
  }

  .servicio--cta .h3 {
    color: var(--on-oscuro);
  }

  .servicio--cta .servicio__resumen {
    color: rgba(255, 255, 255, 0.86);
  }

  /* ---------- Para quién ---------- */
  .publicos {
    display: grid;
    gap: var(--s-4);
  }

  @media (min-width: 55rem) {
    .publicos {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--s-5);
    }
  }

  /* Sin caja ni icono en disco: una foto ancha y baja, el título y dos líneas.
     Ocupa mucho menos alto que la tarjeta que había antes. */
  .publico {
    display: grid;
    align-content: start;
    gap: 0.375rem;
  }

  .publico__foto {
    display: block;
    overflow: hidden;
    margin-bottom: var(--s-3);
    background: var(--surface-2);
  }

  /* 16/10 en vez de una franja muy estrecha: con 5/2 el recorte se comía tanto
     de la foto que en escritorio no se distinguía qué era. */
  .publico__foto :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .publico__titulo {
    font-size: 1.125rem;
  }

  .publico__texto {
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--ink-3);
  }

  /* ---------- Por qué fiarte ---------- */
  .pruebas {
    display: grid;
    gap: var(--s-5);
  }

  @media (min-width: 34rem) {
    .pruebas {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--s-5) var(--s-6);
    }
  }

  @media (min-width: 72rem) {
    .pruebas {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .prueba {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 0.875rem;
    align-items: start;
  }

  .prueba__icono {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    color: var(--amarillo);
  }

  .prueba__titulo {
    align-self: end;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--on-oscuro);
  }

  .prueba__texto {
    grid-column: 2;
    font-size: var(--fs-small);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.76);
  }

  /* ---------- Proceso ---------- */
  /* Dos columnas ya desde móvil ancho: cuatro pasos apilados ocupaban una
     pantalla entera para cuatro frases cortas. */
  .pasos {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-4) var(--s-4);
  }

  @media (min-width: 62rem) {
    .pasos {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--s-5);
    }
  }

  .paso {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    padding-top: 0.875rem;
    border-top: 2px solid var(--line);
  }

  .paso__numero {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--azul);
    font-variant-numeric: tabular-nums;
  }

  .paso__titulo {
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .paso__texto {
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--ink-3);
  }

  /* ---------- Cobertura ---------- */
  /* Va sobre la foto de la costa del sur, así que la sección entera cabe en
     una tira: titular, frase y los municipios en pastillas. Sin foto aparte. */
  /* Sin el listado de municipios: con decir que es todo el sur basta, y la
     tira baja a una sola línea de titular y frase. */
  .cobertura__cabecera {
    display: grid;
    justify-items: center;
    gap: var(--s-2);
    text-align: center;
  }

  .cobertura__cabecera :global(.prosa) {
    max-width: 52ch;
  }

  /* ---------- Preguntas ---------- */
  .faq-lista {
    max-width: 52rem;
    margin-inline: auto;
  }
</style>
