---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import Faq from '../components/Faq.astro';
import Marquesina from '../components/Marquesina.astro';
import HeroSlider from '../components/HeroSlider.astro';
import Ventajas from '../components/Ventajas.astro';
import TarjetaServicio from '../components/TarjetaServicio.astro';
import BloqueNosotros from '../components/BloqueNosotros.astro';
import Proceso from '../components/Proceso.astro';
import BloqueContacto from '../components/BloqueContacto.astro';
import Mapa from '../components/Mapa.astro';
import { marcas } from '../data/marcas';
import { FAQ } from '../data/faq';
import { empresa, telHref } from '../data/empresa';
import { ruta, type Idioma } from '../i18n/config';
import { t } from '../i18n/textos';
import { seo } from '../i18n/seo';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const txt = t(lang);
const meta = seo(lang).home;
const faq = FAQ[lang];

const servicios = (await getCollection('servicios'))
  .filter((s) => s.id.startsWith(`${lang}/`))
  .sort((a, b) => a.data.orden - b.data.orden);

const marcasTira = marcas.map((m) => ({ titulo: m.nombre, texto: m.para }));

const sitio = Astro.site!;
const jsonLd = [
  {
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.p,
      acceptedAnswer: { '@type': 'Answer', text: f.r },
    })),
  },
  {
    '@type': 'WebSite',
    name: empresa.razonSocial,
    url: sitio.href,
    publisher: { '@id': new URL('/#negocio', sitio).href },
  },
];
---

<Base lang={lang} titulo={meta.titulo} descripcion={meta.descripcion} jsonLd={jsonLd}>
  <HeroSlider lang={lang} />
  <Ventajas lang={lang} />

  <section class="section servicios" id="servicios" aria-labelledby="servicios-titulo">
    <div class="container">
      <div class="cabecera" data-anima>
        <h2 class="h2" id="servicios-titulo">{txt.servicios.titulo}</h2>
        <p class="prosa">{txt.servicios.prosa}</p>
      </div>

      <ul class="servicios__rejilla" data-anima="hijos">
        {
          servicios.map((s) => (
            <li>
              <TarjetaServicio
                lang={lang}
                id={s.id}
                titulo={s.data.titulo}
                resumen={s.data.resumen}
                icono={s.data.icono}
              />
            </li>
          ))
        }

        <li>
          <div class="tarjeta servicios__cta" data-brillo>
            <span class="pastilla pastilla--amarilla">
              <Icono nombre="telefono" tamano={22} />
            </span>
            <p class="h3">{txt.servicios.ctaTitulo}</p>
            <p class="servicios__cta-texto">{txt.servicios.ctaTexto}</p>
            <a class="btn btn--principal btn--bloque" href={telHref()}>
              <Icono nombre="telefono" tamano={17} />
              {txt.acciones.llamarA(empresa.telefono.display)}
            </a>
            <a class="enlace-flecha" href={ruta(lang, '/servicios/')}>
              {txt.acciones.verTodos}
              <Icono nombre="flecha" tamano={16} />
            </a>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <BloqueNosotros lang={lang} />
  <Proceso lang={lang} />

  <section class="section section--tight marcas" id="marcas" aria-labelledby="marcas-titulo">
    <div class="container cabecera" data-anima>
      <h2 class="h2" id="marcas-titulo">{txt.marcas.titulo}</h2>
      <p class="prosa">{txt.marcas.prosa}</p>
    </div>
    <Marquesina items={marcasTira} variante="marcas" etiqueta={txt.marcas.titulo} duracion={52} />
  </section>

  <section class="section section--surface" aria-labelledby="faq-titulo">
    <div class="container container--estrecho">
      <div class="cabecera" data-anima>
        <h2 class="h2" id="faq-titulo">{txt.faq.titulo}</h2>
        <p class="prosa">{txt.faq.prosa}</p>
      </div>
      <div data-anima>
        <Faq items={faq} />
      </div>
    </div>
  </section>

  <BloqueContacto lang={lang} />

  <section class="section section--surface">
    <div class="container">
      <Mapa lang={lang} />
    </div>
  </section>
</Base>

<style>
  .servicios__rejilla {
    display: grid;
    gap: var(--s-5);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
  }

  .servicios__rejilla > li {
    display: grid;
  }

  /* La tarjeta de llamada cierra la rejilla: con cinco servicios queda un
     hueco en la última fila, y dejarlo vacío es lo que hace que una retícula
     parezca a medio terminar. */
  .servicios__cta {
    /* .tarjeta ya es flex en columna: centrar aquí es cosa de justify-content
       (eje principal) y align-items (eje cruzado), no de propiedades de grid,
       que en un contenedor flex no hacen nada. */
    justify-content: center;
    align-items: center;
    text-align: center;
    gap: var(--s-3);
    padding: var(--s-5);
    background: var(--noche);
    border-color: transparent;
    color: var(--sobre-noche);
  }

  .servicios__cta .h3 {
    color: var(--on-oscuro);
  }

  .servicios__cta-texto {
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--sobre-noche);
  }

  .servicios__cta .enlace-flecha {
    color: var(--amarillo);
  }

  .marcas .cabecera {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
</style>
