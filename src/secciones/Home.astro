---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import Faq from '../components/Faq.astro';
import Valoracion from '../components/Valoracion.astro';
import Marquesina from '../components/Marquesina.astro';
import BloqueContacto from '../components/BloqueContacto.astro';
import { fotoDeServicio } from '../data/imagenes';
import { marcas } from '../data/marcas';
import { FAQ } from '../data/faq';
import { empresa, telHref, waHref } from '../data/empresa';
import { ruta, type Idioma } from '../i18n/config';
import { t } from '../i18n/textos';
import { seo } from '../i18n/seo';

import fotoAntena from '../assets/antena-tejado.jpg';
import fotoTenerife from '../assets/hero-sur-tenerife.jpg';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const txt = t(lang);
const meta = seo(lang).home;
const faq = FAQ[lang];

const servicios = (await getCollection('servicios'))
  .filter((s) => s.id.startsWith(`${lang}/`))
  .sort((a, b) => a.data.orden - b.data.orden);

const iconosConfianza = ['euro', 'documento', 'escudo', 'mapa'] as const;
const iconosPublicos = ['internet', 'red', 'satelite'] as const;
const iconosPruebas = ['documento', 'escudo', 'check', 'euro', 'herramienta', 'telefono'] as const;

const datosTira = txt.confianza.map((c, i) => ({
  titulo: c.dato,
  texto: c.texto,
  icono: iconosConfianza[i],
}));

const marcasTira = marcas.map((m) => ({ titulo: m.nombre, texto: m.para }));

const sitio = Astro.site!;
const jsonLd = [
  {
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.p,
      acceptedAnswer: { '@type': 'Answer', text: f.r },
    })),
  },
  {
    '@type': 'WebSite',
    name: empresa.razonSocial,
    url: sitio.href,
    publisher: { '@id': new URL('/#negocio', sitio).href },
  },
];
---

<Base lang={lang} titulo={meta.titulo} descripcion={meta.descripcion} jsonLd={jsonLd}>
  <section class="hero">
    <div class="hero__fondo">
      <Image
        src={fotoAntena}
        alt="Antena de televisión instalada en el tejado de una vivienda del sur de Tenerife"
        widths={[900, 1400, 2000, 2600]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        quality={82}
      />
    </div>

    <div class="container hero__contenido">
      <h1 class="display-xl">{txt.hero.titulo}</h1>
      <p class="lede">{txt.hero.lede}</p>

      <ul class="hero__ventajas">
        {
          txt.hero.ventajas.map((v) => (
            <li>
              <Icono nombre="check" tamano={17} />
              {v}
            </li>
          ))
        }
      </ul>

      <div class="hero__acciones">
        <a class="btn btn--principal btn--lg" href={telHref()}>
          <Icono nombre="telefono" tamano={18} />
          {txt.acciones.llamarA(empresa.telefono.display)}
        </a>
        <a class="btn btn--azul btn--lg" href={waHref(lang)} rel="noopener noreferrer">
          <Icono nombre="whatsapp" tamano={18} />
          {txt.acciones.whatsapp}
        </a>
      </div>

      <Valoracion lang={lang} />
    </div>
  </section>

  <section class="franja" aria-label={txt.contacto.datosEmpresa}>
    <Marquesina items={datosTira} etiqueta={txt.contacto.datosEmpresa} duracion={38} />
  </section>

  <section class="section" aria-labelledby="publicos-titulo">
    <div class="container">
      <div class="cabecera">
        <h2 class="h2" id="publicos-titulo">{txt.publicos.titulo}</h2>
        <p class="prosa">{txt.publicos.prosa}</p>
      </div>

      <ul class="publicos">
        {
          txt.publicos.items.map((p, i) => (
            <li class="publico">
              <span class="publico__icono">
                <Icono nombre={iconosPublicos[i]} tamano={26} />
              </span>
              <h3 class="h3">{p.titulo}</h3>
              <p class="publico__texto">{p.texto}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--surface" id="servicios" aria-labelledby="servicios-titulo">
    <div class="container">
      <div class="cabecera">
        <h2 class="h2" id="servicios-titulo">{txt.servicios.titulo}</h2>
        <p class="prosa">{txt.servicios.prosa}</p>
      </div>

      <ul class="servicios">
        {
          servicios.map((s) => {
            const slug = s.id.split('/')[1];
            return (
              <li class="servicio">
                <a class="servicio__enlace" href={ruta(lang, `/servicios/${slug}/`)}>
                  <span class="servicio__foto">
                    <Image
                      src={fotoDeServicio(s.id)}
                      alt={s.data.corto}
                      widths={[360, 540, 720]}
                      sizes="(min-width: 66rem) 21rem, (min-width: 44rem) 45vw, 100vw"
                      loading="lazy"
                    />
                  </span>
                  <span class="servicio__cuerpo">
                    <span class="servicio__icono">
                      <Icono nombre={s.data.icono} tamano={20} />
                    </span>
                    <span class="h3">{s.data.titulo}</span>
                    <span class="servicio__resumen">{s.data.resumen}</span>
                    <span class="enlace-flecha servicio__mas">
                      {txt.acciones.verServicio}
                      <Icono nombre="flecha" tamano={16} />
                    </span>
                  </span>
                </a>
              </li>
            );
          })
        }

        <li class="servicio servicio--cta">
          <div class="servicio__cta">
            <h3 class="h3">{txt.servicios.ctaTitulo}</h3>
            <p class="servicio__resumen">{txt.servicios.ctaTexto}</p>
            <a class="btn btn--principal" href={telHref()}>
              <Icono nombre="telefono" tamano={17} />
              {txt.acciones.llamarA(empresa.telefono.display)}
            </a>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="proceso-titulo">
    <div class="container">
      <div class="cabecera">
        <h2 class="h2" id="proceso-titulo">{txt.pasos.titulo}</h2>
      </div>

      <ol class="pasos">
        {
          txt.pasos.items.map((p, i) => (
            <li class="paso">
              <span class="paso__numero">{String(i + 1).padStart(2, '0')}</span>
              <span class="paso__cuerpo">
                <strong class="paso__titulo">{p.titulo}</strong>
                <span class="paso__texto">{p.texto}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="pruebas-titulo">
    <div class="container">
      <div class="cabecera">
        <h2 class="h2" id="pruebas-titulo">{txt.pruebas.titulo}</h2>
      </div>

      <ul class="pruebas">
        {
          txt.pruebas.items.map((p, i) => (
            <li class="prueba">
              <span class="prueba__icono"><Icono nombre={iconosPruebas[i]} tamano={19} /></span>
              <strong class="prueba__titulo">{p.titulo}</strong>
              <span class="prueba__texto">{p.texto}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--tight" id="marcas" aria-labelledby="marcas-titulo">
    <div class="container cabecera">
      <h2 class="h2" id="marcas-titulo">{txt.marcas.titulo}</h2>
      <p class="prosa">{txt.marcas.prosa}</p>
    </div>
    <Marquesina items={marcasTira} variante="marcas" etiqueta={txt.marcas.titulo} duracion={52} />
  </section>

  <section class="section section--surface" id="cobertura" aria-labelledby="cobertura-titulo">
    <div class="container cobertura__rejilla">
      <div>
        <div class="cabecera">
          <h2 class="h2" id="cobertura-titulo">{txt.cobertura.titulo}</h2>
          <p class="prosa">{txt.cobertura.prosa}</p>
        </div>
        <ul class="cobertura">
          {empresa.cobertura.map((m) => <li>{m}</li>)}
        </ul>
      </div>

      <figure class="cobertura__foto">
        <Image
          src={fotoTenerife}
          alt="Pueblo costero del sur de Tenerife visto desde lo alto"
          widths={[400, 600, 820]}
          sizes="(min-width: 62rem) 24rem, 100vw"
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="opiniones-titulo">
    <div class="container">
      <div class="cabecera">
        <h2 class="h2" id="opiniones-titulo">{txt.opiniones.titulo}</h2>
      </div>
      <ul class="opiniones">
        {
          [0, 1, 2].map(() => (
            <li class="opinion">
              <span class="opinion__estrellas" role="img" aria-label={txt.opiniones.valoracion}>
                {[0, 1, 2, 3, 4].map(() => <Icono nombre="estrella" tamano={16} />)}
              </span>
              <blockquote>
                [{lang === 'es'
                  ? 'Opinión del cliente, dos o tres líneas'
                  : lang === 'en'
                    ? 'Customer review, two or three lines'
                    : 'Kundenstimme, zwei bis drei Zeilen'}]
              </blockquote>
              <footer class="opinion__firma">[—]</footer>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-titulo">
    <div class="container">
      <div class="cabecera">
        <h2 class="h2" id="faq-titulo">{txt.faq.titulo}</h2>
        <p class="prosa">{txt.faq.prosa}</p>
      </div>
      <div class="faq-lista">
        <Faq items={faq} />
      </div>
    </div>
  </section>

  <BloqueContacto lang={lang} />
</Base>

<style>
  /* ---------- Portada ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: min(46rem, 94svh);
    padding-block: clamp(2rem, 4vw, 3rem);
    overflow: hidden;
  }

  .hero__fondo {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero__fondo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* En estrecho la foto se recorta por los lados, así que manda la x. */
    object-position: 42% 50%;
  }

  @media (min-width: 55rem) {
    .hero__fondo :global(img) {
      object-position: 50% 64%;
    }
  }

  /* Velo claro que sube desde abajo: arriba se ve la antena contra el cielo y
     el texto se apoya en blanco. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        58% 46% at 50% 62%,
        rgba(255, 255, 255, 0.97) 0%,
        rgba(255, 255, 255, 0.9) 46%,
        rgba(255, 255, 255, 0) 100%
      ),
      linear-gradient(
        to bottom,
        rgba(255, 255, 255, 0) 0%,
        rgba(255, 255, 255, 0.2) 26%,
        rgba(255, 255, 255, 0.72) 58%,
        rgba(255, 255, 255, 0.97) 80%,
        var(--paper) 94%
      );
  }

  .hero__contenido {
    display: grid;
    justify-items: center;
    gap: var(--s-4);
    text-align: center;
  }

  .hero .display-xl {
    max-width: 19ch;
  }

  .hero .lede {
    max-width: 54ch;
  }

  /* En estrecho cada ventaja ocupa su línea: en fila se partían por la mitad. */
  .hero__ventajas {
    display: grid;
    justify-items: start;
    gap: 0.4375rem;
    text-align: left;
  }

  @media (min-width: 55rem) {
    .hero__ventajas {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem 1.5rem;
    }
  }

  .hero__ventajas li {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 0.5rem;
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--ink-2);
  }

  .hero__ventajas svg {
    margin-top: 0.15rem;
  }

  .hero__ventajas svg {
    color: var(--amarillo-texto);
    flex: none;
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__contenido > * {
      animation: entrar 760ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
    }

    .hero__contenido > *:nth-child(2) { animation-delay: 80ms; }
    .hero__contenido > *:nth-child(3) { animation-delay: 150ms; }
    .hero__contenido > *:nth-child(4) { animation-delay: 215ms; }
    .hero__contenido > *:nth-child(5) { animation-delay: 275ms; }

    @keyframes entrar {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
    }
  }

  /* ---------- Tiras ---------- */
  .franja {
    padding-block: var(--s-4);
    background: var(--paper);
    border-block: var(--hairline);
  }

  /* ---------- Segmentos ---------- */
  .publicos {
    display: grid;
    gap: var(--s-5);
  }

  @media (min-width: 55rem) {
    .publicos {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--s-6);
    }
  }

  .publico {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 0.75rem;
    padding-top: var(--s-5);
    border-top: 3px solid var(--azul);
    text-align: center;
  }

  .publico__icono {
    color: var(--amarillo-texto);
  }

  .publico__texto {
    font-size: var(--fs-small);
    max-width: 34ch;
  }

  /* ---------- Servicios ---------- */
  .servicios {
    display: grid;
    gap: var(--s-4);
  }

  @media (min-width: 44rem) {
    .servicios {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 66rem) {
    .servicios {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .servicio {
    background: var(--paper);
    border: var(--hairline);
    border-radius: var(--r-lg);
    overflow: hidden;
    transition: box-shadow var(--t-rapido), transform var(--t-rapido),
      border-color var(--t-rapido);
  }

  .servicio:hover {
    border-color: var(--azul);
    box-shadow: var(--sombra-alta);
    transform: translateY(-3px);
  }

  .servicio__enlace {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .servicio__foto {
    display: block;
    overflow: hidden;
  }

  .servicio__foto :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform var(--t-medio);
  }

  .servicio:hover .servicio__foto :global(img) {
    transform: scale(1.04);
  }

  .servicio__cuerpo {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: var(--s-4) var(--s-5) var(--s-5);
  }

  .servicio__icono {
    color: var(--azul);
  }

  .servicio__resumen {
    font-size: var(--fs-small);
    color: var(--ink-2);
  }

  .servicio__mas {
    margin-top: var(--s-2);
  }

  .servicio--cta {
    background: var(--azul);
    border-color: var(--azul);
  }

  .servicio__cta {
    display: grid;
    gap: var(--s-3);
    align-content: center;
    justify-items: start;
    height: 100%;
    padding: var(--s-5);
  }

  .servicio--cta .h3 {
    color: var(--on-oscuro);
  }

  .servicio--cta .servicio__resumen {
    color: rgba(255, 255, 255, 0.86);
  }

  /* ---------- Proceso ---------- */
  .pasos {
    display: grid;
    gap: var(--s-6) var(--s-5);
  }

  @media (min-width: 44rem) {
    .pasos {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 66rem) {
    .pasos {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .paso {
    display: flex;
    align-items: flex-start;
    gap: var(--s-3);
    padding-top: var(--s-4);
    border-top: 3px solid var(--azul);
  }

  .paso__numero {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1;
    color: var(--azul);
    flex: none;
  }

  .paso__cuerpo {
    display: grid;
    gap: 0.3125rem;
  }

  .paso__titulo {
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink);
  }

  .paso__texto {
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--ink-3);
  }

  /* ---------- Confianza ---------- */
  .pruebas {
    display: grid;
    gap: var(--s-5);
  }

  @media (min-width: 48rem) {
    .pruebas {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--s-6) var(--s-7);
    }
  }

  @media (min-width: 72rem) {
    .pruebas {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .prueba {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.375rem 0.875rem;
    align-items: baseline;
  }

  /* El color va en el icono, dentro de su pastilla, no en un borde. */
  .prueba__icono {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--amarillo-tinte);
    color: var(--amarillo-texto);
    align-self: start;
  }

  .prueba__titulo {
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink);
  }

  .prueba__texto {
    grid-column: 2;
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--ink-3);
  }

  /* ---------- Cobertura ---------- */
  .cobertura__rejilla {
    display: grid;
    gap: var(--s-6);
  }

  @media (min-width: 62rem) {
    .cobertura__rejilla {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.55fr);
      gap: var(--s-7);
      align-items: center;
    }
  }

  .cobertura {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: 0.25rem 1rem;
  }

  .cobertura li {
    position: relative;
    padding-left: 1rem;
    font-size: var(--fs-small);
    color: var(--ink-2);
  }

  .cobertura li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7rem;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--azul);
  }

  .cobertura__foto {
    margin: 0;
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--sombra);
  }

  .cobertura__foto :global(img) {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  /* ---------- Opiniones ---------- */
  .opiniones {
    display: grid;
    gap: var(--s-5);
  }

  @media (min-width: 55rem) {
    .opiniones {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .opinion {
    display: grid;
    gap: var(--s-4);
    align-content: start;
    padding: var(--s-6) var(--s-5);
    background: var(--paper);
    border: var(--hairline);
    border-radius: var(--r-lg);
  }

  .opinion__estrellas {
    display: inline-flex;
    gap: 0.125rem;
    color: var(--amarillo);
  }

  .opinion__estrellas :global(svg) {
    fill: currentColor;
  }

  .opinion blockquote {
    margin: 0;
    font-size: var(--fs-small);
    color: var(--ink-2);
  }

  .opinion__firma {
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--ink);
  }

  /* ---------- Preguntas ---------- */
  .faq-lista {
    max-width: 52rem;
    margin-inline: auto;
  }
</style>
