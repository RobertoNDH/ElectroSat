---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import Faq from '../components/Faq.astro';
import Valoracion from '../components/Valoracion.astro';
import Marquesina from '../components/Marquesina.astro';
import Portada from '../components/Portada.astro';
import BloqueContacto from '../components/BloqueContacto.astro';
import { fotoDeServicio } from '../data/imagenes';
import { marcas } from '../data/marcas';
import { FAQ } from '../data/faq';
import { empresa, telHref, waHref } from '../data/empresa';
import { ruta, type Idioma } from '../i18n/config';
import { t } from '../i18n/textos';
import { seo } from '../i18n/seo';

import fotoAntena from '../assets/antena-tejado.jpg';
import fotoSur from '../assets/cobertura-sur.jpg';
import fotoEdificio from '../assets/edificio.jpg';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const txt = t(lang);
const meta = seo(lang).home;
const faq = FAQ[lang];

const servicios = (await getCollection('servicios'))
  .filter((s) => s.id.startsWith(`${lang}/`))
  .sort((a, b) => a.data.orden - b.data.orden);

const iconosPublicos = ['internet', 'red', 'satelite'] as const;
const iconosPruebas = ['documento', 'escudo', 'check', 'euro', 'herramienta', 'telefono'] as const;

const marcasTira = marcas.map((m) => ({ titulo: m.nombre, texto: m.para }));

const sitio = Astro.site!;
const jsonLd = [
  {
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.p,
      acceptedAnswer: { '@type': 'Answer', text: f.r },
    })),
  },
  {
    '@type': 'WebSite',
    name: empresa.razonSocial,
    url: sitio.href,
    publisher: { '@id': new URL('/#negocio', sitio).href },
  },
];
---

<Base lang={lang} titulo={meta.titulo} descripcion={meta.descripcion} jsonLd={jsonLd}>
  <Portada
    titulo={txt.hero.titulo}
    texto={txt.hero.lede}
    foto={fotoAntena}
    alt="Antena de televisión instalada en el tejado de una vivienda del sur de Tenerife"
    alto="alta"
    principal
    encuadre="alto"

  >
    <ul class="ventajas">
      {
        txt.hero.ventajas.map((v) => (
          <li>
            <Icono nombre="check" tamano={17} />
            {v}
          </li>
        ))
      }
    </ul>

    <div class="acciones">
      <a class="btn btn--principal btn--lg" href={telHref()}>
        <Icono nombre="telefono" tamano={18} />
        {txt.acciones.llamarA(empresa.telefono.display)}
      </a>
      <a class="btn btn--azul btn--lg" href={waHref(lang)} rel="noopener noreferrer">
        <Icono nombre="whatsapp" tamano={18} />
        {txt.acciones.whatsapp}
      </a>
    </div>

    <Valoracion lang={lang} />
  </Portada>

  <section class="section section--surface" id="servicios" aria-labelledby="servicios-titulo">
    <div class="container">
      <div class="cabecera">
        <h2 class="h2" id="servicios-titulo">{txt.servicios.titulo}</h2>
        <p class="prosa">{txt.servicios.prosa}</p>
      </div>

      <ul class="servicios">
        {
          servicios.map((s) => {
            const slug = s.id.split('/')[1];
            return (
              <li class="servicio">
                <a class="servicio__enlace" href={ruta(lang, `/servicios/${slug}/`)}>
                  <span class="servicio__foto">
                    <Image
                      src={fotoDeServicio(s.id)}
                      alt={s.data.corto}
                      widths={[400, 600, 800]}
                      sizes="(min-width: 66rem) 22rem, (min-width: 44rem) 45vw, 100vw"
                      loading="lazy"
                    />
                  </span>
                  <span class="servicio__cuerpo">
                    <span class="h3">{s.data.titulo}</span>
                    <span class="servicio__resumen">{s.data.resumen}</span>
                    <span class="enlace-flecha servicio__mas">
                      {txt.acciones.verServicio}
                      <Icono nombre="flecha" tamano={16} />
                    </span>
                  </span>
                </a>
              </li>
            );
          })
        }

        <li class="servicio servicio--cta">
          <div class="servicio__cta">
            <span class="h3">{txt.servicios.ctaTitulo}</span>
            <span class="servicio__resumen">{txt.servicios.ctaTexto}</span>
            <a class="btn btn--principal" href={telHref()}>
              <Icono nombre="telefono" tamano={17} />
              {txt.acciones.llamarA(empresa.telefono.display)}
            </a>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="publicos-titulo">
    <div class="container">
      <div class="cabecera">
        <h2 class="h2" id="publicos-titulo">{txt.publicos.titulo}</h2>
        <p class="prosa">{txt.publicos.prosa}</p>
      </div>

      <ul class="publicos">
        {
          txt.publicos.items.map((p, i) => (
            <li class="publico">
              <span class="publico__icono">
                <Icono nombre={iconosPublicos[i]} tamano={26} />
              </span>
              <h3 class="h3">{p.titulo}</h3>
              <p class="publico__texto">{p.texto}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="proceso-titulo">
    <div class="container">
      <div class="cabecera">
        <h2 class="h2" id="proceso-titulo">{txt.pasos.titulo}</h2>
      </div>

      <ol class="pasos">
        {
          txt.pasos.items.map((p, i) => (
            <li class="paso">
              <span class="paso__numero">{String(i + 1).padStart(2, '0')}</span>
              <strong class="paso__titulo">{p.titulo}</strong>
              <span class="paso__texto">{p.texto}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="pruebas-banda" aria-labelledby="pruebas-titulo">
    <div class="pruebas-banda__fondo">
      <Image
        src={fotoEdificio}
        alt=""
        widths={[900, 1400, 2000, 2400]}
        sizes="100vw"
        loading="lazy"
      />
    </div>

    <div class="container">
      <div class="cabecera cabecera--oscura">
        <h2 class="h2" id="pruebas-titulo">{txt.pruebas.titulo}</h2>
      </div>

      <ul class="pruebas">
        {
          txt.pruebas.items.map((p, i) => (
            <li class="prueba">
              <span class="prueba__icono">
                <Icono nombre={iconosPruebas[i]} tamano={19} />
              </span>
              <strong class="prueba__titulo">{p.titulo}</strong>
              <span class="prueba__texto">{p.texto}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--tight" id="marcas" aria-labelledby="marcas-titulo">
    <div class="container cabecera">
      <h2 class="h2" id="marcas-titulo">{txt.marcas.titulo}</h2>
      <p class="prosa">{txt.marcas.prosa}</p>
    </div>
    <Marquesina items={marcasTira} variante="marcas" etiqueta={txt.marcas.titulo} duracion={52} />
  </section>

  <section class="section section--surface" id="cobertura" aria-labelledby="cobertura-titulo">
    <div class="container">
      <div class="cabecera">
        <h2 class="h2" id="cobertura-titulo">{txt.cobertura.titulo}</h2>
        <p class="prosa">{txt.cobertura.prosa}</p>
      </div>

      <ul class="cobertura">
        {empresa.cobertura.map((m) => <li>{m}</li>)}
      </ul>

      <figure class="cobertura__foto">
        <Image
          src={fotoSur}
          alt="Costa del sur de Tenerife vista desde lo alto"
          widths={[800, 1200, 1800, 2400]}
          sizes="(min-width: 62rem) 60rem, 100vw"
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-titulo">
    <div class="container">
      <div class="cabecera">
        <h2 class="h2" id="faq-titulo">{txt.faq.titulo}</h2>
        <p class="prosa">{txt.faq.prosa}</p>
      </div>
      <div class="faq-lista">
        <Faq items={faq} />
      </div>
    </div>
  </section>

  <BloqueContacto lang={lang} />
</Base>

<style>
  /* ---------- Portada ---------- */
  /* La marca <Portada> pone la foto y el velo. Aquí solo lo que va dentro. */
  .ventajas {
    display: grid;
    justify-items: start;
    gap: 0.4375rem;
    text-align: left;
  }

  @media (min-width: 55rem) {
    .ventajas {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem 1.75rem;
    }
  }

  .ventajas li {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 0.5rem;
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--ink-2);
  }

  .ventajas :global(svg) {
    margin-top: 0.15rem;
    color: var(--amarillo-texto);
    flex: none;
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }

  /* ---------- Servicios ---------- */
  .servicios {
    display: grid;
    gap: var(--s-4);
  }

  @media (min-width: 44rem) {
    .servicios {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 66rem) {
    .servicios {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .servicio {
    background: var(--paper);
    border: var(--hairline);
    border-radius: var(--r-lg);
    overflow: hidden;
    transition: box-shadow var(--t-rapido), transform var(--t-rapido),
      border-color var(--t-rapido);
  }

  .servicio:hover {
    border-color: var(--azul);
    box-shadow: var(--sombra-alta);
    transform: translateY(-3px);
  }

  .servicio__enlace {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .servicio__foto {
    display: block;
    overflow: hidden;
  }

  .servicio__foto :global(img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: transform var(--t-medio);
  }

  .servicio:hover .servicio__foto :global(img) {
    transform: scale(1.04);
  }

  .servicio__cuerpo {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: var(--s-5);
  }

  .servicio__resumen {
    font-size: var(--fs-small);
    color: var(--ink-3);
  }

  .servicio__mas {
    margin-top: var(--s-2);
  }

  .servicio--cta {
    background: var(--azul);
    border-color: var(--azul);
  }

  .servicio--cta:hover {
    border-color: var(--azul-osc);
  }

  .servicio__cta {
    display: grid;
    gap: var(--s-3);
    align-content: center;
    justify-items: start;
    height: 100%;
    padding: var(--s-6) var(--s-5);
  }

  .servicio--cta .h3 {
    color: var(--on-oscuro);
  }

  .servicio--cta .servicio__resumen {
    color: rgba(255, 255, 255, 0.86);
  }

  /* ---------- Para quién ---------- */
  .publicos {
    display: grid;
    gap: var(--s-5);
  }

  @media (min-width: 55rem) {
    .publicos {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--s-6);
    }
  }

  .publico {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 0.625rem;
    padding: var(--s-6) var(--s-5);
    background: var(--surface);
    border-radius: var(--r-lg);
    text-align: center;
  }

  .publico__icono {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    margin-bottom: var(--s-2);
    border-radius: 50%;
    background: var(--paper);
    color: var(--azul);
  }

  .publico__texto {
    font-size: var(--fs-small);
    color: var(--ink-3);
    max-width: 32ch;
  }

  /* ---------- Proceso ---------- */
  /* Secuencia numerada: el número manda y una línea fina une los pasos. */
  .pasos {
    display: grid;
    gap: var(--s-5);
    counter-reset: paso;
  }

  @media (min-width: 44rem) {
    .pasos {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--s-6) var(--s-5);
    }
  }

  @media (min-width: 66rem) {
    .pasos {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .paso {
    display: grid;
    align-content: start;
    gap: 0.375rem;
    padding-top: var(--s-4);
    border-top: 2px solid var(--line);
  }

  .paso__numero {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--azul);
    font-variant-numeric: tabular-nums;
  }

  .paso__titulo {
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .paso__texto {
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--ink-3);
  }

  /* ---------- Por qué fiarte: banda con foto ---------- */
  /* Único corte oscuro de la página. Rompe la alternancia blanco/gris y da
     aire de portada a la parte que más pesa para decidirse. */
  .pruebas-banda {
    position: relative;
    isolation: isolate;
    padding-block: clamp(3.25rem, 6vw, 5rem);
    overflow: hidden;
  }

  .pruebas-banda__fondo {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: var(--ink);
  }

  .pruebas-banda__fondo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
  }

  .pruebas-banda::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to bottom,
      rgba(9, 20, 28, 0.9) 0%,
      rgba(9, 20, 28, 0.84) 55%,
      rgba(9, 20, 28, 0.92) 100%
    );
  }

  .cabecera--oscura :global(.h2) {
    color: var(--on-oscuro);
  }

  .pruebas {
    display: grid;
    gap: var(--s-5);
  }

  @media (min-width: 48rem) {
    .pruebas {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--s-5) var(--s-7);
    }
  }

  @media (min-width: 72rem) {
    .pruebas {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .prueba {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 0.875rem;
    align-items: start;
  }

  .prueba__icono {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    color: var(--amarillo);
  }

  .prueba__titulo {
    align-self: end;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--on-oscuro);
  }

  .prueba__texto {
    grid-column: 2;
    font-size: var(--fs-small);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.76);
  }

  /* ---------- Cobertura ---------- */
  /* Pastillas centradas: se leen igual de bien a 390px que a 1440px y no
     dejan la lista pegada al margen izquierdo en móvil. */
  .cobertura {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    max-width: 56rem;
    margin-inline: auto;
  }

  .cobertura li {
    padding: 0.4375rem 0.9375rem;
    background: var(--paper);
    border: var(--hairline);
    border-radius: 100px;
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--ink-2);
  }

  .cobertura__foto {
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--sombra);
  }

  .cobertura__foto :global(img) {
    width: 100%;
    aspect-ratio: 21 / 9;
    object-fit: cover;
  }

  @media (max-width: 43.99rem) {
    .cobertura__foto :global(img) {
      aspect-ratio: 3 / 2;
    }
  }

  /* ---------- Preguntas ---------- */
  .faq-lista {
    max-width: 52rem;
    margin-inline: auto;
  }
</style>
