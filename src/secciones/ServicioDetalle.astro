---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import Faq from '../components/Faq.astro';
import Portada from '../components/Portada.astro';
import Banda from '../components/Banda.astro';
import BloqueContacto from '../components/BloqueContacto.astro';
import DiagramaPortal from '../components/DiagramaPortal.astro';
import fotoCasos from '../assets/portada-servicios.jpg';
import { fotoDeServicio } from '../data/imagenes';
import { empresa, telHref, waHref } from '../data/empresa';
import { ruta, type Idioma } from '../i18n/config';
import { t } from '../i18n/textos';

interface Props {
  lang: Idioma;
  servicio: CollectionEntry<'servicios'>;
}
const { lang, servicio } = Astro.props;
const { data } = servicio;
const { Content } = await render(servicio);
const slug = servicio.id.split('/')[1];
const txt = t(lang);

const otros = (await getCollection('servicios'))
  .filter((s) => s.id.startsWith(`${lang}/`) && s.id !== servicio.id)
  .sort((a, b) => a.data.orden - b.data.orden);

const sitio = Astro.site!;
const url = new URL(Astro.url.pathname, sitio).href;

const jsonLd = [
  {
    '@type': 'Service',
    name: data.titulo,
    description: data.descripcion,
    url,
    provider: { '@id': new URL('/#negocio', sitio).href },
    areaServed: { '@type': 'AdministrativeArea', name: 'Tenerife Sur' },
  },
  {
    '@type': 'FAQPage',
    mainEntity: data.faq.map((f) => ({
      '@type': 'Question',
      name: f.p,
      acceptedAnswer: { '@type': 'Answer', text: f.r },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: txt.nav.inicio, item: new URL(ruta(lang, '/'), sitio).href },
      {
        '@type': 'ListItem',
        position: 2,
        name: txt.nav.servicios,
        item: new URL(ruta(lang, '/servicios/'), sitio).href,
      },
      { '@type': 'ListItem', position: 3, name: data.corto, item: url },
    ],
  },
];
---

<Base lang={lang} titulo={data.tituloSeo} descripcion={data.descripcion} jsonLd={jsonLd}>
  <nav class="miga" aria-label={txt.nav.inicio}>
    <ol class="container">
      <li><a href={ruta(lang, '/')}>{txt.nav.inicio}</a></li>
      <li><a href={ruta(lang, '/servicios/')}>{txt.nav.servicios}</a></li>
      <li aria-current="page">{data.corto}</li>
    </ol>
  </nav>

  <Portada
    titulo={data.titulo}
    texto={data.entradilla}
    etiqueta={txt.nav.servicios}
    foto={fotoDeServicio(servicio.id)}
    alt={data.corto}
    encuadre="centro"
  >
    <div class="portada__acciones">
      <a class="btn btn--principal btn--lg" href={telHref()}>
        <Icono nombre="telefono" tamano={18} />
        {txt.acciones.llamarA(empresa.telefono.display)}
      </a>
      <a class="btn btn--azul btn--lg" href={waHref(lang)} rel="noopener noreferrer">
        <Icono nombre="whatsapp" tamano={18} />
        {txt.acciones.whatsapp}
      </a>
    </div>
  </Portada>

  <section class="section section--tight">
    <div class="container">
      <div class="prosa detalle__texto">
        <Content />
      </div>

      <div class="incluye">
        <h2 class="incluye__titulo">
          {lang === 'es'
            ? 'Qué incluye el trabajo'
            : lang === 'en'
              ? "What the job includes"
              : 'Was die Arbeit umfasst'}
        </h2>
        <ul class="incluye__lista">
          {
            data.incluye.map((linea) => (
              <li>
                <span class="incluye__marca">
                  <Icono nombre="check" tamano={15} />
                </span>
                {linea}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {
    slug === 'internet-comunitario' && (
      <section class="section section--surface" aria-labelledby="diagrama-titulo">
        <div class="container diagrama__rejilla">
          <div class="diagrama__caja">
            <DiagramaPortal />
          </div>
          <div class="diagrama__texto">
            <h2 class="h2" id="diagrama-titulo">
              {lang === 'es'
                ? 'Así llega a cada vivienda'
                : lang === 'en'
                  ? 'How it reaches every flat'
                  : 'So kommt es in jede Wohnung'}
            </h2>
            <p class="prosa">
              {lang === 'es'
                ? 'Desde la azotea baja una sola línea por el edificio y de ahí sale una toma a cada vivienda. Es el cable que ya está puesto, así que no hay obra.'
                : lang === 'en'
                  ? 'A single line runs down from the roof through the building, feeding one socket in each flat. It uses the cabling already in place, so there is no building work.'
                  : 'Vom Dach führt eine einzige Leitung durch das Haus und versorgt in jeder Wohnung eine Dose. Genutzt wird die vorhandene Verkabelung, Bauarbeiten entfallen.'}
            </p>
          </div>
        </div>
      </section>
    )
  }

  <Banda foto={fotoCasos} encuadre="bajo" rotulo="publico-titulo">
    <div class="cabecera">
      <h2 class="h2" id="publico-titulo">
        {lang === 'es'
          ? 'Según tu caso'
          : lang === 'en'
            ? 'Depending on your case'
            : 'Je nach Fall'}
      </h2>
    </div>

    <ul class="casos">
      {
        data.publico.map((p) => (
          <li class="caso">
            <h3 class="h3">{p.tipo}</h3>
            <p>{p.texto}</p>
          </li>
        ))
      }
    </ul>

    {
      data.marcas.length > 0 && (
        <p class="marcas-linea">
          <Icono nombre="herramienta" tamano={17} />
          <span>{data.marcas.join(' · ')}</span>
        </p>
      )
    }
  </Banda>

  <section class="section section--surface" aria-labelledby="faq-servicio">
    <div class="container">
      <div class="cabecera">
        <h2 class="h2" id="faq-servicio">{data.corto}</h2>
      </div>
      <div class="faq-lista">
        <Faq items={data.faq} />
      </div>
    </div>
  </section>

  <BloqueContacto lang={lang} />

  <section class="section section--tight otros">
    <div class="container">
      <h2 class="otros__titulo">{txt.nav.todosServicios}</h2>
      <ul class="otros__lista">
        {
          otros.map((o) => (
            <li>
              <a href={ruta(lang, `/servicios/${o.id.split('/')[1]}/`)}>
                <Icono nombre={o.data.icono} tamano={20} />
                <span>{o.data.corto}</span>
                <Icono nombre="flecha" tamano={16} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .miga {
    background: var(--surface);
    border-bottom: var(--hairline);
  }

  .miga ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-block: 0.75rem;
    font-size: 0.8125rem;
    color: var(--ink-3);
  }

  .miga li + li::before {
    content: '/';
    margin-right: 0.5rem;
    color: var(--control);
  }

  .miga a {
    color: var(--ink-2);
    text-decoration: none;
  }

  .miga a:hover {
    color: var(--azul);
    text-decoration: underline;
  }

  .portada__acciones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }

  /* Texto a una columna centrada: antes iba a la izquierda y dejaba un hueco
     enorme debajo. */
  .detalle__texto {
    max-width: 60ch;
    margin-inline: auto;
    text-align: center;
  }

  .incluye {
    margin-top: clamp(2rem, 4vw, 3rem);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--surface);
    border: var(--hairline);
    border-radius: var(--r-lg);
  }

  .incluye__titulo {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    text-align: center;
    color: var(--ink);
  }

  .incluye__lista {
    display: grid;
    gap: 0.875rem var(--s-6);
    margin-top: var(--s-5);
  }

  @media (min-width: 48rem) {
    .incluye__lista {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .incluye__lista li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    align-items: start;
    font-size: var(--fs-small);
    color: var(--ink-2);
  }

  /* La marca de la lista es solo el visto, sin disco detrás: igual que las
     ventajas de la portada. */
  .incluye__marca {
    display: grid;
    place-items: center;
    margin-top: 0.2rem;
    color: var(--amarillo-texto);
    flex: none;
  }

  .diagrama__rejilla {
    display: grid;
    gap: var(--s-5);
    align-items: center;
  }

  @media (min-width: 62rem) {
    .diagrama__rejilla {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: var(--s-7);
    }
  }

  .diagrama__caja {
    padding: var(--s-4);
    background: var(--paper);
    border: var(--hairline);
    border-radius: var(--r-lg);
  }

  .diagrama__texto {
    display: grid;
    gap: var(--s-3);
  }

  .casos {
    display: grid;
    gap: var(--s-4);
  }

  @media (min-width: 48rem) {
    .casos {
      grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    }
  }

  .caso {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    padding: var(--s-5);
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--r-md);
  }

  .caso p {
    font-size: var(--fs-small);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.76);
  }

  .marcas-linea {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem var(--s-3);
    margin-top: var(--s-5);
    padding-top: var(--s-5);
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    font-size: var(--fs-small);
    color: rgba(255, 255, 255, 0.76);
  }

  .marcas-linea :global(svg) {
    color: var(--amarillo);
  }

  .faq-lista {
    max-width: 52rem;
    margin-inline: auto;
  }

  .otros__titulo {
    font-family: var(--font-base);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .otros__lista {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-4);
  }

  .otros__lista a {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.6875rem 1rem;
    background: var(--paper);
    border: var(--hairline);
    border-radius: var(--r-sm);
    font-size: var(--fs-small);
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
    transition: border-color var(--t-rapido), box-shadow var(--t-rapido);
  }

  .otros__lista a:hover {
    border-color: var(--azul);
    box-shadow: var(--sombra-sm);
  }
</style>
