---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import Faq from '../components/Faq.astro';
import PortadaPagina from '../components/PortadaPagina.astro';
import BloqueContacto from '../components/BloqueContacto.astro';
import DiagramaPortal from '../components/DiagramaPortal.astro';
import { fotoDeServicio } from '../data/imagenes';
import { empresa, telHref, waHref } from '../data/empresa';
import { ruta, type Idioma } from '../i18n/config';
import { t } from '../i18n/textos';

interface Props {
  lang: Idioma;
  servicio: CollectionEntry<'servicios'>;
}
const { lang, servicio } = Astro.props;
const { data } = servicio;
const { Content } = await render(servicio);
const slug = servicio.id.split('/')[1];
const txt = t(lang);

const otros = (await getCollection('servicios'))
  .filter((s) => s.id.startsWith(`${lang}/`) && s.id !== servicio.id)
  .sort((a, b) => a.data.orden - b.data.orden);

const sitio = Astro.site!;
const url = new URL(Astro.url.pathname, sitio).href;

const jsonLd = [
  {
    '@type': 'Service',
    name: data.titulo,
    description: data.descripcion,
    url,
    provider: { '@id': new URL('/#negocio', sitio).href },
    areaServed: { '@type': 'AdministrativeArea', name: 'Tenerife Sur' },
  },
  {
    '@type': 'FAQPage',
    mainEntity: data.faq.map((f) => ({
      '@type': 'Question',
      name: f.p,
      acceptedAnswer: { '@type': 'Answer', text: f.r },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: txt.nav.inicio, item: new URL(ruta(lang, '/'), sitio).href },
      {
        '@type': 'ListItem',
        position: 2,
        name: txt.nav.servicios,
        item: new URL(ruta(lang, '/servicios/'), sitio).href,
      },
      { '@type': 'ListItem', position: 3, name: data.corto, item: url },
    ],
  },
];
---

<Base lang={lang} titulo={data.tituloSeo} descripcion={data.descripcion} jsonLd={jsonLd}>
  <PortadaPagina
    lang={lang}
    titulo={data.titulo}
    texto={data.entradilla}
    foto={fotoDeServicio(servicio.id)}
    encuadre="centro"
    migas={[
      { texto: txt.nav.servicios, href: ruta(lang, '/servicios/') },
      { texto: data.corto },
    ]}
  />

  <div class="section detalle">
    <div class="container detalle__rejilla">
      <article class="detalle__cuerpo">
        <div class="prosa detalle__texto">
          <Content />
        </div>

        <section class="incluye" aria-labelledby="incluye-titulo">
          <h2 class="h3 incluye__titulo" id="incluye-titulo">{txt.servicio.incluye}</h2>
          <ul class="incluye__lista">
            {
              data.incluye.map((linea) => (
                <li>
                  <span class="incluye__marca">
                    <Icono nombre="check" tamano={14} />
                  </span>
                  {linea}
                </li>
              ))
            }
          </ul>
        </section>

        {
          slug === 'internet-comunitario' && (
            <section class="diagrama" aria-labelledby="diagrama-titulo">
              <div class="diagrama__caja">
                <DiagramaPortal lang={lang} />
              </div>
              <div class="diagrama__texto">
                <h2 class="h3" id="diagrama-titulo">{txt.servicio.diagramaTitulo}</h2>
                <p class="prosa">{txt.servicio.diagramaTexto}</p>
              </div>
            </section>
          )
        }

        <section class="casos" aria-labelledby="publico-titulo">
          <h2 class="h3 casos__titulo" id="publico-titulo">{txt.servicio.publico}</h2>
          <ul class="casos__lista" data-anima="hijos">
            {
              data.publico.map((p) => (
                <li class="tarjeta caso">
                  <h3 class="caso__tipo">{p.tipo}</h3>
                  <p class="caso__texto">{p.texto}</p>
                </li>
              ))
            }
          </ul>
        </section>
      </article>

      <aside class="lateral" aria-label={txt.servicio.otros}>
        <nav class="tarjeta lateral__caja">
          <h2 class="lateral__titulo">{txt.servicio.otros}</h2>
          <ul class="otros">
            {
              otros.map((o) => (
                <li>
                  <a href={ruta(lang, `/servicios/${o.id.split('/')[1]}/`)}>
                    <Icono nombre={o.data.icono} tamano={19} />
                    <span>{o.data.corto}</span>
                    <Icono nombre="flecha" tamano={15} class="otros__flecha" />
                  </a>
                </li>
              ))
            }
          </ul>
          <a class="btn btn--linea btn--bloque lateral__todos" href={ruta(lang, '/servicios/')}>
            {txt.acciones.verTodos}
          </a>
        </nav>

        {
          data.marcas.length > 0 && (
            <div class="tarjeta lateral__caja">
              <h2 class="lateral__titulo">{txt.servicio.material}</h2>
              <ul class="marcas-lista">
                {data.marcas.map((m) => (
                  <li>{m}</li>
                ))}
              </ul>
            </div>
          )
        }

        <div class="lateral__ayuda" data-brillo>
          <span class="pastilla pastilla--oro">
            <Icono nombre="telefono" tamano={22} />
          </span>
          <p class="h3 lateral__ayuda-titulo">{txt.servicio.ayudaTitulo}</p>
          <p class="lateral__ayuda-texto">{txt.servicio.ayudaTexto}</p>
          <a class="btn btn--azul btn--bloque" href={telHref()}>
            <Icono nombre="telefono" tamano={17} />
            <span class="tel-num">{empresa.telefono.display}</span>
          </a>
          <a class="btn btn--principal btn--bloque" href={waHref(lang)} rel="noopener noreferrer">
            <Icono nombre="whatsapp" tamano={17} />
            {txt.acciones.whatsapp}
          </a>
        </div>
      </aside>
    </div>
  </div>

  <section class="section section--surface" aria-labelledby="faq-servicio">
    <div class="container container--estrecho">
      <div class="cabecera" data-anima>
        <h2 class="h2" id="faq-servicio">{data.corto}</h2>
      </div>
      <div data-anima>
        <Faq items={data.faq} />
      </div>
    </div>
  </section>

  <BloqueContacto lang={lang} />
</Base>

<style>
  .detalle__rejilla {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  .detalle__cuerpo {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 5vw, 3.5rem);
    min-width: 0;
  }

  .detalle__texto {
    font-size: 1.0625rem;
  }

  /* ---------- Qué incluye ---------- */

  /* Panel tintado sin filete lateral: la marca de color ya la ponen las
     pastillas azules de cada línea, y una barra gruesa a un lado es el remate
     más manido que existe en este tipo de bloque. */
  .incluye {
    padding: var(--s-6) var(--s-5);
    background: var(--oro-tinte);
    border-radius: var(--r-card);
  }

  .incluye__titulo {
    margin-bottom: var(--s-4);
  }

  .incluye__lista {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.6875rem;
  }

  .incluye__lista li {
    display: flex;
    align-items: start;
    gap: 0.6875rem;
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .incluye__marca {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.375rem;
    height: 1.375rem;
    margin-top: 0.0625rem;
    border-radius: var(--r-pill);
    background: var(--oro-oscuro);
    color: var(--on-oscuro);
  }

  @media (min-width: 40rem) {
    .incluye__lista {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.6875rem var(--s-5);
    }
  }

  /* ---------- Diagrama ---------- */

  .diagrama {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-5);
    align-items: center;
  }

  .diagrama__caja {
    padding: var(--s-5);
    background: var(--surface);
    border-radius: var(--r-card);
  }

  .diagrama__texto {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-3);
  }

  @media (min-width: 48rem) {
    .diagrama {
      grid-template-columns: 1fr 1fr;
      gap: var(--s-6);
    }
  }

  /* ---------- Según tu caso ---------- */

  .casos__titulo {
    margin-bottom: var(--s-4);
  }

  .casos__lista {
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
  }

  .caso {
    gap: var(--s-2);
    padding: var(--s-5);
  }

  .caso__tipo {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .caso__texto {
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--ink-3);
  }

  /* ---------- Columna lateral ---------- */

  .lateral {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-4);
    align-content: start;
  }

  .lateral__caja {
    padding: var(--s-5);
    gap: var(--s-4);
  }

  .lateral__titulo {
    font-family: var(--font-base);
    font-size: var(--fs-eyebrow);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .otros {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .otros a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.75rem;
    border-bottom: var(--hairline);
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    transition: color var(--t-rapido);
  }

  .otros li:last-child a {
    border-bottom: 0;
  }

  .otros a svg {
    color: var(--oro-oscuro);
  }

  .otros__flecha {
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--t-rapido), transform var(--t-rapido);
  }

  .otros a:hover {
    color: var(--oro-oscuro);
  }

  .otros a:hover .otros__flecha {
    opacity: 1;
    transform: none;
  }

  .marcas-lista {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .marcas-lista li {
    padding: 0.375rem 0.75rem;
    background: var(--surface);
    border: var(--hairline);
    border-radius: var(--r-pill);
    font-size: var(--fs-mini);
    font-weight: 600;
    color: var(--ink-2);
  }

  /* ---------- Tarjeta de ayuda ---------- */

  .lateral__ayuda {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-3);
    padding: var(--s-6) var(--s-5);
    background: var(--noche);
    border-radius: var(--r-card);
    color: var(--sobre-noche);
    text-align: center;
    justify-items: center;
  }

  .lateral__ayuda .pastilla {
    width: 3rem;
    height: 3rem;
    border-radius: var(--r-pill);
  }

  .pastilla--oro {
    background: var(--oro);
    color: var(--noche);
  }

  .lateral__ayuda-titulo {
    color: var(--on-oscuro);
  }

  .lateral__ayuda-texto {
    font-size: var(--fs-small);
    line-height: 1.55;
  }

  .lateral__ayuda .btn {
    margin-top: var(--s-1);
  }

  @media (min-width: 62rem) {
    .detalle__rejilla {
      grid-template-columns: minmax(0, 1fr) 20rem;
    }

    /* La columna se queda a la vista mientras se lee el texto: el teléfono
       nunca se pierde por arriba, que es el motivo de que exista. */
    .lateral {
      position: sticky;
      top: calc(var(--header-h) + var(--s-5));
    }
  }
</style>
