---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import BloqueContacto from '../components/BloqueContacto.astro';
import { empresa, aniosActividad } from '../data/empresa';
import { ruta, type Idioma } from '../i18n/config';
import { t } from '../i18n/textos';
import { seo } from '../i18n/seo';
import { nosotros } from '../i18n/nosotros';
import fotoEquipo from '../assets/equipo.jpg';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const txt = t(lang);
const n = nosotros(lang);
const meta = seo(lang).nosotros;

const iconos = ['euro', 'documento', 'herramienta', 'telefono'] as const;

const sitio = Astro.site!;
const jsonLd = [
  {
    '@type': 'AboutPage',
    name: meta.titulo,
    url: new URL(ruta(lang, '/nosotros/'), sitio).href,
    about: { '@id': new URL('/#negocio', sitio).href },
  },
];
---

<Base lang={lang} titulo={meta.titulo} descripcion={meta.descripcion} jsonLd={jsonLd}>
  <section class="portada">
    <div class="container">
      <p class="eyebrow">{n.eyebrow}</p>
      <h1 class="display-l">{n.titulo}</h1>
      <p class="lede">{n.lede}</p>
    </div>
  </section>

  <section class="tira" aria-label={txt.contacto.datosEmpresa}>
    <ul class="container tira__lista">
      <li>
        <strong class="tira__dato">{aniosActividad}</strong>
        <span class="tira__texto">{txt.pie.empresa}</span>
      </li>
      <li>
        <strong class="tira__dato tel-num">{empresa.registroInstalador}</strong>
        <span class="tira__texto">{txt.pie.registro}</span>
      </li>
      <li>
        <strong class="tira__dato">5</strong>
        <span class="tira__texto">{txt.pie.servicios}</span>
      </li>
      <li>
        <strong class="tira__dato">{empresa.cobertura.length}</strong>
        <span class="tira__texto">{txt.pie.cobertura}</span>
      </li>
    </ul>
  </section>

  <section class="section section--tight">
    <div class="container historia">
      <figure class="historia__foto">
        <Image
          src={fotoEquipo}
          alt={empresa.razonSocial}
          widths={[380, 560, 760]}
          sizes="(min-width: 62rem) 22rem, 100vw"
          loading="lazy"
        />
      </figure>
      <div>
        <h2 class="h2 historia__titulo">{n.historiaTitulo}</h2>
        <div class="prosa">
          {n.historia.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="compromisos-titulo">
    <div class="container">
      <div class="cabecera">
        <p class="eyebrow">{txt.pasos.eyebrow}</p>
        <h2 class="h2" id="compromisos-titulo">{n.compromisosTitulo}</h2>
      </div>
      <ul class="compromisos">
        {
          n.compromisos.map((c, i) => (
            <li class="compromiso">
              <span class="pastilla">
                <Icono nombre={iconos[i]} tamano={20} />
              </span>
              <span>
                <strong class="compromiso__titulo">{c.titulo}</strong>
                <span class="compromiso__texto">{c.texto}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <BloqueContacto lang={lang} />
</Base>

<style>
  .portada {
    padding-block: clamp(2rem, 4vw, 3rem);
  }

  .portada .container {
    display: grid;
    gap: var(--s-3);
  }

  .tira {
    border-block: var(--hairline);
  }

  .tira__lista {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    padding-block: var(--s-4);
  }

  @media (min-width: 48rem) {
    .tira__lista {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .tira__lista li {
    display: grid;
    gap: 0.125rem;
    padding-right: var(--s-4);
  }

  .tira__lista li + li {
    padding-left: var(--s-4);
    border-left: var(--hairline);
  }

  .tira__dato {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    line-height: 1;
    color: var(--naranja);
  }

  .tira__texto {
    font-size: var(--fs-small);
    line-height: 1.35;
    color: var(--ink-3);
  }

  .historia {
    display: grid;
    gap: var(--s-5);
  }

  @media (min-width: 62rem) {
    .historia {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
      gap: var(--s-7);
      align-items: start;
    }
  }

  .historia__foto {
    margin: 0;
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--sombra);
  }

  .historia__foto :global(img) {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .historia__titulo {
    margin-bottom: var(--s-4);
  }

  .compromisos {
    display: grid;
    gap: var(--s-4) var(--s-6);
  }

  @media (min-width: 55rem) {
    .compromisos {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .compromiso {
    display: flex;
    align-items: flex-start;
    gap: var(--s-3);
  }

  .compromiso .pastilla {
    width: 2.5rem;
    height: 2.5rem;
  }

  .compromiso__titulo {
    display: block;
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink);
  }

  .compromiso__texto {
    display: block;
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--ink-3);
    max-width: 46ch;
  }
</style>
