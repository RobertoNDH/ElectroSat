---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import BloqueContacto from '../components/BloqueContacto.astro';
import Portada from '../components/Portada.astro';
import { empresa, aniosActividad } from '../data/empresa';
import { ruta, type Idioma } from '../i18n/config';
import { t } from '../i18n/textos';
import { seo } from '../i18n/seo';
import { nosotros } from '../i18n/nosotros';
import fotoPortada from '../assets/portada-nosotros.jpg';
import fotoTecnico from '../assets/equipo.jpg';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const txt = t(lang);
const n = nosotros(lang);
const meta = seo(lang).nosotros;

const iconos = ['euro', 'documento', 'herramienta', 'telefono'] as const;

const sitio = Astro.site!;
const jsonLd = [
  {
    '@type': 'AboutPage',
    name: meta.titulo,
    url: new URL(ruta(lang, '/nosotros/'), sitio).href,
    about: { '@id': new URL('/#negocio', sitio).href },
  },
];
---

<Base lang={lang} titulo={meta.titulo} descripcion={meta.descripcion} jsonLd={jsonLd}>
  <Portada
    titulo={n.titulo}
    texto={n.lede}
    foto={fotoPortada}
    alt="Antenas de televisión sobre los tejados de un pueblo del sur de Tenerife"
    encuadre="centro"
  />

  <section class="tira" aria-label={txt.contacto.datosEmpresa}>
    <ul class="container tira__lista">
      <li>
        <strong class="tira__dato">{aniosActividad}</strong>
        <span class="tira__texto">{n.cifras.anios}</span>
      </li>
      <li>
        <strong class="tira__dato">5</strong>
        <span class="tira__texto">{n.cifras.areas}</span>
      </li>
      <li>
        <strong class="tira__dato">{empresa.cobertura.length}</strong>
        <span class="tira__texto">{n.cifras.municipios}</span>
      </li>
    </ul>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="cabecera">
        <h2 class="h2">{n.historiaTitulo}</h2>
      </div>

      <div class="historia">
        {n.historia.map((p) => <p>{p}</p>)}
      </div>

      <figure class="historia__foto">
        <Image
          src={fotoTecnico}
          alt="Técnico de ElectroSat TV trabajando en una instalación"
          widths={[800, 1200, 1800, 2400]}
          sizes="(min-width: 62rem) 60rem, 100vw"
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="compromisos-titulo">
    <div class="container">
      <div class="cabecera">
        <h2 class="h2" id="compromisos-titulo">{n.compromisosTitulo}</h2>
      </div>
      <ul class="compromisos">
        {
          n.compromisos.map((c, i) => (
            <li class="compromiso">
              <span class="pastilla">
                <Icono nombre={iconos[i]} tamano={20} />
              </span>
              <span>
                <strong class="compromiso__titulo">{c.titulo}</strong>
                <span class="compromiso__texto">{c.texto}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <BloqueContacto lang={lang} />
</Base>

<style>
  .tira {
    border-block: var(--hairline);
  }

  .tira__lista {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding-block: var(--s-4);
  }

  .tira__lista li {
    display: grid;
    gap: 0.125rem;
    justify-items: center;
    text-align: center;
    padding-inline: var(--s-3);
  }

  .tira__lista li + li {
    border-left: var(--hairline);
  }

  .tira__dato {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    line-height: 1;
    color: var(--azul);
  }

  .tira__texto {
    font-size: var(--fs-small);
    line-height: 1.35;
    color: var(--ink-3);
  }

  /* Texto a una columna centrada y la foto ancha debajo: antes iba a un lado
     y la foto al otro, que es justo lo que no queremos. */
  .historia {
    display: grid;
    gap: var(--s-4);
    max-width: 62ch;
    margin-inline: auto;
    text-align: center;
    text-wrap: pretty;
  }

  .historia__foto {
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--sombra);
  }

  .historia__foto :global(img) {
    width: 100%;
    aspect-ratio: 21 / 9;
    object-fit: cover;
  }

  @media (max-width: 43.99rem) {
    .historia__foto :global(img) {
      aspect-ratio: 3 / 2;
    }
  }

  .compromisos {
    display: grid;
    gap: var(--s-4) var(--s-6);
  }

  @media (min-width: 55rem) {
    .compromisos {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .compromiso {
    display: flex;
    align-items: flex-start;
    gap: var(--s-3);
  }

  .compromiso .pastilla {
    width: 2.5rem;
    height: 2.5rem;
  }

  .compromiso__titulo {
    display: block;
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink);
  }

  .compromiso__texto {
    display: block;
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--ink-3);
    max-width: 46ch;
  }
</style>
