---
import Base from '../layouts/Base.astro';
import PortadaPagina from '../components/PortadaPagina.astro';
import Icono from '../components/Icono.astro';
import EstadoHorario from '../components/EstadoHorario.astro';
import Mapa from '../components/Mapa.astro';
import fotoPortada from '../assets/portada-contacto.jpg';
import {
  empresa,
  telHref,
  waHref,
  correoHref,
  direccionUnaLinea,
} from '../data/empresa';
import { ruta, type Idioma } from '../i18n/config';
import { t } from '../i18n/textos';
import { seo } from '../i18n/seo';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const txt = t(lang);
const meta = seo(lang).contacto;

// Si más adelante se añade formulario hará falta: endpoint de envío, casilla
// de consentimiento, honeypot antispam y declarar el tratamiento en la política
// de privacidad.

const sitio = Astro.site!;
const jsonLd = [
  {
    '@type': 'ContactPage',
    name: meta.titulo,
    url: new URL(ruta(lang, '/contacto/'), sitio).href,
    about: { '@id': new URL('/#negocio', sitio).href },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: txt.nav.inicio, item: new URL(ruta(lang, '/'), sitio).href },
      { '@type': 'ListItem', position: 2, name: txt.nav.contacto, item: new URL(ruta(lang, '/contacto/'), sitio).href },
    ],
  },
];
---

<Base lang={lang} titulo={meta.titulo} descripcion={meta.descripcion} jsonLd={jsonLd}>
  <PortadaPagina
    lang={lang}
    titulo={txt.contacto.titulo}
    texto={txt.contacto.texto}
    foto={fotoPortada}
    encuadre="centro"
    migas={[{ texto: txt.nav.contacto }]}
    compacta
  />

  <section class="section section--tight" aria-label={txt.nav.contacto}>
    <div class="container canales" data-anima="hijos">
      <div class="tarjeta canal">
        <span class="pastilla pastilla--amarilla">
          <Icono nombre="telefono" tamano={22} />
        </span>
        <p class="canal__etiqueta">{txt.acciones.llamanos}</p>
        <a class="canal__numero tel-num" href={telHref()}>{empresa.telefono.display}</a>
        <a class="btn btn--principal btn--lg btn--bloque" href={telHref()}>
          <Icono nombre="telefono" tamano={18} />
          {txt.acciones.llamarAhora}
        </a>
      </div>

      <div class="tarjeta canal">
        <span class="pastilla pastilla--marca">
          <Icono nombre="whatsapp" tamano={22} />
        </span>
        <p class="canal__etiqueta">{txt.contacto.movil}</p>
        <a class="canal__numero canal__numero--sec tel-num" href={telHref(empresa.movil)}>
          {empresa.movil.display}
        </a>
        <a class="btn btn--azul btn--lg btn--bloque" href={waHref(lang)} rel="noopener noreferrer">
          <Icono nombre="whatsapp" tamano={18} />
          {txt.acciones.escribirWhatsapp}
        </a>
      </div>

      <div class="tarjeta canal">
        <span class="pastilla pastilla--marca">
          <Icono nombre="email" tamano={22} />
        </span>
        <p class="canal__etiqueta">{txt.contacto.correo}</p>
        <a class="canal__email" href={correoHref(lang)}>{empresa.email}</a>
        <a class="btn btn--linea btn--lg btn--bloque" href={correoHref(lang)}>
          <Icono nombre="email" tamano={18} />
          {txt.acciones.escribirCorreo}
        </a>
      </div>
    </div>
  </section>

  <section class="section datos-banda sobre-noche" aria-label={txt.contacto.datosEmpresa}>
    <div class="container">
      <ul class="datos" data-anima="hijos">
        <li class="dato">
          <span class="pastilla dato__icono"><Icono nombre="reloj" tamano={20} /></span>
          <h2 class="dato__titulo">{txt.contacto.horario}</h2>
          <p class="dato__fuerte">{txt.datos.horario}</p>
          <EstadoHorario lang={lang} />
        </li>

        <li class="dato">
          <span class="pastilla dato__icono"><Icono nombre="mapa" tamano={20} /></span>
          <h2 class="dato__titulo">{txt.contacto.donde}</h2>
          <p class="dato__fuerte">{empresa.razonSocial}</p>
          <p class="dato__texto">{direccionUnaLinea}</p>
          <a class="enlace-flecha" href={empresa.mapsUrl} rel="noopener noreferrer">
            {txt.acciones.abrirMapa}
            <Icono nombre="flecha" tamano={16} />
          </a>
        </li>

        <li class="dato">
          <span class="pastilla dato__icono"><Icono nombre="check" tamano={20} /></span>
          <h2 class="dato__titulo">{txt.contacto.zona}</h2>
          <p class="dato__fuerte">{txt.datos.zona}</p>
          <p class="dato__texto">{empresa.cobertura.join(' · ')}</p>
        </li>
      </ul>
    </div>
  </section>

  <section slot="tras-pie" class="section section--surface">
    <div class="container">
      <Mapa lang={lang} />
    </div>
  </section>
</Base>

<style>
  /* ---------- Canales ---------- */

  .canales {
    display: grid;
    gap: var(--s-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }

  .canal {
    align-content: start;
    gap: var(--s-3);
    padding: var(--s-5);
    text-align: center;
    justify-items: center;
  }

  .canal .pastilla {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--r-pill);
  }

  .canal__etiqueta {
    font-size: var(--fs-eyebrow);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .canal__numero {
    font-family: var(--font-display);
    font-stretch: var(--wdth-display);
    font-size: clamp(1.5rem, 3.4vw, 2rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-decoration: none;
  }

  .canal__numero:hover {
    color: var(--azul);
  }

  .canal__numero--sec {
    color: var(--azul);
  }

  .canal__email {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--azul);
    overflow-wrap: anywhere;
  }

  .canal .btn {
    margin-top: auto;
  }

  /* ---------- Datos ---------- */

  /* Un tono de noche distinto al del pie, que va justo debajo: si las dos
     bandas comparten el mismo azul casi negro, se funden en una sola mancha
     y no se nota dónde acaba una y empieza la otra. */
  .datos-banda {
    background: var(--noche-2);
  }

  .datos {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-6);
  }

  .dato {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    gap: var(--s-2);
  }

  .dato__icono {
    margin-bottom: var(--s-2);
  }

  .dato__titulo {
    font-family: var(--font-display);
    font-stretch: var(--wdth-display);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--on-oscuro);
  }

  .dato__fuerte {
    font-weight: 600;
    color: var(--on-oscuro);
  }

  .dato__texto {
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--sobre-noche);
    max-width: 40ch;
  }

  @media (min-width: 55rem) {
    .datos {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--s-7);
    }
  }
</style>
