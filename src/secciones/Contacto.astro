---
import Base from '../layouts/Base.astro';
import Portada from '../components/Portada.astro';
import fotoPortada from '../assets/portada-contacto.jpg';
import Icono from '../components/Icono.astro';
import EstadoHorario from '../components/EstadoHorario.astro';
import {
  empresa,
  telHref,
  waHref,
  correoHref,
  direccionUnaLinea,
} from '../data/empresa';
import { ruta, type Idioma } from '../i18n/config';
import { t } from '../i18n/textos';
import { seo } from '../i18n/seo';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const txt = t(lang);
const meta = seo(lang).contacto;

// Si más adelante se añade formulario hará falta: endpoint de envío, casilla
// de consentimiento, honeypot antispam y declarar el tratamiento en la política
// de privacidad.

const sitio = Astro.site!;
const jsonLd = [
  {
    '@type': 'ContactPage',
    name: meta.titulo,
    url: new URL(ruta(lang, '/contacto/'), sitio).href,
    about: { '@id': new URL('/#negocio', sitio).href },
  },
];
---

<Base lang={lang} titulo={meta.titulo} descripcion={meta.descripcion} jsonLd={jsonLd}>
  <Portada
    titulo={txt.contacto.titulo}
    texto={txt.contacto.texto}
    foto={fotoPortada}
    alt="Tejados con antenas de televisión bajo el cielo del sur de Tenerife"
    encuadre="centro"
  />

  <section class="section section--tight">
    <div class="container canales">
      <div class="canal canal--principal">
        <p class="canal__etiqueta"><Icono nombre="telefono" tamano={15} />{txt.acciones.llamanos}</p>
        <a class="canal__numero tel-num" href={telHref()}>{empresa.telefono.display}</a>
        <a class="btn btn--principal btn--lg" href={telHref()}>
          <Icono nombre="telefono" tamano={18} />
          {txt.acciones.llamarAhora}
        </a>
      </div>

      <div class="canal">
        <p class="canal__etiqueta"><Icono nombre="whatsapp" tamano={15} />{txt.contacto.movil}</p>
        <a class="canal__numero canal__numero--sec tel-num" href={telHref(empresa.movil)}>
          {empresa.movil.display}
        </a>
        <a class="btn btn--azul btn--lg" href={waHref(lang)} rel="noopener noreferrer">
          <Icono nombre="whatsapp" tamano={18} />
          {txt.acciones.escribirWhatsapp}
        </a>
      </div>

      <div class="canal">
        <p class="canal__etiqueta"><Icono nombre="email" tamano={15} />{txt.contacto.correo}</p>
        <a class="canal__email" href={correoHref(lang)}>{empresa.email}</a>
        <a class="btn btn--linea btn--lg" href={correoHref(lang)}>
          <Icono nombre="email" tamano={18} />
          {txt.acciones.escribirCorreo}
        </a>
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container datos">
      <div class="dato">
        <h2 class="dato__titulo"><Icono nombre="reloj" tamano={16} />{txt.contacto.horario}</h2>
        <EstadoHorario lang={lang} />
        <p>{txt.datos.horario}</p>
      </div>

      <div class="dato">
        <h2 class="dato__titulo"><Icono nombre="mapa" tamano={16} />{txt.contacto.donde}</h2>
        <p>{empresa.razonSocial}</p>
        <p class="small">{direccionUnaLinea}</p>
        <a class="enlace-flecha" href={empresa.mapsUrl} rel="noopener noreferrer">
          {txt.acciones.abrirMapa}
          <Icono nombre="flecha" tamano={16} />
        </a>
      </div>

      <div class="dato">
        <h2 class="dato__titulo"><Icono nombre="documento" tamano={16} />{txt.contacto.datosEmpresa}</h2>
        <p>{empresa.razonSocial}</p>
      </div>

      <div class="dato">
        <h2 class="dato__titulo"><Icono nombre="check" tamano={16} />{txt.contacto.zona}</h2>
        <p>{txt.datos.zona}</p>
        <p class="small">{empresa.cobertura.slice(0, 8).join(' · ')}…</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .canales {
    display: grid;
    gap: var(--s-4);
  }

  @media (min-width: 55rem) {
    .canales {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .canal {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    justify-items: start;
    padding: var(--s-5);
    background: var(--paper);
    border: var(--hairline);
    border-radius: var(--r-lg);
  }

  /* El canal preferente se distingue por su botón, no por un adorno. */
  .canal--principal {
    background: var(--azul-tinte);
    border-color: #c9dcf6;
  }

  .canal__etiqueta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .canal__etiqueta :global(svg) {
    color: var(--azul);
  }

  .canal__numero {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 3.6vw, 2.5rem);
    font-weight: 700;
    line-height: 1;
    color: var(--ink);
    text-decoration: none;
  }

  .canal__numero:hover {
    color: var(--azul);
  }

  .canal__numero--sec {
    font-size: clamp(1.625rem, 3vw, 2rem);
  }

  .canal__email {
    font-size: 1.0625rem;
    font-weight: 600;
    word-break: break-word;
  }

  .datos {
    display: grid;
    gap: var(--s-4);
  }

  @media (min-width: 44rem) {
    .datos {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 66rem) {
    .datos {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .dato {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    justify-items: start;
    padding: var(--s-5);
    background: var(--paper);
    border: var(--hairline);
    border-radius: var(--r-lg);
  }

  .dato__titulo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-base);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .dato__titulo :global(svg) {
    color: var(--azul);
  }

  .dato p {
    font-size: var(--fs-body);
    color: var(--ink-2);
  }
</style>
