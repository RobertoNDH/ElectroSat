---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import { empresa, telHref } from '../data/empresa';
import { ruta, type Idioma } from '../i18n/config';
import { t } from '../i18n/textos';
import { seo } from '../i18n/seo';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const txt = t(lang);
const meta = seo(lang).error404;

const servicios = (await getCollection('servicios'))
  .filter((s) => s.id.startsWith(`${lang}/`))
  .sort((a, b) => a.data.orden - b.data.orden);
---

<Base lang={lang} titulo={meta.titulo} descripcion={meta.descripcion} noindex>
  <section class="section perdido">
    <div class="container perdido__caja">
      <p class="eyebrow">{txt.error404.eyebrow}</p>
      <h1 class="display-l">{txt.error404.titulo}</h1>
      <p class="lede">{txt.error404.texto}</p>

      <div class="perdido__acciones">
        <a class="btn btn--principal btn--lg" href={telHref()}>
          <Icono nombre="telefono" tamano={18} />
          {txt.acciones.llamarA(empresa.telefono.display)}
        </a>
        <a class="btn btn--linea btn--lg" href={ruta(lang, '/')}>{txt.error404.volver}</a>
      </div>

      <nav class="perdido__enlaces" aria-label={txt.nav.servicios}>
        <p class="eyebrow">{txt.error404.oVeA}</p>
        <ul>
          {
            servicios.map((s) => (
              <li>
                <a href={ruta(lang, `/servicios/${s.id.split('/')[1]}/`)}>
                  <Icono nombre={s.data.icono} tamano={20} />
                  {s.data.corto}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>
</Base>

<style>
  .perdido {
    display: grid;
    place-items: center;
    min-height: 58svh;
  }

  .perdido__caja {
    display: grid;
    gap: var(--s-3);
    max-width: 46rem;
  }

  .perdido__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }

  .perdido__enlaces {
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-5);
    padding-top: var(--s-5);
    border-top: var(--hairline);
  }

  .perdido__enlaces ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .perdido__enlaces a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    border: 1px solid var(--control);
    border-radius: var(--r-sm);
    font-size: var(--fs-small);
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
  }

  .perdido__enlaces a:hover {
    border-color: var(--azul);
    color: var(--azul);
  }
</style>
