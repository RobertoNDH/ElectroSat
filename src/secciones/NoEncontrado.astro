---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PortadaPagina from '../components/PortadaPagina.astro';
import Icono from '../components/Icono.astro';
import fotoPortada from '../assets/portada-404.jpg';
import { empresa, telHref } from '../data/empresa';
import { ruta, type Idioma } from '../i18n/config';
import { t } from '../i18n/textos';
import { seo } from '../i18n/seo';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const txt = t(lang);
const meta = seo(lang).error404;

const servicios = (await getCollection('servicios'))
  .filter((s) => s.id.startsWith(`${lang}/`))
  .sort((a, b) => a.data.orden - b.data.orden);
---

<Base lang={lang} titulo={meta.titulo} descripcion={meta.descripcion} noindex>
  <PortadaPagina
    lang={lang}
    titulo={txt.error404.titulo}
    texto={txt.error404.texto}
    foto={fotoPortada}
    encuadre="centro"
    migas={[{ texto: txt.error404.eyebrow }]}
  />

  <section class="section perdido">
    <div class="container perdido__caja">
      <div class="perdido__acciones">
        <a class="btn btn--principal btn--lg" href={telHref()}>
          <Icono nombre="telefono" tamano={18} />
          {txt.acciones.llamarA(empresa.telefono.display)}
        </a>
        <a class="btn btn--linea btn--lg" href={ruta(lang, '/')}>{txt.error404.volver}</a>
      </div>

      <nav class="perdido__enlaces" aria-label={txt.nav.servicios}>
        <p class="etiqueta">{txt.error404.oVeA}</p>
        <ul>
          {
            servicios.map((s) => (
              <li>
                <a href={ruta(lang, `/servicios/${s.id.split('/')[1]}/`)}>
                  <Icono nombre={s.data.icono} tamano={20} />
                  {s.data.corto}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>
</Base>

<style>
  .perdido__caja {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    gap: var(--s-7);
    text-align: center;
  }

  .perdido__acciones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-3);
  }

  .perdido__enlaces {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    gap: var(--s-4);
  }

  .perdido__enlaces ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-3);
  }

  .perdido__enlaces a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6875rem 1.125rem;
    background: var(--paper);
    border: var(--hairline);
    border-radius: var(--r-pill);
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--t-rapido), background var(--t-rapido);
  }

  .perdido__enlaces a svg {
    color: var(--azul);
  }

  .perdido__enlaces a:hover {
    border-color: var(--azul);
    background: var(--azul-tinte);
  }
</style>
